Package: qore-v8-module
Architecture: any
Depends: qore-v8-module-common (= ${source:Version}),
         ${qore:Depends},
         ${shlibs:Depends},
         ${misc:Depends},
         node-typescript (>= 5.2),
         qore-process-module,
         qore-uuid-module
Suggests: qore-v8-module-doc
Description: JavaScript and TypeScript integration for Qore
 This package provides native Node.js/V8 bindings, compiled and source
 TypeScriptProxy and TypeScriptActionInterface modules, two command-line
 tools, compiler metadata, provider resources and translations.
 The separately built TypeScript app catalogue is not included.

Package: qore-v8-module-common
Architecture: all
Multi-Arch: foreign
Depends: ${misc:Depends}
Description: shared sources and translations for Qore's JavaScript modules
 This package contains the architecture-independent source modules, resources
 and translation catalogs for TypeScriptProxy and TypeScriptActionInterface.
 The TypeScript app catalogue and its npm dependencies are separate.

Package: qore-v8-module-doc
Section: doc
Architecture: all
Multi-Arch: foreign
Build-Profiles: <!nodoc>
Depends: ${misc:Depends}
Suggests: qore-v8-module
Description: documentation and examples for Qore's JavaScript modules
 This package contains three HTML API references and test examples for the
 JavaScript/TypeScript bindings, process pools and action integration.
