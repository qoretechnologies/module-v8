            "download_url_expires_at": {
              "description": "Download URL expiration time.",
              "example": "2020-08-21T13:26:59.999Z",
              "format": "date-time",
              "readOnly": true
            },
            "uploaded_at": {
              "description": "Time of upload.",
              "example": "2020-08-18T12:48:42.978Z",
              "format": "date-time",
              "readOnly": true
            },
            "uploaded_by": {
