{
  "name": "qore-typescript-api",
  "version": "0.1.0",
  "description": "Qore Typescript API & Apps Catalogue",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "build": "rimraf dist/ && cross-env NODE_OPTIONS=--max-old-space-size=8192 npx tsc --p tsconfig.build.json && tsc-alias && yarn copy-schemas && yarn copy-custom-apps && yarn prune-schemas",
    "build:debug": "rimraf dist/ && cross-env TS_DEBUG=true NODE_OPTIONS=--max-old-space-size=8192 npx tsc --p tsconfig.build.json && tsc-alias && yarn copy-schemas && yarn copy-custom-apps && yarn prune-schemas",
    "test-build": "rimraf dist/ && cross-env TS_DEBUG=true NODE_OPTIONS=--max-old-space-size=8192 npx tsc --p tsconfig.tests.json && tsc-alias && yarn copy-schemas && yarn copy-custom-apps && yarn prune-schemas",
    "copy-schemas": "copyfiles -u 2 src/schemas/* dist/schemas",
    "copy-custom-apps": "copyfiles -u 2 src/customApps/**/* dist/customApps",
    "prune-schemas": "node --max-old-space-size=8192 scripts/prune-schemas.js",
    "build:test": "cross-env NODE_OPTIONS=--max-old-space-size=8192 npx tsc --noEmit --p tsconfig.build.json && tsc-alias",
    "lint": "eslint \"{src,apps,libs}/**/*.ts\" --fix",
    "typesafe-i18n": "typesafe-i18n",
    "test:ci": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --ci --maxWorkers=50% --config src/jest.config.ts",
    "test": "clear && yarn test:ci",
    "qtest": "clear && jest --config src/jest.config.ts --testMatch '**/?(*.)+(qtest).[tj]s?(x)' --detectOpenHandles --forceExit",
    "precheck": "yarn build:test && yarn test",
    "update-reqore": "yarn add -D @qoretechnologies/reqore@beta",
    "update-toolkit": "yarn add -D @qoretechnologies/ts-toolkit@beta",
    "qore:check-app": "cross-env QORE_TYPESCRIPT_ACTION_VERBOSE=1 QORE_TYPESCRIPT_ACTION_SCRIPTS=./dist/index.js qdp"
  },
  "author": "Qore Technologies s.r.o.",
  "license": "MIT",
