{
  "name": "qore-typescript-api",
  "version": "0.1.0",
  "description": "Qore Typescript API & Apps Catalogue",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "build": "rm -rf dist/ && npx tsc --p tsconfig.build.json && tsc-alias && yarn copy-schemas && yarn copy-custom-apps",
    "build:debug": "TS_DEBUG=true rm -rf dist/ && npx tsc --p tsconfig.build.json && tsc-alias && yarn copy-schemas && yarn copy-custom-apps",
    "test-build": "TS_DEBUG=true rm -rf dist/ && npx tsc --p tsconfig.tests.json && tsc-alias && yarn copy-schemas && yarn copy-custom-apps",
    "copy-schemas": "copyfiles -u 2 src/schemas/* dist/schemas",
    "copy-custom-apps": "copyfiles -u 2 src/customApps/**/* dist/customApps",
    "build:test": "npx tsc --noEmit --p tsconfig.build.json && tsc-alias",
    "lint": "eslint \"{src,apps,libs}/**/*.ts\" --fix",
    "typesafe-i18n": "typesafe-i18n",
    "test:ci": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config src/jest.config.ts",
    "test": "clear && yarn test:ci",
    "qtest": "clear && jest --config src/jest.config.ts --testMatch '**/?(*.)+(qtest).[tj]s?(x)' --detectOpenHandles --forceExit",
    "precheck": "yarn build:test && yarn test",
    "update-reqore": "yarn add -D @qoretechnologies/reqore@beta",
    "update-toolkit": "yarn add -D @qoretechnologies/ts-toolkit@beta"
  },
  "author": "Qore Technologies s.r.o.",
  "license": "MIT",
