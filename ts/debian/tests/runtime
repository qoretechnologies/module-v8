set -eu

source_debian=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
catalogue=/usr/share/qore-v8-app-catalogue
unset NODE_PATH NODE_OPTIONS LD_LIBRARY_PATH LD_PRELOAD QORE_MODULE_DIR QORE_MODULE_DIR_ONLY
unset QORE_INCLUDE_DIR QORE_TYPESCRIPT_ACTION_SCRIPTS QORE_TYPESCRIPT_ACTION_TEST_SCRIPTS
unset QORE_HUBSPOT_SCHEMA_SNAPSHOT
unset QORE_APP_SCHEMA_SNAPSHOTS
unset QORE_DATA_PROVIDERS QORE_CONNECTION_PROVIDERS QORE_DATASOURCE_PROVIDERS QORE_PROVIDER_INDEX_DIR
export QORE_MODULE_DIR="$(/usr/bin/qore --module-path)"
export QORE_MODULE_DIR_ONLY=1
export QORE_TYPESCRIPT_MASTER_ACTION_SCRIPT="$catalogue/dist/index.js"

/usr/bin/node "$source_debian/tests/production.js" "$catalogue"
/usr/bin/node "$source_debian/../scripts/verify-dependency-security.js" "$catalogue"
test ! -e "$catalogue/dist/schemas/hubspot"
qore-hubspot-schemas --help
qore-app-schemas --help
test "$(qore-app-schemas --cache-dir "$AUTOPKGTEST_TMP/empty-app-cache" status)" = '{}'
/usr/bin/node -e 'const fs=require("fs"),path=require("path"); const root=process.argv[1];
const {apps}=require(root+"/dist/schema-cache/app-contracts.json");
for(const app of Object.values(apps)) if(fs.existsSync(path.join(root,"dist/schemas",app.sourceFile)))
    throw new Error("External schema shipped: "+app.sourceFile);' "$catalogue"
if qore-hubspot-schemas --cache-dir "$AUTOPKGTEST_TMP/empty-cache" status; then
    echo 'An unconfigured cache unexpectedly succeeded' >&2
    exit 1
fi

for mode in tiered ast; do
    logfile="$AUTOPKGTEST_TMP/catalogue-$mode.log"
    if ! /usr/bin/qore -M --enable-debug --exec-mode="$mode" -l TypeScriptActionInterface -l json -e '
        DataProvider::checkStaticInit();
        auto inventory = TypeScriptActionInterface::getDiscoveryInventory();
        auto expected = parse_json(File::readTextFile(ARGV[0]));
        if (inventory != expected) {
            throw "CATALOGUE-INVENTORY-MISMATCH", "Installed app/action identities differ from the qualified snapshot";
        }
        printf("Verified %d installed catalogue identities\n", inventory.size());
    ' "$source_debian/expected-inventory.json" > "$logfile" 2>&1; then
        cat "$logfile"
        exit 1
    fi
    cat "$logfile"
    if grep -F '[ERROR]' "$logfile"; then
        exit 1
    fi
done

# The optional HubSpot setup must fail structurally, without hiding its identities.
/usr/bin/qore -M --enable-debug -l TypeScriptActionInterface -e '
    DataProvider::checkStaticInit();
    try { DataProviderActionCatalog::getAppEx("Hubspot"); } catch (auto ex) {}
    auto failures = DataProviderActionCatalog::getInitializationFailures(("Hubspot",));
    if (!(map $1, failures, $1.error == "HUBSPOT-SCHEMAS-UNAVAILABLE")) {
        throw "MISSING-STRUCTURED-FAILURE", "An unconfigured HubSpot app must report its missing schema cache";
    }
    auto inventory = TypeScriptActionInterface::getDiscoveryInventory();
    if ((map $1, inventory, $1.app == "Hubspot" && $1.action).size() != 78) {
        throw "MISSING-INVENTORY", "HubSpot identities must survive unavailable schemas";
    }
    DataProviderActionCatalog::getAppEx("Slack");
    print("Unconfigured HubSpot retains its identities and leaves Slack available\n");
'

# All eight external-schema apps remain discoverable and fail explicitly when used unconfigured.
/usr/bin/qore -M --enable-debug -l TypeScriptActionInterface -l json -e '
    DataProvider::checkStaticInit();
    auto contracts = parse_json(File::readTextFile(ARGV[0])).apps;
    auto inventory = TypeScriptActionInterface::getDiscoveryInventory();
    foreach auto contract in (contracts.values()) {
        DataProviderActionCatalog::getAppEx(contract.app);
        if (!TypeScriptActionInterface::getAppSchemaError(contract.app)) {
            throw "MISSING-SCHEMA-ERROR", contract.app;
        }
        try { TypeScriptActionInterface::checkAppActions(contract.app); } catch (auto ex) {}
        auto failures = DataProviderActionCatalog::getInitializationFailures((contract.app,));
        if (!(map $1, failures, $1.error == "APP-SCHEMAS-UNAVAILABLE")) {
            throw "MISSING-STRUCTURED-FAILURE", contract.app;
        }
        auto actual = map $1.action, inventory, $1.app == contract.app && $1.action;
        if (sort(actual) != sort(contract.actions)) {
            throw "MISSING-INVENTORY", contract.app;
        }
    }
    DataProviderActionCatalog::getAppEx("Slack");
    print("All external-schema identities remain discoverable; Slack remains usable\n");
' "$catalogue/dist/schema-cache/app-contracts.json"
