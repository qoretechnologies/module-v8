#!/usr/bin/env qore

%new-style
%require-types
%strict-args
%enable-all-warnings

%requires TypeScriptActionInterface
%requires RestClient
%requires Logger
%requires yaml
%requires v8

%exec-class TsProxy

hashdecl EventInfo {
    string key;
    hash<AsyncCallInfo> event;
    int tid;
    Condition cond();
    bool running;
    int waiting;
    #! stop flag
    bool stop_flag = False;
}

class TsProxy inherits TypeScriptProxy {
    public {
        hash<auto> opts;

        const Opts = {
            "socket": "s,socket=s",
            "logdir": "l,logdir=s",
            "verbose": "v,verbose:i+",
            "help": "h,help",
        };
    }

    private {
        string pkey;

        Mutex m();

        Logger logger;

        # event map
        hash<EventInfo> event;

        AbstractDataProviderBulkRecordInterface search;
    }

    constructor() : TypeScriptProxy(False) {
        opts = GetOpt::parseExit(Opts, \ARGV);
        if (opts.help || !opts.socket) {
            usage();
        }
        set_signal_handler(SIGUSR1, \signalHandler());
        pkey = ENV.TS_PROXY_PROCESS_KEY;
        setupLogger();
        DataProvider::setGlobalLogger(logger);

        # we have to make sure that no further servers are started by the TypeScriptActionInterface module
        TypeScriptActionInterface::disableServerOnDemand();

        info("Connecting to server at %y with key %y (logdir %y)", opts.socket, pkey, opts.logdir);
        s.connectUNIX(opts.socket);
        string yaml = makeSend(CC_STARTED, {
            "pkey": pkey,
            "pid": getpid(),
        });
        sendString(yaml);
        info("Connected to server: %y", s.getPeerInfo());
        commandLoop();
    }

    private signalHandler(int signal) {
        hash<auto> info;
        foreach hash<auto> i in (get_all_thread_call_stacks().pairIterator()) {
            splice i.value, 0, 2;
            info{i.key} = map $1.type != "new-thread"
                ? sprintf("%s %s()", get_ex_pos($1), $1.function)
                : "new-thread",
                i.value;
        }
        # first add stack traces to log file
        File f();
        string fn = sprintf("/tmp/ts-proxy-%d.log", getpid());
        f.open2(fn, O_CREAT | O_APPEND | O_WRONLY);
        f.printf("%s: %N\n", now_us().format("IF"), info);
        # now send status message to parent
        string yaml = makeSend(CC_STATUS, {
            "info": sprintf("%N", info),
        });
        sendString(yaml);
    }

    private setupLogger(string name = "console") {
        LoggerLevel level;
        if (opts.verbose > 1) {
            level = LoggerLevel::getLevelDebug();
        } else if (opts.verbose) {
            level = LoggerLevel::getLevelInfo();
        } else {
            level = LoggerLevel::getLevelError();
        }
        logger = new Logger(name, level);
        logger.addAppender(new StdoutAppender());

        if (opts.logdir.val()) {
            string fn = sprintf("%s/ts-proxy-%d.log", opts.logdir, getpid());
            LoggerAppenderFileRotate lafr("ts-proxy",
                new LoggerLayoutPattern("%d{YYYY-MM-DD HH:mm:SS.xx} T%t [%p]: %m%n"), fn);
            lafr.open();
            logger.addAppender(lafr);
        }
    }

    #! This runs in the child
    private commandLoop() {
        while (True) {
            hash<auto> h;
            try {
                h = getCommand(500ms);
                if (!ValidCommands{h.cmd}) {
                    throw "CMD-ERROR", sprintf("Unknown parent command %y; valid send commands: %y", h.cmd,
                        keys ValidCommands);
                }
            } catch (hash<ExceptionInfo> ex) {
                if (ex.err == "SOCKET-TIMEOUT") {
                    continue;
                }
                error("Error processing command from parent: %s", get_exception_string(ex));
                break;
            }

            if (h.cmd == PC_EXIT) {
                info("Child process PID %d exiting on parent's request", getpid());
                break;
            }
            debug("Got msg from server: %y", LoggerUtil::getArgSummary(h));
            try {
                switch (h.cmd) {
                    case PC_CALL:
                        doAsyncCall(h.args[0], h.args[1], h.args[2], h.args[3]);
                        break;

                    case PC_SETUP_EVENT:
                        setupEvent(h.args[0], h.args[1], h.args[2], h.args[3]);
                        break;

                    case PC_RELEASE_EVENT:
                        releaseEvent(h.args[0]);
                        break;

                    case PC_GET_REQUEST_TYPE:
                        getRequestType(h.args[0], h.args[1], h.args[2], h.args[3], h.args[4]);
                        break;

                    case PC_GET_RESPONSE_TYPE:
                        getResponseType(h.args[0], h.args[1], h.args[2], h.args[3], h.args[4]);
                        break;

                    case PC_GET_EVENT_TYPE:
                        getEventType(h.args[0], h.args[1], h.args[2], h.args[3], h.args[4]);
                        break;

                    case PC_GET_DYNAMIC_OPTIONS:
                        getDynamicOptions(h.args[0], h.args[1], h.args[2], h.args[3], h.args[4]);
                        break;

                    case PC_SEARCH_RECORDS:
                        searchRecords(h.args[0], h.args[1], h.args[2], h.args[3], h.args[4], h.args[5]);
                        break;

                    case PC_RELEASE_SEARCH:
                        releaseSearch();
                        break;

                    case PC_GET_RECORDS:
                        getRecords();
                        break;

                    default:
                        throw "UNKNOWN-COMMAND", sprintf("Unknown command %y", h.cmd);
                }
            } catch (hash<ExceptionInfo> ex) {
                error("Error executing %y: %s", h.cmd, get_exception_string(ex));
                string yaml = makeSend(CC_ERR, {
                    "ex": {
                        "err": ex.err,
                        "desc": get_exception_string(ex),
                    }
                });
                sendString(yaml);
            }
        }

        info("Child process PID %d terminating", getpid());
        exit(0);
    }

    private searchRecords(string app, string conn_name, hash<auto> conn_opts, int block_size, *binary where_cond_data,
            hash<auto> search_options) {
        ASSERT(!event);
        TypeScriptActionInterface::initApp(app);
        TypeScriptActionRecordBasedDataProvider prov =
            TypeScriptActionInterface::getAppDataProvider(app).getChildProviderPath("tables/" + search_options.table);
        if (conn_name.val()) {
            prov.setConnection(getRestConnection(app, conn_name, conn_opts));
        }
        hash<DataProviderExpression> where_cond;
        if (where_cond_data) {
            where_cond = Serializable::deserialize(where_cond_data);
        }
        search = prov.searchRecordsBulk(block_size, where_cond, search_options);
        *hash<auto> rv = search.getValue();
        if (!rv.firstValue().lsize()) {
            remove search;
            info("Search @%s complete -> %y", app, LoggerUtil::getArgSummary(rv));
        } else {
            info("Search @%s started -> %y", app, LoggerUtil::getArgSummary(rv));
        }
        string yaml = makeSend(CC_OK, {
            "rv": rv,
        });
        sendString(yaml);
    }

    private releaseSearch() {
        if (search) {
            info("Releasing search");
            remove search;
        } else {
            info("No active search to release");
        }
        string yaml = makeSend(CC_OK);
        sendString(yaml);
    }

    private getRecords() {
        if (!search) {
            throw "NO-ACTIVE-SEARCH", "No active search to get records from";
        }
        *hash<auto> rv = search.getValue();
        if (!rv.firstValue().lsize()) {
            remove search;
            info("Search complete -> %y", LoggerUtil::getArgSummary(rv));
        } else {
            info("Retrieved records -> %y", LoggerUtil::getArgSummary(rv));
        }
        string yaml = makeSend(CC_OK, {
            "rv": rv,
        });
        sendString(yaml);
    }

    private setupEvent(string app, string action, string key, *hash<auto> arg0) {
        ASSERT(!search);
        TypeScriptActionInterface::initApp(app);
        TypeScriptActionInterface::initAppAction(app, action);
        if (event.running) {
            throw "EVENT-ERROR", sprintf("Event key %y is already running", event.key);
        }

        event = <EventInfo>{
            "key": key,
            "event": TypeScriptActionInterface::getCall(key),
        };
        *hash<DataContextInfo> arg;
        if (arg0) {
            arg = cast<hash<DataContextInfo>>(arg0);
        }

        # connect to the master socket
        Socket event_socket();
        event_socket.connectUNIX(opts.socket);
        string yaml = makeSend(CC_EVENT_START, {
            "pkey": pkey,
            "pid": getpid(),
        });
        sendString(event_socket, yaml);
        info("Connected to server event socket: %y", event_socket.getPeerInfo());

        Counter cnt(1);
        Counter ecnt(1);
        background eventThread(cnt, ecnt, event_socket, key, arg);
        cnt.waitForZero();

        yaml = makeSend(CC_OK);
        sendString(yaml);
        ecnt.dec();
        info("Started event thread");
    }

    private eventThread(Counter cnt, Counter ecnt, Socket event_socket, string key, *hash<DataContextInfo> arg) {
        event.tid = gettid();
        on_exit {
            m.lock();
            on_exit m.unlock();
            if (event.waiting) {
                event.running = False;
                event.cond.broadcast();
            } else {
                remove event;
            }
            info("Terminated JavaScript I/O event thread");
        }

        event.running = True;
        # signal calling thread that we are running
        cnt.dec();
        ecnt.waitForZero();
        try {
            hash<AsyncCallInfo> call = event.event;
            info("Running event function for @%s/%s: %s", call.app, call.action, call.key);
            TypeScriptActionDataProviderBase::getAsyncValueArgs(logger, call, (arg,
                sub (JavaScriptObject o) {
                    auto event_data = o.toData();
                    if (event_data.typeCode() != NT_HASH) {
                        throw "INVALID-EVENT-DATA", sprintf("Cannot raise event for key with type %y; must be a hash "
                            "(JavaScript object)", key, event_data.fullType());
                    }

                    #debug("Sending event: key: %y event: %y", key, event_data);
                    string yaml = makeSend(CC_EVENT, {
                        "key": key,
                        "event": event_data,
                    });
                    sendString(event_socket, yaml);
                },
                bool sub () {
                    return event.stop_flag;
                })
            );
            info("Event function for @%s/%s: %s returned", call.app, call.action, call.key);
        } catch (hash<ExceptionInfo> ex) {
            error("EVENT-THREAD-ERROR", "Exception in event thread: %s", get_exception_string(ex));
        }
        try {
            if (!event.stop_flag) {
                error("The event thread terminated prematurely; notifying parent");
                string yaml = makeSend(CC_EVENT_TERMINATED, {
                    "key": key,
                });
                sendString(event_socket, yaml);
            }
        } catch (hash<ExceptionInfo> ex) {
            error("EVENT-THREAD-ERROR", "Exception in event thread: %s", get_exception_string(ex));
        }
    }

    private releaseEvent(string key) {
        m.lock();
        on_exit m.unlock();

        if (event.key) {
            if (event.key != key) {
                string yaml = makeSend(CC_ERR, {
                    "ex": {
                        "err": "INVALID-EVENT-KEY",
                        "desc": sprintf("Event key %y is unknown; managed event key: %y", key, event.key),
                    },
                });
                sendString(yaml);
                info("Cannot release unknown event key %y; managed event key: %y", key, event.key);
                return;
            }
            if (!event.stop_flag) {
                event.stop_flag = True;
            }
            while (event.running) {
                ++event.waiting;
                event.cond.wait(m);
                --event.waiting;
            }
            if (event && !event.waiting) {
                remove event;
            }
        }
        string yaml = makeSend(CC_OK);
        sendString(yaml);
        info("Released event %y", key);
    }

    private doAsyncCall(string app, *string action, string key, auto args) {
        TypeScriptActionInterface::initApp(app);
        if (action) {
            TypeScriptActionInterface::initAppAction(app, action);
        }
        hash<AsyncCallInfo> api;
        try {
            api = TypeScriptActionInterface::getCall(key);
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "ASYNC-CALL-ERROR") {
                AbstractDataProvider prov = TypeScriptActionInterface::getAppDataProvider(app).getChildProviderEx(action);
                if (prov instanceof TypeScriptActionApiWithSchemaDataProvider) {
                    cast<TypeScriptActionApiWithSchemaDataProvider>(prov).init();
                }
                api = TypeScriptActionInterface::getCall(key);
            } else {
                rethrow;
            }
        }
        DataProviderDataContextHelper dch(args);
        auto rv = TypeScriptActionDataProviderBase::getAsyncValueArgs(logger, api, args);
        string yaml = makeSend(CC_OK, {
            "rv": rv,
        });
        sendString(yaml);
    }

    private getEventType(string app, string action, *string conn_name, *hash<auto> conn_opts, *hash<auto> options) {
        info("Get event type app: %y action: %y conn_opts: %y options: %y", app, action,
            LoggerUtil::getArgSummary(conn_opts), LoggerUtil::getArgSummary(options));
        TypeScriptActionInterface::initApp(app);
        TypeScriptActionInterface::initAppAction(app, action);
        TypeScriptActionEventDataProviderBase prov = TypeScriptActionInterface::getAppDataProvider(app)
            .getChildProviderEx(action);
        prov.setLogger(logger);
        DataProviderDataContextHelper dch(options);
        if (conn_name.val()) {
            prov.setConnection(getRestConnection(app, conn_name, conn_opts));
        }
        *HashDataType type = prov.getEventInfoWithOptions(prov.getEventId(), options).type;
        string yaml = makeSend(CC_OK, {
            "rv": type ? type.serialize() : NOTHING,
        });
        sendString(yaml);
    }

    private getDynamicOptions(string app, string action, *string conn_name, *hash<auto> conn_opts,
            *hash<auto> options) {
        info("Get dynamic options app: %y action: %y conn_opts: %y options: %y", app, action,
            LoggerUtil::getArgSummary(conn_opts), LoggerUtil::getArgSummary(options));
        TypeScriptActionInterface::initApp(app);
        TypeScriptActionInterface::initAppAction(app, action);
        TypeScriptActionDataProviderBase prov = TypeScriptActionInterface::getAppDataProvider(app)
            .getChildProviderEx(action);
        prov.setLogger(logger);
        DataProviderDataContextHelper dch(options);
        if (conn_name.val()) {
            prov.setConnection(getRestConnection(app, conn_name, conn_opts));
        }
        *hash<string, hash<ActionOptionInfo>> rv = prov.tryGetActionOptionsWithOptions(
            DataProviderActionCatalog::getAppAction(app, action), options);
        string yaml = makeSend(CC_OK, {
            "rv": rv ? Serializable::serialize(rv) : NOTHING,
        });
        sendString(yaml);
    }

    private getRequestType(string app, string action, *string conn_name, *hash<auto> conn_opts, *hash<auto> options) {
        info("Get request type app: %y action: %y conn_opts: %y options: %y", app, action,
            LoggerUtil::getArgSummary(conn_opts), LoggerUtil::getArgSummary(options));
        TypeScriptActionInterface::initApp(app);
        TypeScriptActionInterface::initAppAction(app, action);
        TypeScriptActionApiDataProvider prov = TypeScriptActionInterface::getAppDataProvider(app)
            .getChildProviderEx(action);
        prov.setLogger(logger);
        DataProviderDataContextHelper dch(options);
        if (conn_name.val()) {
            prov.setConnection(getRestConnection(app, conn_name, conn_opts));
        }
        *AbstractDataProviderType type = prov.getRequestTypeWithOptions(options);
        if (type && (type instanceof HashDataType)) {
            TypeScriptActionInterface::resolveDynamicType(prov, options, type);
        }
        string yaml = makeSend(CC_OK, {
            "rv": type ? type.serialize() : NOTHING,
        });
        sendString(yaml);
    }

    private getResponseType(string app, string action, *string conn_name, *hash<auto> conn_opts,
            *hash<auto> options) {
        info("Get response type app: %y action: %y conn_opts: %y options: %y", app, action,
            LoggerUtil::getArgSummary(conn_opts), LoggerUtil::getArgSummary(options));
        TypeScriptActionInterface::initApp(app);
        TypeScriptActionInterface::initAppAction(app, action);
        TypeScriptActionApiDataProvider prov = TypeScriptActionInterface::getAppDataProvider(app)
            .getChildProviderEx(action);
        prov.setLogger(logger);
        DataProviderDataContextHelper dch(options);
        if (conn_name.val()) {
            prov.setConnection(getRestConnection(app, conn_name, conn_opts));
        }
        *AbstractDataProviderType type = prov.getResponseTypeWithOptions(options);
        if (type && (type instanceof HashDataType)) {
            TypeScriptActionInterface::resolveDynamicType(prov, options, type);
        }
        string yaml = makeSend(CC_OK, {
            "rv": type ? type.serialize() : NOTHING,
        });
        sendString(yaml);
    }

    private TypeScriptAppRestConnection getRestConnection(string app, string conn_name, *hash<auto> conn_opts) {
        return new TypeScriptAppRestConnection({
            "name": conn_name,
            "app": app,
            "url": "tsrest-" + app.lwr() + "://x",
            "opts": conn_opts,
        });
    }

    private *bool retry(hash<ExceptionInfo> ex) {
        fatal("Fatal error communicating with the server: %s; terminating the process", get_exception_string(ex));
        exit(1);
    }

    private debug(string fmt, ...) {
        fmt = "ts-proxy: " + fmt;
        logger.logArgs(LoggerLevel::LevelDebug, fmt, argv);
    }

    private info(string fmt, ...) {
        fmt = "ts-proxy: " + fmt;
        logger.logArgs(LoggerLevel::LevelInfo, fmt, argv);
    }

    private error(string fmt, ...) {
        fmt = "ts-proxy: " + fmt;
        logger.logArgs(LoggerLevel::LevelError, fmt, argv);
    }

    private fatal(string fmt, ...) {
        fmt = "ts-proxy: " + fmt;
        logger.logArgs(LoggerLevel::LevelFatal, fmt, argv);
    }

    static usage() {
        printf("usage: %s [options]
 -l,--logdir=ARG     the directory for logs
 -s,--socket=ARG     the UNIX socket file for listening to server commands
 -v,--verbose[=ARG]  the verbosity level of the program
 -h,--help           this help text
", get_script_name());
        exit(0);
    }
}
