            "TypeScriptHubspotRestClient::throwCmsForbidden": RPure,
        };

        #! The plain private instance members of the public classes that a tenant's subclass can read:
        #! "class::member" -> the reason; every other private member must be private:internal
        const PrivateMemberAllowList = {
            "TypeScriptActionApiDataProvider::api": ROwnMember,
            "TypeScriptActionApiDataProvider::request_type_info": ROwnMember,
            "TypeScriptActionApiDataProvider::response_type_info": ROwnMember,
            "TypeScriptActionApiWithSchemaDataProvider::action_save": ROwnMember,
            "TypeScriptActionApiWithSchemaDataProvider::conn_opt_map": ROwnMember,
            "TypeScriptActionApiWithSchemaDataProvider::ignore_options_save": ROwnMember,
            "TypeScriptActionApiWithSchemaDataProvider::include_response_headers": ROwnMember,
            "TypeScriptActionApiWithSchemaDataProvider::independent_path_vars": ROwnMember,
            "TypeScriptActionApiWithSchemaDataProvider::override_options_save": ROwnMember,
            "TypeScriptActionApiWithSchemaDataProvider::path_vars": ROwnMember,
            "TypeScriptActionApiWithSchemaDataProvider::query_set": ROwnMember,
            "TypeScriptActionApiWithSchemaDataProvider::request_key": ROwnMember,
            "TypeScriptActionApiWithSchemaDataProvider::request_type_done": ROwnMember,
            "TypeScriptActionApiWithSchemaDataProvider::res_only_body": ROwnMember,
            "TypeScriptActionApiWithSchemaDataProvider::response_type_done": ROwnMember,
            "TypeScriptActionApiWithSchemaDataProvider::rest_schema": ROwnMember,
            "TypeScriptActionApiWithSchemaDataProvider::schema_path": ROwnMember,
            "TypeScriptActionDataProviderBase::conn": ROwnMember,
            "TypeScriptActionDataProviderBase::docache": ROwnMember,
            "TypeScriptActionDataProviderBase::dtcache": ROwnMember,
            "TypeScriptActionDataProviderBase::name": ROwnMember,
            "TypeScriptActionDataProviderBase::rest": ROwnMember,
            "TypeScriptActionEventDataProviderBase::event_id": ROwnMember,
            "TypeScriptActionEventDataProviderBase::event_info": ROwnMember,
            "TypeScriptActionEventDataProviderBase::event_type_info": ROwnMember,
            "TypeScriptActionEventDataProviderBase::get_example_event_data": ROwnMember,
            "TypeScriptActionRecordBasedDataProvider::ofmap": ROwnMember,
            "TypeScriptActionRecordBasedDataProvider::option_map": ROwnMember,
            "TypeScriptActionRecordBasedDataProvider::record_type": ROwnMember,
            "TypeScriptAppRestClient::conn": RConn,
            "TypeScriptAppRestClient::token_header": RConn,
            "TypeScriptAppRestConnection::app": RConn,
            "TypeScriptAppRestConnection::appname": RConn,
            "TypeScriptAppRestConnection::cache": RConn,
            "TypeScriptAppRestConnection::cmap": RConn,
            "TypeScriptAppRestConnection::info": RConn,
            "TypeScriptAppRestConnection::m": RConn,
            "TypeScriptAppRestConnection::pmap": RConn,
            "TypeScriptAppRestConnection::scheme": RConn,
            "TypeScriptAppRestConnection::url_template_options": RConn,
            "TypeScriptAppRestConnection::wmap": RConn,
        };

        #! The errors with which the module refuses sandboxed code
        const RefusalErrors = {
            "SANDBOX-REGISTRATION-ERROR": True,
            "TS-TENANT-ERROR": True,
        };

        #! The static members of the module's classes that hold state every caller shares (qoretechnologies/qore#7185)
        /** class -> members; a subclass that a tenant declares must not be able to name them: the objects they hold
            (the socket to the master process, the queues of the replies to every caller, the proxies of every
            caller, the locks) can be used through their methods even though Qore refuses sandboxed code a change of
            the member
        */
        const SharedStatics = {
            "JavaScriptProgramProxy": ("startup_timeout", "master_path", "master", "global_lock", "qmap", "cmap",
                "test_remove_hook", "emap", "master_listener_tid", "master_listener_cnt", "master_listener_stop",
                "master_pid", "sem_write", "sem_read", "sem_info"),
            "TypeScriptActionApiWithSchemaDataProvider": ("grtmap", "reqmap", "rreqmap", "gtlock"),
            "JavaScriptThreadProcessPool": ("m",),
        };

        #! The error codes of the cases that are not SANDBOX-REGISTRATION-ERROR
        const OtherErrors = {
            # the function of a call refuses sandboxed code
            "provider call function": "guarded",
            "api call function": "guarded",
            "runner releaseConcurrency": "TS-TENANT-ERROR",
            # an app that is not registered
            "getCamelCaseAppName error": "APP-ERROR",
            "getRestConfig error": "TYPESCRIPT-APP-ERROR",
        };

        #! Direct reads of the process-wide state: name -> code returning a string
        const DirectCases = {
            "Api": "return sprintf(\"%y\", keys TypeScriptActionInterface::Api);",
            "TestApi": "return sprintf(\"%y\", keys TypeScriptActionInterface::TestApi);",
            "root": "return sprintf(\"%y\", TypeScriptActionInterface::root.typeCode());",
            "server": "return sprintf(\"%y\", TypeScriptActionInterface::server.typeCode());",
            "WebhookCreate": "return sprintf(\"%y\", TypeScriptActionInterface::WebhookCreate.typeCode());",
            "creating_actions": "return sprintf(\"%y\", TypeScriptActionInterface::creating_actions.typeCode());",
            "acmap": "return X::get();\n}\nclass X inherits TypeScriptActionInterface::TypeScriptActionInterface {\n"
                "static string get() { return sprintf(\"%y\", keys acmap); }",
            "appmap": "return X::get();\n}\nclass X inherits TypeScriptActionInterface::TypeScriptActionInterface {\n"
                "static string get() { return sprintf(\"%y\", keys appmap); }",
            "appcasemap": "return X::get();\n}\n"
                "class X inherits TypeScriptActionInterface::TypeScriptActionInterface {\n"
                "static string get() { return sprintf(\"%y\", keys appcasemap); }",
            "private method": "return X::get();\n}\n"
                "class X inherits TypeScriptActionInterface::TypeScriptActionInterface {\n"
                "static string get() { return sprintf(\"%y\", getModulePath()); }",
            # the private state of the other classes of the module, through a subclass
            "program pool map": "return X::get();\n}\n"
                "class X inherits TypeScriptActionInterface::JavaScriptProgramPool {\n"
                "static string get() { return sprintf(\"%y\", keys pmap); }",
            "data cache": "return X::get();\n}\n"
                "class X inherits TypeScriptActionInterface::TypeScriptActionDataProviderBase {\n"
                "static string get() { return sprintf(\"%y\", cache.typeCode()); }",
            # the members of objects that the tenant has, through a subclass
            "record provider calls of an object": "return Y::peek(a.record_prov);\n}\n"
                "class Y inherits TypeScriptActionInterface::TypeScriptActionRecordBasedDataProvider {\n"
                "static string peek(TypeScriptActionInterface::TypeScriptActionRecordBasedDataProvider p) { "
                "return exists p.get_table_list ? \"read\" : \"not readable\"; }",
            "in-process pool state of an object": "return Y::peek(a.host_ip);\n}\n"
                "class Y inherits TypeScriptActionInterface::JavaScriptInProcessPool {\n"
                "static string peek(TypeScriptActionInterface::JavaScriptInProcessPool p) { "
                "return exists p.imap ? \"read\" : \"not readable\"; }",
            "connection calls of an object": TenantConn + "return Y::peek(c);\n}\n"
                "class Y inherits TypeScriptActionInterface::TypeScriptAppRestConnection {\n"
                "static string peek(TypeScriptActionInterface::TypeScriptAppRestConnection c) { "
                "return exists c.post_auth ? \"read\" : \"not readable\"; }",
            "program pool state of an object": "return Y::peek(a.pool);\n}\n"
                "class Y inherits TypeScriptActionInterface::JavaScriptProgramPool {\n"
                "static string peek(TypeScriptActionInterface::JavaScriptProgramPool p) { "
                "return exists p.init ? \"read\" : \"not readable\"; }",
        };
    }

    private {
        #! The host's program pool
        JavaScriptProgramPool pool;

        #! The host's in-process server
        JavaScriptInProcessPool host_ip;

        #! The in-process pool that the tenants try to set
        JavaScriptInProcessPool tenant_ip;

        #! The call time limit before the test
        date old_timeout;

        #! The startup timeout of the proxies before the test
        date old_startup_timeout = JavaScriptProgramProxy::getStartupTimeout();

        #! The calls of the host's webhook API
        list<string> webhook_calls = ();

        #! The program pool of the host's catalogue
        JavaScriptProgramPool catalogue_pool;

        #! The app base directory before the test
        string old_base_dir;

        #! A record provider of the host's connection to the catalogue's app
        AbstractDataProvider record_prov;

        #! The host's connection to the catalogue's app
        TypeScriptAppRestConnection host_conn;

        #! The app with a REST schema
        string schema_app;

        #! The directory of the app's schema
        TmpDir schema_dir("qore-test-7185-");

        #! The host's objects that the classification test gives the tenants: class name -> object
        hash<string, object> objects = {};

        #! The methods that the classification test cannot exercise: class::method or class::* -> reason
        hash<string, string> unexercised = {};
    }

    constructor() : QUnit::Test("TenantProcessWideState", "1.0", \ARGV) {
        addTestCase("tenants cannot use the public API of the process-wide state", \apiTest());
        addTestCase("tenants cannot read the process-wide state directly", \directTest());
        addTestCase("tenants get working copies of the providers of the apps", \copyTest());
        addTestCase("the host's state is unchanged by the tenants", \hostStateTest());
        addTestCase("trusted code uses the public API", \trustedTest());
        addTestCase("every public static method refuses sandboxed code or is allowed for a reason",
            \classificationTest());
        addTestCase("tenants cannot get the schema providers of the apps", \schemaProviderTest());
        addTestCase("the module's initialization runs once", \initOnceTest());
        set_return_value(main());
    }

    globalSetUp() {
        # the host's catalogue
        string script = get_script_dir() + "/tenant-catalogue.js";
        catalogue_pool = new JavaScriptProgramPool("var exports = {};\nasync function runWithTimeout(p, d) { "
            "return await (typeof p === 'function' ? p() : p); }\n" + ReadOnlyFile::readTextFile(script), script,
            sub (V8::JavaScriptProgram pgm) {
                pgm.getGlobal().exports.actionsCatalogue.registerAppActions(
                    TypeScriptActionInterface::getInterface());
            });
        TenantActionRunner::setCatalogue(script, (get_script_dir(),), catalogue_pool);
        TypeScriptActionInterface::initApp(CatalogueApp, True);
        TypeScriptActionInterface::initApp(CatalogueRecordApp, True);
        old_base_dir = TypeScriptActionInterface::getAppBaseDir();
        host_conn = new TypeScriptAppRestConnection({"name": "qore-test-6749", "url": "tsrest-" + CatalogueApp
            + "://conn.example.com", "opts": {"token": "x"}});
        record_prov = host_conn.getDataProvider().getChildProviderPath("tables/items");

        pool = new JavaScriptProgramPool("", "qore-test-6749.js", sub (V8::JavaScriptProgram pgm) {});
        host_ip = new JavaScriptInProcessPool(pool, 1);
        tenant_ip = new JavaScriptInProcessPool(pool, 1);
        old_timeout = TypeScriptActionInterface::getCallTimeout();
        TypeScriptActionInterface::setInProcessServer(host_ip);
        hash<AsyncCallInfo> call = <AsyncCallInfo>{
            "app": HostApp,
            "type": "host_function",
            "label": "host",
            "pool": pool,
            "async_call": sub () {},
        };
        assertEq(HostCallKey, TypeScriptActionInterface::registerAsyncCall(\call, "app", HostApp));
        # an app with a REST schema
        schema_app = "qore-test-7185-schema-" + get_random_string(8);
        string schema_file = schema_dir.path + DirSep + "schema.json";
        File f();
        f.open2(schema_file, O_CREAT | O_EXCL | O_WRONLY, 0600);
        f.write(make_json({"openapi": "3.0.3", "info": {"title": "Schema fixture", "version": "1"},
            "paths": {"/items": {"get": {"responses": {"200": {"description": "ok"}}}}}}));
        f.close();
        TypeScriptActionInterface::registerApp({"name": schema_app, "display_name": "Schema fixture",
            "short_desc": "Schema fixture", "desc": "Schema fixture.", "groups": ("Other",),
            "logo": make_base64_string(<00>), "logo_file_name": "test.svg", "logo_mime_type": "image/svg+xml",
            "dynamic": True, "rest": {"url": "https://schema.example.com", "data": "json"}, "openapi": schema_file},
            pool);
        TypeScriptActionInterface::registerAction({"app": schema_app, "action": "list-items",
            "display_name": "List Items", "short_desc": "List items", "desc": "Lists items.",
            "action_code": DPAT_API, "openapi_path": "/items/GET"}, pool);
        TypeScriptActionInterface::initApp(schema_app, True);
        setUpObjects();

        # the host's webhook API, which is set once per process
        TypeScriptActionInterface::registerWebhookCreateDestroyApis(hash<auto> sub (hash<auto> h) {
            webhook_calls += "create";
            return {"url": "https://host.example.com/hook", "ctx": "c"};
        }, sub (hash<auto> info) {
            webhook_calls += "delete";
        });
    }

    #! Creates the host's objects of the classes of the module that the classification test gives the tenants
    private setUpObjects() {
        objects.JavaScriptProgramPool = catalogue_pool;
        objects.JavaScriptInProcessPool = host_ip;
        objects.JavaScriptProgram = catalogue_pool.getProgram();
        objects.JavaScriptObject = catalogue_pool.getProgram().getGlobal();
        objects.TypeScriptAppRestConnection = host_conn;
        objects.AbstractDataProvider = record_prov;
        objects.TypeScriptActionDataProviderBase = host_conn.getDataProvider().getChildProviderEx("info");
        objects.TypeScriptActionRecordBasedDataProvider = record_prov;
        TypeScriptActionInterface::initApp("tenant-test", True);
        objects.TypeScriptActionEventDataProvider = TypeScriptActionInterface::getAppDataProvider("tenant-test")
            .getChildProviderEx("ticks");
        TypeScriptAppRestConnection schema_conn({"name": "qore-test-7185-schema", "url": "tsrest-"
            + schema_app.lwr() + "://", "opts": {"token": "x"}});
        objects.TypeScriptActionApiWithSchemaDataProvider = TypeScriptActionInterface::getDataProvider(
            schema_app.lwr(), schema_conn).getChildProviderEx("list-items");
        # the process pool and the proxies start ts-proxy child processes
        string local_bin = sprintf("%s/../bin", get_script_dir());
        if (hstat(local_bin)) {
            setenv("PATH", local_bin + ":" + ENV.PATH);
        }
        try {
            objects.JavaScriptThreadProcessPool = new JavaScriptThreadProcessPool();
            objects.JavaScriptProgramProxy = new JavaScriptProgramProxy();
        } catch (hash<ExceptionInfo> ex) {
            unexercised."JavaScriptThreadProcessPool::*" = sprintf("no ts-proxy child process can be started: %s: %s",
                ex.err, ex.desc);
            unexercised."JavaScriptProgramProxy::*" = unexercised."JavaScriptThreadProcessPool::*";
        }
    }

    globalTearDown() {
        # the proxies and their child processes end before the process does
        bool proxies = exists objects.JavaScriptThreadProcessPool;
        remove objects.JavaScriptProgramProxy;
        remove objects.JavaScriptThreadProcessPool;
        if (proxies) {
            JavaScriptProgramProxy::shutdown();
        }
        if (schema_app) {
            TypeScriptActionInterface::deregisterDynamicApp(schema_app);
        }
        TypeScriptActionInterface::setCallTimeout(old_timeout);
        TypeScriptActionInterface::setAppBaseDir(old_base_dir == getcwd() ? NOTHING : old_base_dir);
        JavaScriptProgramProxy::setStartupTimeout(old_startup_timeout);
        TypeScriptActionInterface::disableServerOnDemand();
        TypeScriptActionInterface::disableInProcessServerOnDemand();
        TypeScriptActionInterface::shutdownInProcessServer();
        TypeScriptActionInterface::shutdownServer();
    }

    apiTest() {
        hash<auto> all;
        hash<auto> all_expected;
        foreach hash<auto> i in (ApiCases.pairIterator()) {
            hash<auto> results = {};
            try {
                # two tenants with sandboxes of their own
                foreach string name in ("tenant-a", "tenant-b") {
                    results{name} = TenantProcessWideStateTest::tenant(name, i.value).callFunction("t", args());
                }
                # a background thread of a tenant
                results.background = TenantProcessWideStateTest::tenant("tenant-bg", i.value, True)
                    .callFunction("t", args());
                # trusted code that a tenant calls under a system-policy barrier
                Program trusted = TenantProcessWideStateTest::trusted(i.value);
                code cap = trusted.callFunction("cap", args());
                Program tenant_c = TenantProcessWideStateTest::program("tenant-c",
                    "auto sub t(code c) { return c(); }", True);
                results.barrier = tenant_c.callFunction("t", cap);
                # a Program that a tenant creates, called later by trusted code
                Program tenant_d = TenantProcessWideStateTest::program("tenant-d", "Program sub t(string src) { "
                    "Program p(PO_NEW_STYLE); p.parse(src, \"child\"); return p; }", True);
                Program child = tenant_d.callFunction("t", TenantProcessWideStateTest::runSource(i.value));
                results.child = child.callFunction("run", args());
            } catch (hash<ExceptionInfo> ex) {
                results.error = sprintf("%s: %s", ex.err, ex.desc);
                # a class of the Program that a tenant creates reads a private member of a class of this module
                # (trusted code): it is refused when the Program is parsed (qore#7258), where it was parsed before
                # and refused by the guard of the call when it ran ("guarded").  Both refuse the call, in a case that
                # expects the refusal; any other error, and the cases that expect another result, do not match.
                if (!exists results.child && OtherErrors{i.key} == "guarded" && ex.err == "PARSE-EXCEPTION"
                    && ex.desc =~ /^illegal access to private member '[^']+' of class '[^']+' in class '[^']+': a class declared by sandboxed code cannot use the private declarations of a class declared by trusted code/) {
                    results.child = "guarded";
                    delete results.error;
                }
            }

            all{i.key} = results;
            all_expected{i.key} = map {$1: OtherErrors{i.key} ?? "SANDBOX-REGISTRATION-ERROR"},
                ("tenant-a", "tenant-b", "background", "barrier", "child");
        }
        assertEq(all_expected, all);
    }

    directTest() {
        hash<auto> all;
        hash<auto> cases = DirectCases;
        foreach hash<auto> i in (SharedStatics.pairIterator()) {
            foreach string member in (i.value) {
                cases{i.key + "::" + member} = "return X::get();\n}\nclass X inherits TypeScriptActionInterface::"
                    + i.key + " {\nstatic string get() { return sprintf(\"%y\", " + member + ".typeCode()); }";
            }
        }
        foreach hash<auto> i in (cases.pairIterator()) {
            hash<auto> results = {};
            foreach string name in ("tenant-a", "tenant-b") {
                try {
                    results{name} = TenantProcessWideStateTest::tenant(name, i.value).callFunction("t", args());
                } catch (hash<ExceptionInfo> ex) {
                    results{name} = ex.err;
                    # the refusal of an access to a member that is private to its class names its reason; no other
                    # parse error is taken for it below
                    if (ex.err == "PARSE-EXCEPTION"
                        && ex.desc =~ /^illegal access to private member '[^']+' of class '[^']+'/) {
                        results{name} = "PRIVATE-MEMBER-REFUSED";
                    }
                }
            }
            all{i.key} = results;
        }
        # the state is not public: no code that imports the module can name it, and the members of an object are not
        # visible outside its class.  A subclass that reads a private:internal member of its base class through a
        # variable of the base class's type is refused when it is parsed (qore#7258); it was parsed before, and
        # answered "not readable" when it ran.  Both refuse the access; any other result, such as a parse error for
        # another reason, does not.
        hash<auto> expected;
        foreach string k in (keys cases) {
            if (k =~ /of an object/) {
                hash<auto> got = all{k};
                foreach string name in ("tenant-a", "tenant-b") {
                    if (got{name} == "PRIVATE-MEMBER-REFUSED") {
                        got{name} = "not readable";
                    }
                }
                all{k} = got;
            }
            string err = k =~ /of an object/ ? "not readable" : "PARSE-EXCEPTION";
            expected{k} = {"tenant-a": err, "tenant-b": err};
        }
        assertEq(expected, all);
    }

    copyTest() {
        # the copy of an app's provider that a tenant gets, without and with a connection of its own, gives working
        # children
        hash<auto> results = {};
        foreach string name in ("tenant-a", "tenant-b") {
            results{name} = TenantProcessWideStateTest::tenant(name, "auto p = TypeScriptActionInterface::"
                "getAppDataProvider(\"" + CatalogueApp + "\"); auto ch = p.getChildProviderEx(\"info\"); "
                "string rv = ch.getName() + \"/\" + (p.getChildProviderNames() ?? ()).size().toString(); "
                + TenantConn + "auto cch = c.getDataProvider().getChildProviderEx(\"info\"); "
                "return rv + \"/\" + cch.getName();").callFunction("t", args());
        }
        int n = (TypeScriptActionInterface::getAppDataProvider(CatalogueApp).getChildProviderNames() ?? ()).size();
        assertEq({"tenant-a": "info/" + n + "/info", "tenant-b": "info/" + n + "/info"}, results);
    }

    hostStateTest() {
        # the host's in-process server, call time limit and call are kept
        string pool_state;
        try {
            hash<auto> info = host_ip.get();
            host_ip.release(info);
            pool_state = "running";
        } catch (hash<ExceptionInfo> ex) {
            pool_state = ex.err;
        }
        assertEq({
            "in-process server": True,
            "in-process server state": "running",
            "call time limit": old_timeout,
            "call": "host",
            "tenant app load path": NOTHING,
            "webhook calls": (),
            "app children": True,
            "app base dir": old_base_dir,
            "catalogue program mapped": True,
            "proxy startup timeout": old_startup_timeout,
        }, {
            "in-process server": TypeScriptActionInterface::checkInProcessServer() == host_ip,
            "in-process server state": pool_state,
            "call time limit": TypeScriptActionInterface::getCallTimeout(),
            "call": TypeScriptActionInterface::getCall(HostCallKey).label,
            "tenant app load path": TypeScriptActionInterface::getAppLoadPath(TenantApp),
            "webhook calls": webhook_calls,
            "app children": (TypeScriptActionInterface::getAppDataProvider(CatalogueApp).getChildProviderNames()
                ?? ()).contains("info"),
            "app base dir": TypeScriptActionInterface::getAppBaseDir(),
            "catalogue program mapped": catalogueMapped(),
            "proxy startup timeout": JavaScriptProgramProxy::getStartupTimeout(),
        });
    }

    trustedTest() {
        # trusted code in the host's Program and in a trusted Program
        hash<auto> expected = {
            "getInterface": "got it",
            "getTestInterface": "got it",
            "getRoot": "ts-root",
            "getCall": "host",
        };
        foreach hash<auto> i in (expected.pairIterator()) {
            Program trusted = TenantProcessWideStateTest::trusted(ApiCases{i.key});
            assertEq(i.value, trusted.callFunction("run", args()), i.key);
        }
        assertEq(5, TypeScriptActionInterface::getInterface().size());
        assertEq(2, TypeScriptActionInterface::getInterface().getCatalogueProtocolVersion());
        assertEq(2, TypeScriptActionInterface::getTestInterface().size());
        assertEq("host", TypeScriptActionInterface::getCall(HostCallKey).label);
        assertTrue(TypeScriptActionInterface::checkInProcessServer() == host_ip);
        assertEq("list", TypeScriptActionInterface::getCatalogueAppNames().type());
        assertEq("https://host.example.com/hook", TypeScriptActionInterface::createWebhook({}).url);
        TypeScriptActionInterface::deleteWebhook({});
        assertEq(("create", "delete"), webhook_calls);
        assertNothing(TypeScriptActionInterface::getPostAuthCall(HostApp));
        assertNothing(TypeScriptActionInterface::getConnectionUpdateOptions(HostApp));

        # and changes the settings
        TypeScriptActionInterface::setCallTimeout(9s);
        assertEq(9s, TypeScriptActionInterface::getCallTimeout());
        TypeScriptActionInterface::setCallTimeout(old_timeout);
        TypeScriptActionInterface::setInProcessServer(tenant_ip);
        assertTrue(TypeScriptActionInterface::checkInProcessServer() == tenant_ip);
        TypeScriptActionInterface::setInProcessServer(host_ip);
        TypeScriptActionInterface::startInProcessServerOnDemand(pool, 1);
        TypeScriptActionInterface::disableInProcessServerOnDemand();
        TypeScriptActionInterface::startServerOnDemand();
        TypeScriptActionInterface::disableServerOnDemand();
    }

    classificationTest() {
%ifdef NoReflection
        testSkip("the reflection module is not available");
%else
        hash<string, string> results = {};
        hash<string, string> expected = {};
        hash<string, bool> methods = {};
        # the refused entry points also declare PROCESS_CONTROL, so that a Program restricted only with
        # PO_NO_PROCESS_CONTROL cannot call them either
        list<string> no_domain = ();
        foreach hash<auto> m in (TenantProcessWideStateTest::getPublicMethods()) {
            methods{m.key} = True;
            if (AllowedMethods{m.key}) {
                continue;
            }
            string id = sprintf("%s %s", m.key, m.signature);
            if (!m.process_control) {
                no_domain += id;
            }
            if (*string reason = unexercised{m.cls + "::*"} ?? unexercised{m.key}) {
                printf("not exercised: %s: %s\n", id, reason);
                continue;
            }
            expected{id} = "refused";
            string rv = callAsTenant(m);
            results{id} = RefusalErrors{rv} ? "refused" : rv;
        }
        # every variant that is not allowed is refused
        assertEq(expected, results);
        assertTrue(expected.size() > 100, "the classification finds the host-scoped entry points");
        assertEq((), no_domain);
        # the allowed methods exist: the list names no method that has been removed or renamed
        assertEq((), (map $1, keys AllowedMethods, !methods{$1}) ?? ());
        # every static member of a public class that is not private:internal is allowed for a reason
        hash<string, bool> members = {};
        foreach Class cls in (new Namespace("TypeScriptActionInterface").getClasses()) {
            foreach AbstractClassMember mem in (cls.getMembers()) {
                if (mem instanceof NormalMember || mem.getAccessModifierString() == "private:internal") {
                    continue;
                }
                members{sprintf("%s::%s", cls.getName(), mem.getName())} = True;
            }
        }
        assertEq((map {$1: True}, keys MemberAllowList) ?? {}, members);
        # every plain private method and member of a public class, which a tenant's subclass can reach, is
        # private:internal or allowed for a reason
        hash<string, bool> private_methods = {};
        hash<string, bool> private_members = {};
        foreach Class cls in (new Namespace("TypeScriptActionInterface").getClasses()) {
            string cname = cls.getName();
            foreach AbstractMethod m in (cls.getMethods() + cls.getStaticMethods()) {
                if (m.getClass().getName() != cname) {
                    continue;
                }
                foreach AbstractMethodVariant v in (m.getVariants()) {
                    if (v.getAccessModifierString() == "private") {
                        private_methods{cname + "::" + m.getName()} = True;
                    }
                }
            }
            foreach AbstractClassMember mem in (cls.getMembers()) {
                if (mem.getAccessModifierString() == "private") {
                    private_members{cname + "::" + mem.getName()} = True;
                }
            }
        }
        assertEq((map {$1: True}, keys PrivateMethodAllowList), private_methods);
        assertEq((map {$1: True}, keys PrivateMemberAllowList), private_members);
%endif
    }

%ifndef NoReflection
    #! Returns the public method variants that the public classes of the module declare
    static list<hash<auto>> getPublicMethods() {
        list<hash<auto>> rv = ();
        foreach Class cls in (new Namespace("TypeScriptActionInterface").getClasses()) {
            string cname = cls.getName();
            foreach AbstractMethod m in (cls.getMethods() + cls.getStaticMethods()) {
                if (m.getClass().getName() != cname) {
                    continue;
                }
                foreach AbstractMethodVariant v in (m.getVariants()) {
                    if (v.getAccessModifierString() != "public") {
                        continue;
                    }
                    rv += {
                        "key": sprintf("%s::%s", cname, m.getName()),
                        "cls": cname,
                        "name": m.getName(),
                        "static": m instanceof StaticMethod,
                        "ctor": m instanceof ConstructorMethod,
                        "signature": v.toString(),
                        "types": (map $1.getName(), v.getParamTypes()),
                        "process_control": v.getDomainStringList().contains("PROCESS_CONTROL"),
                    };
                }
            }
        }
        return rv;
    }
%endif

    #! Calls a method variant from a sandboxed tenant and returns the error code, or \c "ran"
    /** An instance method is called on the host's object of its class
    */
    private string callAsTenant(hash<auto> m) {
        list<string> decls = ();
        list<string> call_args = ();
        foreach string t in (m.types) {
            *string arg = TenantProcessWideStateTest::getArg(t, \decls, $#);
            if (!exists arg) {
                return sprintf("no argument for type %y; add it to getArg()", t);
            }
            call_args += arg;
        }
        string cname = "TypeScriptActionInterface::" + m.cls;
        string call;
        if (m.ctor) {
            call = sprintf("new %s(%s);", cname, call_args.join(", "));
        } else if (m.static) {
            call = sprintf("%s::%s(%s);", cname, m.name, call_args.join(", "));
        } else {
            if (!objects{m.cls}) {
                return sprintf("no object of class %y; add one to setUpObjects()", m.cls);
            }
            call = sprintf("cast<%s>(a.objects.%s).%s(%s);", cname, m.cls, m.name, call_args.join(", "));
        }
        try {
            return TenantProcessWideStateTest::tenant("tenant-a", decls.join(" ") + " " + call + " return \"ran\";")
                .callFunction("t", args());
        } catch (hash<ExceptionInfo> ex) {
            return sprintf("%s: %s", ex.err, ex.desc);
        }
    }

    #! Returns the source of an argument of the given type, with any variable it needs added to \a decls
    static *string getArg(string t, reference<list<string>> decls, int n) {
        t = regex_subst(t, "(::)?([A-Za-z0-9_]+::)+", "", RE_Global);
        if (t =~ /^reference/) {
            *string inner = (t =~ x/^reference<(.*)>$/)[0];
            string v = sprintf("r%d", n);
            if (!inner) {
                decls += sprintf("auto %s;", v);
            } else {
                *string init = TenantProcessWideStateTest::getArg(inner, \decls, n + 100);
                if (!exists init) {
                    return;
                }
                decls += sprintf("%s %s = %s;", inner, v, init);
            }
            return "\\" + v;
        }
        if (t =~ /^\*/) {
            return "NOTHING";
        }
        switch (t) {
            case "auto":
            case "any": return "NOTHING";
            case "string":
            case "softstring":
            case "data": return "\"qore-test-7185\"";
            case "int":
            case "softint": return "1";
            case "bool":
            case "softbool": return "False";
            case "date": return "7s";
            case "timeout": return "1";
            case "float": return "0.0";
            case "list":
            case "list<auto>":
            case "list<string>":
            case "softlist<auto>": return "()";
            case "code": return "sub () {}";
            case "object": return "new Mutex()";
            case "hash<AsyncCallInfo>":
                return "<AsyncCallInfo>{\"app\": \"x\", \"type\": \"t\", \"label\": \"l\", "
                    "\"async_call\": sub () {}}";
            case "hash<ExceptionInfo>": return "<ExceptionInfo>{\"err\": \"X\", \"desc\": \"x\"}";
            case "hash<TsTenantContext>": return "<TsTenantContext>{\"tenant\": \"qore-test-7185\"}";
            case "hash<TsTenantLimits>": return "<TsTenantLimits>{}";
            case "hash<NameDescInfo>": return "<NameDescInfo>{\"name\": \"x\", \"desc\": \"x\"}";
            case "hash<AppInfo>": return "a.appinfo";
            case "hash<DataProviderAppInfo>": return "a.app";
            case "hash<InProcessProgramInfo>":
                return "<InProcessProgramInfo>{\"pgm\": a.objects.JavaScriptProgram, \"call_map\": {}, "
                    "\"id\": \"x\"}";
            case "object<Mutex>": return "new Mutex()";
            case "object<LoggerInterface>": return "new Logger()";
            case "object<LoggerLevel>": return "Logger::LoggerLevel::getLevelInfo()";
            case "object<Socket>": return "new Socket()";
            case "object<HashDataType>":
            case "object<AbstractDataProviderType>": return "new HashDataType()";
            case "object<Observable>": return "new Observable()";
            case "object<RestConnection>":
            case "object<AbstractConnection>": return "a.objects.TypeScriptAppRestConnection";
            case "object<ActionFunctionContext>": return "a.objects.TypeScriptActionDataProviderBase";
        }
        if (t =~ /^hash(<auto>)?$/ || t =~ /^hash<string, /) {
            return "{}";
        }
        if (t =~ /^code</) {
            return "sub () {}";
        }
        if (*string cls = (t =~ x/^object<(.*)>$/)[0]) {
            return sprintf("a.objects.%s", cls);
        }
    }

    schemaProviderTest() {
        # the host's provider and the app's schema are shared: a tenant cannot get either, so its settings and changes
        # cannot reach the host's (a provider of its own would give out the shared schema with getSchema())
        RestSchemaDataProvider host = TypeScriptActionInterface::getSchemaDataProvider(schema_app);
        assertTrue(host == TypeScriptActionInterface::getSchemaDataProvider(schema_app));
        hash<auto> results = {};
        foreach string name in ("tenant-a", "tenant-b") {
            results{name} = TenantProcessWideStateTest::tenant(name, "RestSchemaDataProvider p = "
                "TypeScriptActionInterface::getSchemaDataProvider(\"" + schema_app + "\"); "
                "p.setRestClient(new RestClient({\"url\": \"https://tenant.example.com\"}, True)); "
                "return sprintf(\"%y\", p.getSchema().typeCode());",
                NOTHING, "%requires RestSchemaDataProvider\n%requires RestClient\n").callFunction("t", args());
        }
        assertEq({"tenant-a": "SANDBOX-REGISTRATION-ERROR", "tenant-b": "SANDBOX-REGISTRATION-ERROR"}, results);
        assertEq(("items",), host.getChildProviderNames());
        assertNothing(host.tryGetRestClient(), "the host's provider has no REST client");
    }

    initOnceTest() {
        # with the in-process server enabled on demand by the DataProvider options and then disabled by the host, a
        # tenant cannot initialize the module, and a further initialization by trusted code does not enable it again
        int old_opts = DataProvider::getOptions();
        on_exit {
            DataProvider::setOptions(old_opts);
            TypeScriptActionInterface::disableInProcessServerOnDemand();
            TypeScriptActionInterface::setInProcessServer(host_ip);
        }
        DataProvider::setOptions(old_opts | DPO_EnableInProcessServers);
        TypeScriptActionInterface::disableInProcessServerOnDemand();
        # no server, so that one would be started on demand
        TypeScriptActionInterface::shutdownInProcessServer();
        assertNothing(TypeScriptActionInterface::checkInProcessServer());

        assertEq("SANDBOX-REGISTRATION-ERROR", TenantProcessWideStateTest::tenant("tenant-a",
            "TypeScriptActionInterface::init(); return \"ran\";").callFunction("t", args()));
        TypeScriptActionInterface::init();
        assertNothing(TypeScriptActionInterface::checkInProcessServer(), "the server is not started on demand");
    }

    #! Returns True if the program of the host's catalogue is mapped to its pool
    private bool catalogueMapped() {
        try {
            bool first;
            return JavaScriptProgramPool::getPool(catalogue_pool.getProgram(), \first) == catalogue_pool;
        } catch (hash<ExceptionInfo> ex) {
            return False;
        }
    }

    #! Returns the argument hash of the cases
    private hash<auto> args() {
        return {"pool": pool, "ip": tenant_ip, "host_ip": host_ip,
            "catalogue_id": catalogue_pool.uniqueHash(), "record_prov": record_prov,
            "program": catalogue_pool.getProgram(), "jsobj": catalogue_pool.getProgram().getGlobal(),
            "conn": host_conn,
            "appinfo": TypeScriptActionInterface::getInitializedRecordBasedAppInfo(CatalogueRecordApp),
            "app": DataProviderActionCatalog::getAppEx(CatalogueApp), "objects": objects};
    }

    #! Returns the source of a Program whose \c run() function runs the given case and returns its result or error
    static string runSource(string body, *string modules) {
        return Modules + (modules ?? "") + "%requires Logger\n" + "string sub run_intern(hash<auto> a) { " + body
            + " }\n"
            "string sub run(hash<auto> a) { try { return run_intern(a); } catch (hash<ExceptionInfo> ex) { "
            "return ex.err; } }\n";
    }

    #! Returns a tenant with a sandbox of its own whose \c t() function runs the given case
    private static Program tenant(string name, string body, *bool bg, *string modules) {
        string src = bg
            ? "string sub t(hash<auto> a) { Queue q(); background q.push(run(a)); return q.get(); }\n"
            : "string sub t(hash<auto> a) { return run(a); }\n";
        return TenantProcessWideStateTest::program(name, runSource(body, modules) + src);
    }

    #! Returns a Program with a sandbox of its own
    private static Program program(string name, string src, *bool add_modules) {
        Program p(PO_NEW_STYLE | PO_NO_CHILD_PO_RESTRICTIONS);
        p.parse((add_modules ? Modules : "") + src, name);
        p.setSandboxManager(new SandboxManager());
        return p;
    }

    #! Returns a trusted Program that runs the given case in \c run() and gives it under a policy barrier in \c cap()
    private static Program trusted(string body) {
        Program p(PO_NEW_STYLE | PO_NO_CHILD_PO_RESTRICTIONS);
        p.parse(runSource(body) + "code sub cap(hash<auto> a) { return SandboxManager::createSystemPolicyCall("
            "string sub () { return run(a); }); }\n", "trusted");
        return p;
    }
}
