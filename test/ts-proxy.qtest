#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires QUnit
%requires ../qlib/TypeScriptActionInterface
%requires v8

%exec-class TsProxyTest

public class TsProxyTest inherits QUnit::Test {
    private {
        Logger logger;
        bool env_ready = False;
        string skip_reason;
    }

    constructor() : Test("TsProxyTest", "1.0") {
        setupLogger();
        checkEnvironment();

        addTestCase("proxy tests", \proxyTests());
        addTestCase("proxy command socket close mid-command", \proxySocketCloseMidCommandTest());
        addTestCase("proxy bounded restart on persistent socket close", \proxyBoundedRestartTest());
        addTestCase("proxy restart error handling", \proxyRestartErrorHandlingTest());
        addTestCase("proxy restart wait fast paths", \proxyRestartWaitFastPathTest());
        addTestCase("proxy send error handling", \proxySendErrorHandlingTest());
        addTestCase("proxy startup send error handling", \proxyStartupSendErrorHandlingTest());

        set_return_value(main());
    }

    private setupLogger() {
        LoggerLevel level;
        if (m_options.verbose > 3) {
            level = LoggerLevel::getLevelDebug();
        } else if (m_options.verbose > 2) {
            level = LoggerLevel::getLevelInfo();
        } else {
            level = LoggerLevel::getLevelFatal();
        }
        logger = new Logger("console", level);
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        } else {
            logger.addAppender(new LoggerAppenderNull());
        }
        DataProvider::setGlobalLogger(logger);
    }

    private checkEnvironment() {
        string local_bin = sprintf("%s/../bin", get_script_dir());
        if (!hstat(local_bin)) {
            skip_reason = sprintf("Local bin directory missing: %s", local_bin);
            return;
        }
        setenv("PATH", local_bin + ":" + ENV.PATH);

        # Check if ts-proxy binary is available
        try {
            string path = trim(`which ts-proxy 2>/dev/null`);
            if (!path.val()) {
                skip_reason = "ts-proxy binary not found in PATH; ensure module-v8/bin is in PATH";
                return;
            }
        } catch (hash<ExceptionInfo> ex) {
            skip_reason = sprintf("Cannot locate ts-proxy: %s", ex.desc);
            return;
        }

        # Check if we can create UNIX sockets in tmp
        try {
            string test_path = sprintf("%s/ts-proxy-test-%d.sock", tmp_location(), getpid());
            Socket s();
            s.bindUNIX(test_path);
            s.close();
            unlink(test_path);
        } catch (hash<ExceptionInfo> ex) {
            skip_reason = sprintf("Cannot create UNIX sockets in tmp: %s", ex.desc);
            return;
        }

        env_ready = True;
    }

    private skipIfNotReady() {
        if (!env_ready) {
            testSkip(skip_reason);
        }
    }

    # All proxy tests run in a single test case to share the proxy infrastructure
    private proxyTests() {
        skipIfNotReady();

        # Initialize the proxy pool once for all tests
        JavaScriptProgramProxy::init(new Mutex());
        on_exit JavaScriptProgramProxy::shutdown();

        JavaScriptProgramProxy proxy1();
        JavaScriptProgramProxy proxy2();

        # Test 1: Proxy lifecycle
        {

            # Verify the proxy has valid info
            hash<auto> info = proxy1.getInfo();
            assertTrue(info."proxy-pid" > 0, "proxy should have a valid PID");

            # Verify we can get the unique hash
            string uh = proxy1.uniqueHash();
            assertTrue(uh.val(), "proxy should have a unique hash");

            if (m_options.verbose > 1) {
                printf("Proxy lifecycle test passed - PID: %d\n", info."proxy-pid");
            }
        }

        # Test 2: Multiple proxies can be created
        {
            hash<auto> info1 = proxy1.getInfo();
            hash<auto> info2 = proxy2.getInfo();

            assertTrue(info1."proxy-pid" > 0, "proxy1 should be running");
            assertTrue(info2."proxy-pid" > 0, "proxy2 should be running");
            assertTrue(info1."proxy-pid" != info2."proxy-pid", "proxies should have different PIDs");

            if (m_options.verbose > 1) {
                printf("Multiple proxy test passed - PIDs: %d, %d\n", info1."proxy-pid", info2."proxy-pid");
            }
        }

        # Test 3: Proxy restart after child kill
        {
            hash<auto> info = proxy1.getInfo();
            int original_pid = info."proxy-pid";
            assertTrue(original_pid > 0, "proxy should have original PID");

            # Kill the child process to trigger restart logic
            try {
                system(sprintf("kill -9 %d 2>/dev/null", original_pid));
                usleep(100ms);
            } catch (hash<ExceptionInfo> ex) {
                # Ignore - process may already be gone
            }

            # The restart happens lazily on next command
            # We just verify the proxy object is still valid
            assertTrue(proxy1.uniqueHash().val(), "proxy should still have valid hash after child kill");

            if (m_options.verbose > 1) {
                printf("Proxy restart test passed - original PID: %d\n", original_pid);
            }
        }
    }

    private proxySocketCloseMidCommandTest() {
        skipIfNotReady();

        bool debug_enabled = False;
        @debug {
            debug_enabled = True;
        }
        if (!debug_enabled) {
            testSkip("socket-close hook requires running with debugging enabled");
            return;
        }

        JavaScriptProgramProxy::init(new Mutex());
        on_exit JavaScriptProgramProxy::shutdown();

        JavaScriptProgramProxy proxy();
        int pid = proxy.getInfo()."proxy-pid";
        assertTrue(pid > 0, "proxy should be running for socket-close test");

        # The hook closes the command IPC socket during waitForResponse while the child process is
        # still alive, producing SOCKET-NOT-OPEN with proc.running() == True - exactly the
        # align-products CI race. With the fix the proxy restarts the child and retries the command,
        # so the call must NOT surface a fatal socket error and the child must have been restarted.
        setenv("TS_PROXY_TEST_FORCE_SOCKET_CLOSE", "1");
        on_exit unsetenv("TS_PROXY_TEST_FORCE_SOCKET_CLOSE");

        *string sock_err;
        try {
            proxy.getDynamicOptions("no-such-app", "no-such-action", NOTHING, NOTHING, NOTHING);
        } catch (hash<ExceptionInfo> ex) {
            # an app-not-found (or similar) error is acceptable; a socket-closed error is the regression
            if (ex.err == "SOCKET-NOT-OPEN" || ex.err == "SOCKET-CLOSED") {
                sock_err = ex.err;
            }
        }
        assertTrue(!sock_err.val(),
            "a command socket close mid-command must be recovered, not surfaced as a fatal socket error");
        assertTrue(proxy.getInfo()."proxy-pid" != pid,
            "child must be restarted after the command socket was closed");
    }

    private proxyBoundedRestartTest() {
        skipIfNotReady();

        bool debug_enabled = False;
        @debug {
            debug_enabled = True;
        }
        if (!debug_enabled) {
            testSkip("persistent socket-close hook requires running with debugging enabled");
            return;
        }

        # this value must match RetryCounter::MaxRestarts in JavaScriptProgramProxy.qc (internal class)
        int expected_max_restarts = 3;

        JavaScriptProgramProxy::init(new Mutex());
        on_exit JavaScriptProgramProxy::shutdown();

        JavaScriptProgramProxy proxy();
        int pid = proxy.getInfo()."proxy-pid";
        assertTrue(pid > 0, "proxy should be running for bounded-restart test");
        assertEq(0, proxy.getInfo()."restart-count", "the child must not have been restarted before the test");

        # Force the command IPC socket closed on EVERY command attempt while the child process
        # stays alive (SOCKET-NOT-OPEN with proc.running() == True). This reproduces a command
        # that deterministically breaks the command channel (e.g. the webhook_register lazy-init
        # loop). Without the bound the proxy respawns the child forever at 100% CPU; with the fix
        # the command must give up after RetryCounter::MaxRestarts restarts.
        setenv("TS_PROXY_TEST_FORCE_SOCKET_CLOSE_ALWAYS", "1");
        on_exit unsetenv("TS_PROXY_TEST_FORCE_SOCKET_CLOSE_ALWAYS");

        *string sock_err;
        try {
            proxy.getDynamicOptions("no-such-app", "no-such-action", NOTHING, NOTHING, NOTHING);
        } catch (hash<ExceptionInfo> ex) {
            sock_err = ex.err;
        }

        # the command must terminate with a socket error instead of looping forever
        assertTrue(sock_err == "SOCKET-NOT-OPEN" || sock_err == "SOCKET-CLOSED",
            "a command that always breaks the command channel must give up with a socket error, not loop forever");
        # the number of child restarts must be bounded and deterministic (no timing/polling)
        assertEq(expected_max_restarts, proxy.getInfo()."restart-count",
            "the child must be restarted exactly MaxRestarts times before the command gives up");
    }

    private proxyRestartErrorHandlingTest() {
        skipIfNotReady();

        JavaScriptProgramProxy::init(new Mutex());
        on_exit JavaScriptProgramProxy::shutdown();

        JavaScriptProgramProxy proxy();
        int pid = proxy.getInfo()."proxy-pid";
        assertTrue(pid > 0, "proxy should be running for restart test");

        setenv("TS_PROXY_TEST_FORCE_RESTART_ERROR", "1");
        on_exit unsetenv("TS_PROXY_TEST_FORCE_RESTART_ERROR");
        setenv("TS_PROXY_TEST_RESPONSE_TIMEOUT_MS", "1500");
        on_exit unsetenv("TS_PROXY_TEST_RESPONSE_TIMEOUT_MS");

        try {
            system(sprintf("kill -9 %d 2>/dev/null", pid));
        } catch (hash<ExceptionInfo> ex) {
            # ignore
        }

        bool threw = False;
        try {
            proxy.getDynamicOptions("no-such-app", "no-such-action", NOTHING, NOTHING, NOTHING);
        } catch (hash<ExceptionInfo> ex) {
            threw = True;
        }
        assertTrue(threw, "restart error should propagate");

        unsetenv("TS_PROXY_TEST_FORCE_RESTART_ERROR");

        Mutex m();
        Condition cond();
        bool done = False;
        background sub () {
            try {
                proxy.getDynamicOptions("no-such-app", "no-such-action", NOTHING, NOTHING, NOTHING);
            } catch (hash<ExceptionInfo> ex) {
                # ignore
            }
            m.lock();
            on_exit m.unlock();
            done = True;
            cond.broadcast();
        }();

        m.lock();
        on_exit m.unlock();
        date start = now_us();
        while (!done) {
            if (!cond.wait(m, 200ms)) {
                break;
            }
            if (now_us() - start > 2s) {
                break;
            }
        }
        assertTrue(done, "restart retry should not deadlock");
    }

    private proxySendErrorHandlingTest() {
        skipIfNotReady();

        JavaScriptProgramProxy::init(new Mutex());
        on_exit JavaScriptProgramProxy::shutdown();

        setenv("TS_PROXY_TEST_FORCE_SEND_ERROR", "1");
        ENV.TS_PROXY_TEST_FORCE_SEND_ERROR = "1";
        on_exit unsetenv("TS_PROXY_TEST_FORCE_SEND_ERROR");
        on_exit remove ENV.TS_PROXY_TEST_FORCE_SEND_ERROR;
        setenv("TS_PROXY_TEST_RESPONSE_TIMEOUT_MS", "1500");
        on_exit unsetenv("TS_PROXY_TEST_RESPONSE_TIMEOUT_MS");

        JavaScriptProgramProxy proxy();
        int pid = proxy.getInfo()."proxy-pid";
        assertTrue(pid > 0, "proxy should be running for send error test");

        Mutex m();
        Condition cond();
        bool done = False;
        background sub () {
            try {
                proxy.getDynamicOptions("no-such-app", "no-such-action", NOTHING, NOTHING, NOTHING);
            } catch (hash<ExceptionInfo> ex) {
                # ignore
            }
            m.lock();
            on_exit m.unlock();
            done = True;
            cond.broadcast();
        }();

        m.lock();
        on_exit m.unlock();
        date start = now_us();
        while (!done) {
            if (!cond.wait(m, 200ms)) {
                break;
            }
            if (now_us() - start > 2s) {
                break;
            }
        }
        assertTrue(done, "send error should not deadlock");

        unsetenv("TS_PROXY_TEST_FORCE_SEND_ERROR");
        remove ENV.TS_PROXY_TEST_FORCE_SEND_ERROR;
        bool threw = False;
        try {
            proxy.getDynamicOptions("no-such-app", "no-such-action", NOTHING, NOTHING, NOTHING);
        } catch (hash<ExceptionInfo> ex) {
            threw = True;
        }
        assertTrue(threw, "send error should not break subsequent calls");
    }

    private proxyRestartWaitFastPathTest() {
        skipIfNotReady();

        bool debug_enabled = False;
        @debug {
            debug_enabled = True;
        }
        if (!debug_enabled) {
            testSkip("restart wait fast-path hook requires running with debugging enabled");
            return;
        }

        JavaScriptProgramProxy::init(new Mutex());
        on_exit JavaScriptProgramProxy::shutdown();

        JavaScriptProgramProxy proxy();
        setenv("TS_PROXY_TEST_RESTART_WAIT_FAST_PATHS", "1");
        on_exit unsetenv("TS_PROXY_TEST_RESTART_WAIT_FAST_PATHS");
        hash<auto> rv = proxy.getInfo();

        assertEq(0, rv."test-no-restart-retry",
            "a no-restart command must not wait or retry while a restart is already active");
        assertEq(0, rv."test-owner-retry",
            "the restart owner must not wait on its own restart state after a nested restart-path error");
    }

    private proxyStartupSendErrorHandlingTest() {
        skipIfNotReady();

        bool debug_enabled = False;
        @debug {
            debug_enabled = True;
        }
        if (!debug_enabled) {
            testSkip("startup send error hook requires running with debugging enabled");
            return;
        }

        JavaScriptProgramProxy::init(new Mutex());
        on_exit JavaScriptProgramProxy::shutdown();

        setenv("TS_PROXY_TEST_FORCE_SEND_ERROR_STARTUP", "1");
        ENV.TS_PROXY_TEST_FORCE_SEND_ERROR_STARTUP = "1";
        on_exit unsetenv("TS_PROXY_TEST_FORCE_SEND_ERROR_STARTUP");
        on_exit remove ENV.TS_PROXY_TEST_FORCE_SEND_ERROR_STARTUP;
        setenv("TS_PROXY_TEST_STARTUP_TIMEOUT_MS", "1500");
        on_exit unsetenv("TS_PROXY_TEST_STARTUP_TIMEOUT_MS");

        bool threw = False;
        try {
            JavaScriptProgramProxy proxy();
        } catch (hash<ExceptionInfo> ex) {
            threw = True;
        }
        assertTrue(threw, "startup send error should raise");
    }
}
