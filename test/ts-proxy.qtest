#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"

%requires QUnit
%requires FsUtil
%try-module process
%define MISSING_EXTERNAL_MODULE
%endtry
%try-module uuid
%define MISSING_EXTERNAL_MODULE
%endtry
%try-module json
%define MISSING_EXTERNAL_MODULE
%endtry
%ifndef MISSING_EXTERNAL_MODULE
%requires TypeScriptActionInterface
%endif
%requires v8

%exec-class TsProxyTest

%ifndef MISSING_EXTERNAL_MODULE

public class TsProxyTest inherits QUnit::Test {
    public {
        #! Safety ceiling for waiting on a proxy operation that must return
        /** Only a deadlock guard: the waits end when the operation returns.  It is never a measure of how long a
            correct proxy takes, because a cold child respawn takes seconds on an idle host and far longer on a
            loaded one.
        */
        const HangGuard = 10m;

        #! the environment variable that sets the time the parent waits for a command's response
        const ResponseTimeoutVar = "TS_PROXY_TEST_RESPONSE_TIMEOUT_MS";
    }

    private {
        Logger logger;
        bool env_ready = False;
        string skip_reason;
    }

    constructor() : Test("TsProxyTest", "1.0") {
        setupLogger();
        checkEnvironment();
        # Every case starts at least one child and sends it commands, and a child that starts or answers slowly is
        # not a failure; the proxy's default startup (60s) and response (90s) timeouts are production policies
        # that a loaded test host can exceed.  The startup and call timeout cases set short limits of their own
        JavaScriptProgramProxy::setStartupTimeout(HangGuard);
        setenv(ResponseTimeoutVar, string(get_duration_milliseconds(HangGuard)));

        addTestCase("proxy tests", \proxyTests());
        addTestCase("proxy restarts after child exit", \proxyUnexpectedExitTest());
        addTestCase("a child that ends after reading a command is restarted when it has ended", sub () {
            proxyChildEndingTest("read");
        });
        addTestCase("a child that ends before reading a command is restarted when it has ended", sub () {
            proxyChildEndingTest("unread");
        });
        addTestCase("proxy command socket close mid-command", \proxySocketCloseMidCommandTest());
        addTestCase("proxy bounded restart on persistent socket close", \proxyBoundedRestartTest());
        addTestCase("proxy parent send error mid-command", \proxyParentSendErrorMidCommandTest());
        addTestCase("proxy parent send error bounded restart", \proxyParentSendErrorBoundedRestartTest());
        addTestCase("proxy restart error handling", \proxyRestartErrorHandlingTest());
        addTestCase("proxy restart wait fast paths", \proxyRestartWaitFastPathTest());
        addTestCase("proxy send error handling", \proxySendErrorHandlingTest());
        addTestCase("proxy startup send error handling", \proxyStartupSendErrorHandlingTest());
        addTestCase("a child that never starts fails at the startup timeout", \proxyStartupTimeoutTest());
        addTestCase("a call that never answers fails at the call time limit", \proxyCallTimeoutTest());
        addTestCase("a child gets the environment as it is when the child starts", \proxyEnvironmentTest());

        set_return_value(main());
    }

    private setupLogger() {
        LoggerLevel level;
        if (m_options.verbose > 3) {
            level = LoggerLevel::getLevelDebug();
        } else if (m_options.verbose > 2) {
            level = LoggerLevel::getLevelInfo();
        } else {
            level = LoggerLevel::getLevelFatal();
        }
        logger = new Logger("console", level);
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        } else {
            logger.addAppender(new LoggerAppenderNull());
        }
        DataProvider::setGlobalLogger(logger);
    }

    private checkEnvironment() {
        string local_bin = sprintf("%s/../bin", get_script_dir());
        if (hstat(local_bin)) {
            setenv("PATH", local_bin + ":" + ENV.PATH);
        }

        # Check if ts-proxy binary is available
        try {
            string path = trim(`which ts-proxy 2>/dev/null`);
            if (!path.val()) {
                skip_reason = "ts-proxy binary not found in PATH; ensure module-v8/bin is in PATH";
                return;
            }
        } catch (hash<ExceptionInfo> ex) {
            skip_reason = sprintf("Cannot locate ts-proxy: %s", ex.desc);
            return;
        }

        # Check if we can create UNIX sockets in tmp
        try {
            string test_path = sprintf("%s/ts-proxy-test-%d.sock", tmp_location(), getpid());
            Socket s();
            s.bindUNIX(test_path);
            s.close();
            unlink(test_path);
        } catch (hash<ExceptionInfo> ex) {
            skip_reason = sprintf("Cannot create UNIX sockets in tmp: %s", ex.desc);
            return;
        }

        env_ready = True;
    }

    private skipIfNotReady() {
        if (!env_ready) {
            testSkip(skip_reason);
        }
    }

    #! Runs the call in a background thread and waits for it to return; returns the exception it raised, if any
    /** The wait ends when the call returns; @ref HangGuard only turns a deadlock into a test failure instead of a
        test that never ends

        @param call the call to make
        @param what a description of the call for the failure message
    */
    private *hash<ExceptionInfo> callGuarded(code<nothing()> call, string what) {
        Mutex m();
        Condition cond();
        bool done = False;
        *hash<ExceptionInfo> err;
        background sub () {
            try {
                call();
            } catch (hash<ExceptionInfo> ex) {
                err = ex;
            }
            m.lock();
            on_exit m.unlock();
            done = True;
            cond.broadcast();
        }();

        m.lock();
        on_exit m.unlock();
        date deadline = now_us() + HangGuard;
        while (!done) {
            date remaining = deadline - now_us();
            # a non-zero return value means that the wait timed out
            if (remaining <= 0s || cond.wait(m, remaining)) {
                break;
            }
        }
        assertTrue(done, sprintf("%s must return; it did not return within %y", what, HangGuard));
        return err;
    }

    #! Sets an environment variable and returns a closure that restores its previous value
    private code<nothing()> setenvScoped(string var, string value) {
        *string old = getenv(var);
        setenv(var, value);
        return sub () {
            if (exists old) {
                setenv(var, old);
            } else {
                unsetenv(var);
            }
        };
    }

    # Fault-injection hooks are removed when the release qmod is compiled.
    # --enable-debug only enables hooks in source parsed by the current process.
    private skipIfDebugHooksUnavailable() {
        if (get_module_hash().TypeScriptActionInterface.filename.endsWith(".qmod")) {
            testSkip("fault injection requires TypeScriptActionInterface source with --enable-debug");
        }
    }

    private proxyUnexpectedExitTest() {
        skipIfNotReady();
        JavaScriptProgramProxy::init(new Mutex());
        on_exit JavaScriptProgramProxy::shutdown();
        JavaScriptProgramProxy proxy();
        int pid = proxy.getInfo()."proxy-pid";
        assertTrue(pid > 0);
        assertEq(0, system(sprintf("kill -9 %d", pid)));
        assertThrows("APP-ERROR", \proxy.getDynamicOptions(),
            ("no-such-app", "no-such-action", NOTHING, NOTHING, NOTHING));
        assertTrue(proxy.getInfo()."proxy-pid" != pid,
            "the release proxy must restart a terminated child before retrying the command");
        assertEq(1, proxy.getInfo()."restart-count");
    }

    #! A child whose command socket is closed before any reply is restarted when it has ended, and the command retried
    /** A child ends with its command socket, and the parent sees the end of the socket before the child has been
        reaped: Process::running() could still report the child, so the proxy raised the socket error
        (SOCKET-CLOSED, or SOCKET-RECV-ERROR with ECONNRESET on Linux) instead of restarting it.  The race is made
        deterministic with the TS_PROXY_TEST_CLOSE_COMMAND_SOCKET hooks: the child closes its command socket after
        reading the next command (\a mode \c "read") or when it has arrived (\c "unread"), and stays running until
        the parent, waiting for the child to end, releases it through a FIFO.  The command must then be retried by a
        new child, which reports that the app does not exist.

        @param mode \c "read" or \c "unread", see above
    */
    private proxyChildEndingTest(string mode) {
        skipIfNotReady();
        skipIfDebugHooksUnavailable();
        bool debug_enabled = False;
        @debug {
            debug_enabled = True;
        }
        if (!debug_enabled) {
            testSkip("the child socket-close hook requires running with debugging enabled");
        }

        string release = sprintf("%s/ts-proxy-test-release-%d-%s", tmp_location(), getpid(), mode);
        if (mkfifo(release)) {
            throw "TEST-ERROR", sprintf("%s: %s", release, strerror());
        }
        on_exit unlink(release);
        code restore_release = setenvScoped("TS_PROXY_TEST_CLOSE_COMMAND_SOCKET_RELEASE", release);
        on_exit restore_release();

        JavaScriptProgramProxy::init(new Mutex());
        on_exit JavaScriptProgramProxy::shutdown();
        JavaScriptProgramProxy proxy;
        {
            # only the first child gets the hook: the restarted child answers the retried command
            code restore_mode = setenvScoped("TS_PROXY_TEST_CLOSE_COMMAND_SOCKET", mode);
            on_exit restore_mode();
            proxy = new JavaScriptProgramProxy();
        }
        int pid = proxy.getInfo()."proxy-pid";
        assertTrue(pid > 0);

        *hash<ExceptionInfo> err = callGuarded(sub () {
            proxy.getDynamicOptions("no-such-app", "no-such-action", NOTHING, NOTHING, NOTHING);
        }, "the command");
        assertEq("APP-ERROR", err.err, "the command is retried by a new child: " + get_exception_string(err));
        assertTrue(proxy.getInfo()."proxy-pid" != pid, "the child that ended has been replaced");
        assertEq(1, proxy.getInfo()."restart-count");
    }

    # All proxy tests run in a single test case to share the proxy infrastructure
    private proxyTests() {
        skipIfNotReady();

        # Initialize the proxy pool once for all tests
        JavaScriptProgramProxy::init(new Mutex());
        on_exit JavaScriptProgramProxy::shutdown();

        JavaScriptProgramProxy proxy1();
        JavaScriptProgramProxy proxy2();

        # Test 1: Proxy lifecycle
        {

            # Verify the proxy has valid info
            hash<auto> info = proxy1.getInfo();
            assertTrue(info."proxy-pid" > 0, "proxy should have a valid PID");

            # Verify we can get the unique hash
            string uh = proxy1.uniqueHash();
            assertTrue(uh.val(), "proxy should have a unique hash");

            if (m_options.verbose > 1) {
                printf("Proxy lifecycle test passed - PID: %d\n", info."proxy-pid");
            }
        }

        # Test 2: Multiple proxies can be created
        {
            hash<auto> info1 = proxy1.getInfo();
            hash<auto> info2 = proxy2.getInfo();

            assertTrue(info1."proxy-pid" > 0, "proxy1 should be running");
            assertTrue(info2."proxy-pid" > 0, "proxy2 should be running");
            assertTrue(info1."proxy-pid" != info2."proxy-pid", "proxies should have different PIDs");

            if (m_options.verbose > 1) {
                printf("Multiple proxy test passed - PIDs: %d, %d\n", info1."proxy-pid", info2."proxy-pid");
            }
        }

        # Test 3: Proxy restart after child kill
        {
            hash<auto> info = proxy1.getInfo();
            int original_pid = info."proxy-pid";
            assertTrue(original_pid > 0, "proxy should have original PID");

            # Kill the child process to trigger restart logic
            try {
                system(sprintf("kill -9 %d 2>/dev/null", original_pid));
            } catch (hash<ExceptionInfo> ex) {
                # Ignore - process may already be gone
            }

            # The restart happens lazily on next command
            # We just verify the proxy object is still valid; its unique hash does not depend on the child, so
            # there is nothing to wait for
            assertTrue(proxy1.uniqueHash().val(), "proxy should still have valid hash after child kill");

            if (m_options.verbose > 1) {
                printf("Proxy restart test passed - original PID: %d\n", original_pid);
            }
        }
    }

    private proxySocketCloseMidCommandTest() {
        skipIfNotReady();
        skipIfDebugHooksUnavailable();

        bool debug_enabled = False;
        @debug {
            debug_enabled = True;
        }
        if (!debug_enabled) {
            testSkip("socket-close hook requires running with debugging enabled");
            return;
        }

        JavaScriptProgramProxy::init(new Mutex());
        on_exit JavaScriptProgramProxy::shutdown();

        JavaScriptProgramProxy proxy();
        int pid = proxy.getInfo()."proxy-pid";
        assertTrue(pid > 0, "proxy should be running for socket-close test");

        # The hook closes the command IPC socket during waitForResponse while the child process is
        # still alive, producing SOCKET-NOT-OPEN with proc.running() == True - exactly the
        # align-products CI race. With the fix the proxy restarts the child and retries the command,
        # so the call must NOT surface a fatal socket error and the child must have been restarted.
        setenv("TS_PROXY_TEST_FORCE_SOCKET_CLOSE", "1");
        on_exit unsetenv("TS_PROXY_TEST_FORCE_SOCKET_CLOSE");

        *string sock_err;
        try {
            proxy.getDynamicOptions("no-such-app", "no-such-action", NOTHING, NOTHING, NOTHING);
        } catch (hash<ExceptionInfo> ex) {
            # an app-not-found (or similar) error is acceptable; a socket-closed error is the regression
            if (ex.err == "SOCKET-NOT-OPEN" || ex.err == "SOCKET-CLOSED") {
                sock_err = ex.err;
            }
        }
        assertTrue(!sock_err.val(),
            "a command socket close mid-command must be recovered, not surfaced as a fatal socket error");
        assertTrue(proxy.getInfo()."proxy-pid" != pid,
            "child must be restarted after the command socket was closed");
    }

    private proxyBoundedRestartTest() {
        skipIfNotReady();
        skipIfDebugHooksUnavailable();

        bool debug_enabled = False;
        @debug {
            debug_enabled = True;
        }
        if (!debug_enabled) {
            testSkip("persistent socket-close hook requires running with debugging enabled");
            return;
        }

        # this value must match RetryCounter::MaxRestarts in JavaScriptProgramProxy.qc (internal class)
        int expected_max_restarts = 3;

        JavaScriptProgramProxy::init(new Mutex());
        on_exit JavaScriptProgramProxy::shutdown();

        JavaScriptProgramProxy proxy();
        int pid = proxy.getInfo()."proxy-pid";
        assertTrue(pid > 0, "proxy should be running for bounded-restart test");
        assertEq(0, proxy.getInfo()."restart-count", "the child must not have been restarted before the test");

        # Force the command IPC socket closed on EVERY command attempt while the child process
        # stays alive (SOCKET-NOT-OPEN with proc.running() == True). This reproduces a command
        # that deterministically breaks the command channel (e.g. the webhook_register lazy-init
        # loop). Without the bound the proxy respawns the child forever at 100% CPU; with the fix
        # the command must give up after RetryCounter::MaxRestarts restarts.
        setenv("TS_PROXY_TEST_FORCE_SOCKET_CLOSE_ALWAYS", "1");
        on_exit unsetenv("TS_PROXY_TEST_FORCE_SOCKET_CLOSE_ALWAYS");

        *string sock_err;
        try {
            proxy.getDynamicOptions("no-such-app", "no-such-action", NOTHING, NOTHING, NOTHING);
        } catch (hash<ExceptionInfo> ex) {
            sock_err = ex.err;
        }

        # the command must terminate with a socket error instead of looping forever
        assertTrue(sock_err == "SOCKET-NOT-OPEN" || sock_err == "SOCKET-CLOSED",
            "a command that always breaks the command channel must give up with a socket error, not loop forever");
        # the number of child restarts must be bounded and deterministic (no timing/polling)
        assertEq(expected_max_restarts, proxy.getInfo()."restart-count",
            "the child must be restarted exactly MaxRestarts times before the command gives up");
    }

    private proxyParentSendErrorMidCommandTest() {
        skipIfNotReady();
        skipIfDebugHooksUnavailable();

        bool debug_enabled = False;
        @debug {
            debug_enabled = True;
        }
        if (!debug_enabled) {
            testSkip("parent-send-error hook requires running with debugging enabled");
            return;
        }

        JavaScriptProgramProxy::init(new Mutex());
        on_exit JavaScriptProgramProxy::shutdown();

        JavaScriptProgramProxy proxy();
        int pid = proxy.getInfo()."proxy-pid";
        assertTrue(pid > 0, "proxy should be running for parent-send-error test");

        # The hook makes the parent's command send raise the real Qore Socket::send() EPIPE shape
        # (SOCKET-SEND-ERROR / "Broken pipe") once - the send-side sibling of the SOCKET-NOT-OPEN
        # race, which the recv-side hook (proxySocketCloseMidCommandTest) cannot reach. With the fix
        # the proxy treats it as a dead command channel, restarts the child, and retries the command,
        # so the call must NOT surface a fatal socket error and the child must have been restarted.
        setenv("TS_PROXY_TEST_FORCE_PARENT_SEND_ERROR", "1");
        on_exit unsetenv("TS_PROXY_TEST_FORCE_PARENT_SEND_ERROR");

        *string sock_err;
        try {
            proxy.getDynamicOptions("no-such-app", "no-such-action", NOTHING, NOTHING, NOTHING);
        } catch (hash<ExceptionInfo> ex) {
            # an app-not-found (or similar) error is acceptable; a socket error is the regression
            if (ex.err == "SOCKET-SEND-ERROR" || ex.err == "SOCKET-NOT-OPEN" || ex.err == "SOCKET-CLOSED") {
                sock_err = ex.err;
            }
        }
        assertTrue(!sock_err.val(),
            "a parent-send EPIPE mid-command must be recovered, not surfaced as a fatal socket error");
        assertTrue(proxy.getInfo()."proxy-pid" != pid,
            "child must be restarted after the parent's command send hit EPIPE");
    }

    private proxyParentSendErrorBoundedRestartTest() {
        skipIfNotReady();
        skipIfDebugHooksUnavailable();

        bool debug_enabled = False;
        @debug {
            debug_enabled = True;
        }
        if (!debug_enabled) {
            testSkip("persistent parent-send-error hook requires running with debugging enabled");
            return;
        }

        # this value must match RetryCounter::MaxRestarts in JavaScriptProgramProxy.qc (internal class)
        int expected_max_restarts = 3;

        JavaScriptProgramProxy::init(new Mutex());
        on_exit JavaScriptProgramProxy::shutdown();

        JavaScriptProgramProxy proxy();
        int pid = proxy.getInfo()."proxy-pid";
        assertTrue(pid > 0, "proxy should be running for parent-send bounded-restart test");
        assertEq(0, proxy.getInfo()."restart-count", "the child must not have been restarted before the test");

        # Force the parent's command send to raise EPIPE on EVERY attempt. Without the bound the
        # proxy would restart the child forever; with the fix the command must give up after
        # RetryCounter::MaxRestarts restarts, terminating with the (send-side) socket error.
        setenv("TS_PROXY_TEST_FORCE_PARENT_SEND_ERROR_ALWAYS", "1");
        on_exit unsetenv("TS_PROXY_TEST_FORCE_PARENT_SEND_ERROR_ALWAYS");

        *string sock_err;
        try {
            proxy.getDynamicOptions("no-such-app", "no-such-action", NOTHING, NOTHING, NOTHING);
        } catch (hash<ExceptionInfo> ex) {
            sock_err = ex.err;
        }

        # the command must terminate with the socket error instead of looping forever
        assertEq("SOCKET-SEND-ERROR", sock_err,
            "a parent send that always breaks must give up with the terminal socket error, not loop forever");
        # the number of child restarts must be bounded and deterministic (no timing/polling)
        assertEq(expected_max_restarts, proxy.getInfo()."restart-count",
            "the child must be restarted exactly MaxRestarts times before the command gives up");
    }

    private proxyRestartErrorHandlingTest() {
        skipIfNotReady();
        skipIfDebugHooksUnavailable();

        JavaScriptProgramProxy::init(new Mutex());
        on_exit JavaScriptProgramProxy::shutdown();

        JavaScriptProgramProxy proxy();
        int pid = proxy.getInfo()."proxy-pid";
        assertTrue(pid > 0, "proxy should be running for restart test");

        setenv("TS_PROXY_TEST_FORCE_RESTART_ERROR", "1");
        on_exit unsetenv("TS_PROXY_TEST_FORCE_RESTART_ERROR");

        try {
            system(sprintf("kill -9 %d 2>/dev/null", pid));
        } catch (hash<ExceptionInfo> ex) {
            # ignore
        }

        # the child is dead and every restart fails, as forced, so the command fails with the error of the dead
        # command channel (which error that is depends on when the kill takes effect)
        bool threw = False;
        try {
            proxy.getDynamicOptions("no-such-app", "no-such-action", NOTHING, NOTHING, NOTHING);
        } catch (hash<ExceptionInfo> ex) {
            threw = True;
        }
        assertTrue(threw, "restart error should propagate");
        assertEq(0, proxy.getInfo()."restart-count", "the forced restart error happens before a child is started");

        unsetenv("TS_PROXY_TEST_FORCE_RESTART_ERROR");

        # the failed restart must leave the proxy usable: the next command starts a new child and gets its answer
        *hash<ExceptionInfo> err = callGuarded(sub () {
            proxy.getDynamicOptions("no-such-app", "no-such-action", NOTHING, NOTHING, NOTHING);
        }, "the command after a failed restart");
        assertEq("APP-ERROR", err.err, "the restarted child answers the command");
        assertEq(1, proxy.getInfo()."restart-count", "the command after the failed restart restarted the child");
        assertTrue(proxy.getInfo()."proxy-pid" != pid, "a new child is running");
    }

    private proxySendErrorHandlingTest() {
        skipIfNotReady();
        skipIfDebugHooksUnavailable();

        JavaScriptProgramProxy::init(new Mutex());
        on_exit JavaScriptProgramProxy::shutdown();

        setenv("TS_PROXY_TEST_FORCE_SEND_ERROR", "1");
        on_exit unsetenv("TS_PROXY_TEST_FORCE_SEND_ERROR");

        JavaScriptProgramProxy proxy();
        int pid = proxy.getInfo()."proxy-pid";
        assertTrue(pid > 0, "proxy should be running for send error test");

        # the child cannot send its answer and exits; the command fails with the error of the closed command
        # channel, or, if the parent sees the child exit first, with the error of a restarted child that cannot
        # answer either, so only the failure itself is certain
        *hash<ExceptionInfo> err = callGuarded(sub () {
            proxy.getDynamicOptions("no-such-app", "no-such-action", NOTHING, NOTHING, NOTHING);
        }, "a command whose answer cannot be sent");
        assertTrue(exists err, "a command whose answer cannot be sent fails");

        unsetenv("TS_PROXY_TEST_FORCE_SEND_ERROR");
        # the next command restarts the child if needed and gets its answer
        err = callGuarded(sub () {
            proxy.getDynamicOptions("no-such-app", "no-such-action", NOTHING, NOTHING, NOTHING);
        }, "the command after a lost answer");
        assertEq("APP-ERROR", err.err, "send error should not break subsequent calls");
    }

    private proxyRestartWaitFastPathTest() {
        skipIfNotReady();
        skipIfDebugHooksUnavailable();

        bool debug_enabled = False;
        @debug {
            debug_enabled = True;
        }
        if (!debug_enabled) {
            testSkip("restart wait fast-path hook requires running with debugging enabled");
            return;
        }

        JavaScriptProgramProxy::init(new Mutex());
        on_exit JavaScriptProgramProxy::shutdown();

        JavaScriptProgramProxy proxy();
        setenv("TS_PROXY_TEST_RESTART_WAIT_FAST_PATHS", "1");
        on_exit unsetenv("TS_PROXY_TEST_RESTART_WAIT_FAST_PATHS");
        hash<auto> rv = proxy.getInfo();

        assertEq(0, rv."test-no-restart-retry",
            "a no-restart command must not wait or retry while a restart is already active");
        assertEq(0, rv."test-owner-retry",
            "the restart owner must not wait on its own restart state after a nested restart-path error");
    }

    private proxyStartupSendErrorHandlingTest() {
        skipIfNotReady();
        skipIfDebugHooksUnavailable();

        bool debug_enabled = False;
        @debug {
            debug_enabled = True;
        }
        if (!debug_enabled) {
            testSkip("startup send error hook requires running with debugging enabled");
            return;
        }

        JavaScriptProgramProxy::init(new Mutex());
        on_exit JavaScriptProgramProxy::shutdown();

        setenv("TS_PROXY_TEST_FORCE_SEND_ERROR_STARTUP", "1");
        on_exit unsetenv("TS_PROXY_TEST_FORCE_SEND_ERROR_STARTUP");
        # the child fails at startup and exits, which ends the wait
        *hash<ExceptionInfo> err = callGuarded(sub () {
            JavaScriptProgramProxy proxy();
        }, "starting a child that fails at startup");
        assertEq("CHILD-ERROR", err.err, "startup send error should raise");
        assertRegex("exited before it started", err.desc, "the error reports that the child exited");
    }

    private proxyStartupTimeoutTest() {
        skipIfNotReady();
        skipIfDebugHooksUnavailable();

        JavaScriptProgramProxy::init(new Mutex());
        on_exit JavaScriptProgramProxy::shutdown();

        # the child runs but never connects to its parent
        code<nothing()> restore_hang = setenvScoped("TS_PROXY_TEST_STARTUP_HANG", "1");
        on_exit restore_hang();
        JavaScriptProgramProxy::setStartupTimeout(2s);
        on_exit JavaScriptProgramProxy::setStartupTimeout(HangGuard);

        *hash<ExceptionInfo> err = callGuarded(sub () {
            JavaScriptProgramProxy proxy();
        }, "starting a child that never starts");
        assertEq("CHILD-ERROR", err.err, "a child that never starts is an error");
        assertRegex("did not start within the startup timeout \\(<time: 2 seconds>\\)", err.desc,
            "the configured startup timeout ended the wait");
    }

    private proxyCallTimeoutTest() {
        skipIfNotReady();

        # an app with an action whose API function never answers
        TmpDir fixture("ts-proxy-call-limit-", NOTHING, tmp_location());
        on_exit delete fixture;
        string app = "TsProxyCallLimit" + get_random_string(8);
        string script = fixture.path + DirSep + "call-limit.js";
        {
            File f();
            f.open2(script, O_CREAT | O_EXCL | O_WRONLY, 0600);
            f.write(sprintf("exports.actionsCatalogue = { registerAppActions(api) {
    api.registerApp({ name: '%s', display_name: '%s', short_desc: 'Call limit fixture',
        desc: 'Verifies the call time limit.', groups: ['Other'], logo: 'AA==', logo_file_name: 'test.svg',
        logo_mime_type: 'image/svg+xml' });
    api.registerAction({ app: '%s', action: 'never-answers', display_name: 'Never Answers',
        short_desc: 'Never answers', desc: 'An API function whose promise is never settled.', action_code: 2,
        api_function: () => new Promise(() => {}) });
}};
", app, app, app));
        }

        # The process that sends the call, and its child, load the script and take the call time limit from the
        # environment when the module is loaded, so the call is made in a new process with that environment.  The
        # call as the parent sends it has a pool and closure that are only used in the process that runs it
        hash<auto> env = ENV - ("QORE_TYPESCRIPT_MASTER_ACTION_SCRIPT", "QORE_TYPESCRIPT_ACTION_TEST_SCRIPTS");
        env.QORE_TYPESCRIPT_ACTION_SCRIPTS = script;
        env{TypeScriptActionInterface::CallTimeoutEnv} = "2";
        env.PATH = getenv("PATH");
        string module_dir = ENV.QORE_V8_TEST_QMOD_DIR ?? (get_script_dir() + "/../qlib");
        env.QORE_MODULE_DIR = module_dir + ":" + (ENV.QORE_MODULE_DIR ?? "");
        string code = sprintf("%%modern
JavaScriptProgramProxy::init(new Mutex());
on_exit JavaScriptProgramProxy::shutdown();
JavaScriptProgramProxy::setStartupTimeout(milliseconds(%d));
JavaScriptProgramProxy proxy();
int pid = proxy.getInfo().\"proxy-pid\";
hash<AsyncCallInfo> api = <AsyncCallInfo>{
    \"key\": \"app-%s-never-answers-api_function\",
    \"app\": %y,
    \"action\": \"never-answers\",
    \"type\": \"api_function\",
    \"label\": \"API function that never answers\",
    \"pool\": new JavaScriptProgramPool(\"\", \"unused.js\", sub (JavaScriptProgram pgm) {}),
    \"async_call\": sub () {},
};
# keys are added one by one; a hash literal would narrow the value type to that of its first value
hash<auto> rv;
rv.limit = TypeScriptActionInterface::getCallTimeout().durationSeconds();
try {
    proxy.getAsyncValue(api);
} catch (hash<ExceptionInfo> ex) {
    rv.err = ex.err;
    rv.desc = ex.desc;
}
rv.same_child = proxy.getInfo().\"proxy-pid\" == pid;
printf(\"RESULT: %%s\\n\", make_json(rv));
", get_duration_milliseconds(HangGuard), app, app);

        *hash<auto> result;
        *hash<ExceptionInfo> err = callGuarded(sub () {
            result = Process::run(Process::getExecutablePath(), ("-b", "--enable-debug", "-l", "v8", "-l",
                "TypeScriptActionInterface", "-l", "json", "-e", code), {"env": env});
        }, "a process making a call that never answers");
        assertNothing(err, "the process ran");
        assertEq(0, result.exit_code, result.stdout + result.stderr);
        # the module also logs to stdout when it loads the script
        *string json = (result.stdout =~ x/^RESULT: (.*)$/m)[0];
        assertTrue(exists json, "the process reports the result: " + result.stdout + result.stderr);
        hash<auto> data = parse_json(json);
        assertEq(2, data.limit, "the call time limit is taken from QORE_TYPESCRIPT_CALL_TIMEOUT_SECS");
        assertEq("JAVASCRIPT-ASYNC-ERROR", data.err, "the call fails");
        assertRegex("timed out after 2000 ms", data.desc, "the child ended the call at the call time limit");
        assertTrue(data.same_child, "the child ended the call itself and keeps running");
    }

    #! A child gets the process environment as it is when the child is started, with the changes made since the
    #! process started
    private proxyEnvironmentTest() {
        skipIfNotReady();

        # an app with an action whose API function returns the variables as the child sees them
        TmpDir fixture("ts-proxy-environment-", NOTHING, tmp_location());
        on_exit delete fixture;
        string app = "TsProxyEnvironment" + get_random_string(8);
        string script = fixture.path + DirSep + "environment.js";
        {
            File f();
            f.open2(script, O_CREAT | O_EXCL | O_WRONLY, 0600);
            f.write(sprintf("exports.actionsCatalogue = { registerAppActions(api) {
    api.registerApp({ name: '%s', display_name: '%s', short_desc: 'Environment fixture',
        desc: 'Returns the environment of the child.', groups: ['Other'], logo: 'AA==', logo_file_name: 'test.svg',
        logo_mime_type: 'image/svg+xml' });
    api.registerAction({ app: '%s', action: 'read-environment', display_name: 'Read Environment',
        short_desc: 'Reads the environment', desc: 'Returns the test variables as the child sees them.',
        action_code: 2,
        api_function: () => ({
            added: process.env.TS_PROXY_ENV_ADDED ?? '<unset>',
            changed: process.env.TS_PROXY_ENV_CHANGED ?? '<unset>',
            removed: process.env.TS_PROXY_ENV_REMOVED ?? '<unset>',
        }) });
}};
", app, app, app));
        }

        # The process that starts the child loads the script and changes the environment after the modules are
        # loaded; when it starts, the environment has two of the three variables.  The call as the parent sends it
        # has a pool and closure that are only used in the process that runs it
        hash<auto> env = ENV - ("QORE_TYPESCRIPT_MASTER_ACTION_SCRIPT", "QORE_TYPESCRIPT_ACTION_TEST_SCRIPTS",
            "TS_PROXY_ENV_ADDED");
        env.QORE_TYPESCRIPT_ACTION_SCRIPTS = script;
        env.TS_PROXY_ENV_CHANGED = "value when the process started";
        env.TS_PROXY_ENV_REMOVED = "value when the process started";
        env.PATH = getenv("PATH");
        string module_dir = ENV.QORE_V8_TEST_QMOD_DIR ?? (get_script_dir() + "/../qlib");
        env.QORE_MODULE_DIR = module_dir + ":" + (ENV.QORE_MODULE_DIR ?? "");
        string code = sprintf("%%modern
if (setenv(\"TS_PROXY_ENV_ADDED\", \"added after the process started\")
        || setenv(\"TS_PROXY_ENV_CHANGED\", \"changed after the process started\")
        || unsetenv(\"TS_PROXY_ENV_REMOVED\")) {
    throw \"SETENV-ERROR\", strerror();
}
JavaScriptProgramProxy::init(new Mutex());
on_exit JavaScriptProgramProxy::shutdown();
JavaScriptProgramProxy::setStartupTimeout(milliseconds(%d));
JavaScriptProgramProxy proxy();
hash<AsyncCallInfo> api = <AsyncCallInfo>{
    \"key\": \"app-%s-read-environment-api_function\",
    \"app\": %y,
    \"action\": \"read-environment\",
    \"type\": \"api_function\",
    \"label\": \"API function that reads the environment\",
    \"pool\": new JavaScriptProgramPool(\"\", \"unused.js\", sub (JavaScriptProgram pgm) {}),
    \"async_call\": sub () {},
};
printf(\"RESULT: %%s\\n\", make_json(proxy.getAsyncValue(api)));
", get_duration_milliseconds(HangGuard), app, app);

        *hash<auto> result;
        *hash<ExceptionInfo> err = callGuarded(sub () {
            result = Process::run(Process::getExecutablePath(), ("-b", "--enable-debug", "-l", "v8", "-l",
                "TypeScriptActionInterface", "-l", "json", "-e", code), {"env": env});
        }, "a process making a call that reads the environment");
        assertNothing(err, "the process ran");
        assertEq(0, result.exit_code, result.stdout + result.stderr);
        # the module also logs to stdout when it loads the script
        *string json = (result.stdout =~ x/^RESULT: (.*)$/m)[0];
        assertTrue(exists json, "the process reports the result: " + result.stdout + result.stderr);
        hash<auto> data = parse_json(json);
        assertEq("added after the process started", data.added, "the child sees a variable added with setenv()");
        assertEq("changed after the process started", data.changed,
            "the child sees the value a variable was changed to with setenv()");
        assertEq("<unset>", data.removed, "the child does not see a variable removed with unsetenv()");
    }
}

%else
class TsProxyTest inherits QUnit::Test {
    constructor() : Test("External module dependencies", "1.0", \ARGV) {
        addTestCase("process/uuid dependencies", sub() {
            testSkip("process or uuid module is unavailable");
        });
        set_return_value(main());
    }
}
%endif
