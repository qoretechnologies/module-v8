#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-
# Copyright (C) 2026 Qore Technologies, s.r.o.
#
# A Shopify connection with an expiring offline token (qoretechnologies/qorus#1125), with the connection metadata
# the catalogue ships (ts/src/apps/shopify/rest.ts, compiled) against a local server that answers as Shopify does:
# token answers with five fields and no "token_type", and an Admin API that takes the token in
# "X-Shopify-Access-Token" only.  The connection asks for an expiring token beside the token arguments Qorus adds,
# both of its clients take the answer of a refresh and send the new token in Shopify's header, in the request that
# made the refresh too, and its ping, which is what refreshes the token of a connection that Qorus monitors, does so
# for a token in its last minutes and for one that has run out.
#
# Run with QORE_TYPESCRIPT_MASTER_ACTION_SCRIPT, QORE_TYPESCRIPT_ACTION_SCRIPTS and
# QORE_TYPESCRIPT_ACTION_TEST_SCRIPTS unset, as test/hubspot-oauth.qtest: the app is registered from the compiled
# metadata here, and an installed catalogue would register it too.
%modern
%requires qore >= 3.0
%requires QUnit
%requires v8
%requires TypeScriptActionInterface
%requires ConnectionProvider
%requires RestClient
%requires Mime
%requires json
%requires HttpServer
%exec-class ShopifyOAuthTest

#! The local Shopify: the token endpoint and the one Admin API resource the connection's ping reads
class ShopifyFixtureHandler inherits AbstractHttpRequestHandler {
    public {
        #! the form arguments of every token request, in the order received
        static list<hash<auto>> token_requests = ();
        #! the value of X-Shopify-Access-Token of every Admin API request, in the order received
        static list<auto> admin_tokens = ();
        #! the access tokens the Admin API accepts: the one a connection starts with, and every one issued
        static hash<string, bool> valid = {"first-token": True};
        static int issued = 0;
        static Mutex m();
    }

    hash<HttpResponseInfo> handleRequest(hash<auto> cx, hash<auto> hdr, *data body) {
        if (hdr.path =~ /^\/?admin\/oauth\/access_token/) {
            hash<auto> args = mime_parse_form_urlencoded_string(body);
            int n;
            {
                AutoLock al(m);
                token_requests += args;
                n = ++issued;
                valid{"access-" + n} = True;
            }
            # as Shopify answers the code exchange and a refresh: no "token_type"
            return makeResponse(200, make_json({
                "access_token": "access-" + n,
                "scope": "read_products",
                "expires_in": 3600,
                "refresh_token": "refresh-" + n,
                "refresh_token_expires_in": 7776000,
            }), {"Content-Type": MimeTypeJson});
        }
        if (hdr.path =~ /^\/?admin\/api\/[0-9]{4}-[0-9]{2}\/shop\.json/) {
            *string token = hdr."x-shopify-access-token";
            bool ok;
            {
                AutoLock al(m);
                admin_tokens += token;
                ok = token.val() && valid{token};
            }
            # Shopify does not read the token from Authorization: without its own header the request is refused
            if (!ok) {
                return makeResponse(401, make_json({"errors": "[API] Invalid API key or access token "
                    "(unrecognized login or wrong password)"}), {"Content-Type": MimeTypeJson});
            }
            return makeResponse(200, make_json({"shop": {"myshopify_domain": "fixture.myshopify.com"}}),
                {"Content-Type": MimeTypeJson});
        }
        return makeResponse(404, make_json({"errors": "Not Found"}), {"Content-Type": MimeTypeJson});
    }

    #! Makes the Admin API accept a token that the token endpoint did not issue
    static accept(string token) {
        AutoLock al(m);
        valid{token} = True;
    }

    #! Forgets the requests received and every token issued
    static reset() {
        AutoLock al(m);
        token_requests = ();
        admin_tokens = ();
        valid = {"first-token": True};
        issued = 0;
    }
}

class ShopifyOAuthTest inherits QUnit::Test {
    private {
        HttpServer server;
        #! the plain listener, of the token endpoint
        string url;
        #! the TLS listener, of the Admin API
        string rest_url;
        JavaScriptProgramPool pool;

        #! the compiled connection metadata of the catalogue's Shopify app
        const Metadata = "/../ts/dist/apps/shopify/rest.js";
    }

    constructor() : Test("Shopify expiring offline token", "1.0") {
        if (!hstat(get_script_dir() + Metadata)) {
            addTestCase("Shopify catalog fixture", sub () {
                testSkip("build the matching TypeScript catalog to run the Shopify OAuth fixture");
            });
            set_return_value(main());
            return;
        }
        addTestCase("the catalogue's connection asks for an expiring token beside Qorus's token arguments",
            \settingsTest());
        addTestCase("the connection's client sends the token of the code exchange in Shopify's header",
            \exchangeAnswerTest());
        addTestCase("the connection's client refreshes a token in its last minutes and sends the new one",
            \refreshTest());
        addTestCase("a copy of the connection's client for another URL sends the token in Shopify's header too",
            \clientCopyTest());
        addTestCase("the ping of Qorus's connection monitor refreshes a token in its last minutes",
            \monitorPingRefreshTest());
        addTestCase("the connection's blocking ping refreshes a token in its last minutes", \pingRefreshTest());
        addTestCase("the ping of a connection whose token has run out refreshes it and passes",
            \expiredTokenPingTest());
        addTestCase("a header of the token that was stored with the ping's headers is dropped", \storedHeaderTest());
        addTestCase("a ping with a token Shopify does not accept fails", \refusedPingTest());
        set_return_value(main());
    }

    globalSetUp() {
        if (!hstat(get_script_dir() + Metadata)) {
            return;
        }
        server = new HttpServer();
        server.setDefaultHandler("fixture", new ShopifyFixtureHandler());
        int port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0}).port;
        url = sprintf("http://127.0.0.1:%d", port);
        # an app's connection uses HTTPS; the certificate exists only in this process
        string pem = backquote("openssl req -config /dev/null -x509 -newkey rsa:2048 -keyout /dev/stdout "
            "-out /dev/stdout -days 1 -nodes -subj /CN=localhost 2>/dev/null");
        SSLPrivateKey key((pem =~ x/(-----BEGIN PRIVATE KEY-----[\s\S]+?-----END PRIVATE KEY-----)/)[0]);
        SSLCertificate cert((pem =~ x/(-----BEGIN CERTIFICATE-----[\s\S]+?-----END CERTIFICATE-----)/)[0]);
        port = server.addListener(<HttpListenerOptionInfo>{"node": "127.0.0.1", "service": 0,
            "key": key, "cert": cert, "enable_h3": False}).port;
        rest_url = sprintf("https://127.0.0.1:%d", port);

        # the app as the catalogue registers it, with its REST options and its connection options, and only its
        # three URLs moved to the local server
        string script = "var exports = {};\n"
            "async function runWithTimeout(p, d) { return await (typeof p === 'function' ? p() : p); }\n"
            "const metadata = require(" + make_json(realpath(get_script_dir() + "/../ts/dist/apps/shopify"))
            + " + '/rest');\n"
            "exports.actionsCatalogue = {registerAppActions: function(api) {\n"
            "    api.registerApp({name: metadata.SHOPIFY_APP_NAME, display_name: 'Shopify',\n"
            "        short_desc: 'Shopify fixture', desc: 'Local Shopify fixture', groups: ['Other'],\n"
            "        logo: 'PHN2Zy8+', logo_file_name: 'fixture.svg', logo_mime_type: 'image/svg+xml',\n"
            "        rest: Object.assign({}, metadata.getShopifyRestOptions(), {\n"
            "            url: " + make_json(rest_url) + ",\n"
            "            oauth2_auth_url: " + make_json(url + "/admin/oauth/authorize") + ",\n"
            "            oauth2_token_url: " + make_json(url + "/admin/oauth/access_token") + "}),\n"
            "        rest_modifiers: metadata.getShopifyRestModifiers()});\n"
            "}};\n";
        pool = new JavaScriptProgramPool(script, get_script_dir() + "/../ts/shopify-oauth-fixture.js",
            sub (JavaScriptProgram pgm) {
                pgm.getGlobal().exports.actionsCatalogue.registerAppActions(
                    TypeScriptActionInterface::getInterface());
            });
        TypeScriptActionInterface::initApp("Shopify", True);
    }

    globalTearDown() {
        delete server;
    }

    #! Returns a connection as Qorus makes one with a client whose secret it does not hold, beside the options
    private TypeScriptAppRestConnection connection(*hash<auto> opts) {
        return new TypeScriptAppRestConnection({"name": "shopify-fixture-" + get_random_string(6),
            "url": "tsrest-shopify://", "opts": {
                "shop": "fixture",
                "oauth2_client_id": "fixture-client",
                "oauth2_client_secret": "fixture-secret",
                "oauth2_redirect_url": "https://callback.example.test/oauth",
                "oauth2_token_args": {"oauth2_app": "Shopify"},
                "ssl_verify_cert": False,
            } + opts});
    }

    #! Returns a client of the connection that adds what it reports for the connection to keep to the hash
    private TypeScriptAppRestClient client(TypeScriptAppRestConnection conn, reference<hash<auto>> kept) {
        return new TypeScriptAppRestClient(conn, conn.getRealOptions() + {"url": rest_url,
            "update_options": sub (hash<auto> new_opts) {
                kept += new_opts;
            }}, True);
    }

    #! Drives the connection's ping as Qorus's connection monitor runs it (PollingConnectionMonitor)
    /** The monitor's thread refuses blocking I/O (SOCKET-SYNC-ON-IO-THREAD-ERROR), which this thread does not, so
        a call of the app's JavaScript in that ping would pass here and fail there
    */
    private drivePing(TypeScriptAppRestConnection conn) {
        AbstractPollOperation op = conn.startPollConnect();
        date deadline = now_us() + 30s;
        while (*hash<SocketPollInfo> info = op.continuePoll()) {
            while (!Socket::poll((info,), 1s)) {
                if (now_us() > deadline) {
                    throw "PING-TIMEOUT", sprintf("the ping did not end; state: %s", op.getState());
                }
            }
        }
        assertTrue(op.goalReached());
    }

    #! The stored options of a connection two minutes before its token runs out: inside the ten in which it is refreshed
    private hash<auto> expiringOptions() {
        return {
            "token": "first-token",
            "oauth2_refresh_token": "first-refresh-token",
            "oauth2_token_expiry": now_us() + 2m,
        };
    }

    #! Returns a connection with the options that keeps what it reports in the hash
    /** Qorus gives a connection the code that saves the options it reports (QorusUserConnections::setUpdateOptions());
        the hash stands for that here
    */
    private TypeScriptAppRestConnection reportingConnection(hash<auto> stored, reference<hash<auto>> kept) {
        TypeScriptAppRestConnection conn = connection(stored);
        conn.setUpdateOptionsCode(sub (hash<auto> new_opts) {
            kept += new_opts;
        });
        return conn;
    }

    #! Asserts the one refresh of a request of a connection with the stored options, and the connection after it
    /** @param stored the options of the connection that made the request
        @param kept what was reported for the connection to keep
    */
    private assertRefreshed(hash<auto> stored, hash<auto> kept) {
        assertEq(({
            "grant_type": "refresh_token",
            "refresh_token": "first-refresh-token",
            "client_id": "fixture-client",
            "client_secret": "fixture-secret",
            "expiring": "1",
            "oauth2_app": "Shopify",
        },), ShopifyFixtureHandler::token_requests, "one refresh, with the app's argument and Qorus's");
        assertEq(("access-1", "refresh-1"), (kept.token, kept.oauth2_refresh_token));
        assertTrue(kept.oauth2_token_expiry > now_us() + 50m, "the new token's expiry is kept");
        assertFalse(kept.hasKey("ping_headers"), "the token is not copied into the ping's headers");
        # the request that made the refresh carried the new token in Shopify's header
        assertEq(("access-1",), ShopifyFixtureHandler::admin_tokens);

        # Qorus saves what was reported and builds the connection anew (QorusUserConnections::reportOptions()): its
        # ping carries the new token and makes no further token request
        ShopifyFixtureHandler::admin_tokens = ();
        hash<auto> ping = connection(stored + kept).ping();
        assertTrue(ping.ok, sprintf("%y", ping - "opts"));
        assertEq(("access-1",), ShopifyFixtureHandler::admin_tokens);
        assertEq(1, ShopifyFixtureHandler::token_requests.size());
    }

    settingsTest() {
        hash<auto> opts = connection().getConnectionOptions();
        assertEq({"expiring": 1, "oauth2_app": "Shopify"}, opts.oauth2_token_args);
        assertEq(url + "/admin/oauth/access_token", opts.oauth2_token_url);
        assertRegex("^/admin/api/[0-9]{4}-[0-9]{2}/shop\\.json$", opts.ping_path);
        assertEq("X-Shopify-Access-Token", opts.token_api_key_header);
    }

    exchangeAnswerTest() {
        ShopifyFixtureHandler::reset();
        ShopifyFixtureHandler::accept("access-from-code");
        hash<auto> kept;
        # the client holds its connection weakly: the connection stays in scope for as long as the client is used
        TypeScriptAppRestConnection conn = connection();
        TypeScriptAppRestClient c = client(conn, \kept);
        # the answer of a code exchange with expiring=1, as Shopify gave it on 2026-11-23
        c.gotOAuth2LoginInfo({
            "access_token": "access-from-code",
            "scope": "read_products",
            "expires_in": 3599,
            "refresh_token": "refresh-from-code",
            "refresh_token_expires_in": 7775999,
        });
        assertEq(("access-from-code", "refresh-from-code"), (kept.token, kept.oauth2_refresh_token));
        assertTrue(kept.oauth2_token_expiry > now_us() + 50m, "the token's expiry is kept");
        assertFalse(kept.hasKey("ping_headers"), "the token is not copied into the ping's headers");
        # the client's next request carries the token in Shopify's header
        hash<auto> info;
        c.get(conn.getConnectionOptions().ping_path, NOTHING, \info);
        assertEq(200, info."response-code");
        assertEq(("access-from-code",), ShopifyFixtureHandler::admin_tokens);
    }

    #! The client that the connection gives out for requests other than its ping (TypeScriptAppRestClient)
    refreshTest() {
        ShopifyFixtureHandler::reset();
        hash<auto> stored = expiringOptions();
        TypeScriptAppRestConnection conn = connection(stored);
        hash<auto> kept;
        TypeScriptAppRestClient c = client(conn, \kept);
        hash<auto> info;
        c.get(conn.getConnectionOptions().ping_path, NOTHING, \info);
        assertEq(200, info."response-code");
        assertRefreshed(stored, kept);
    }

    #! A copy of the client for another URL, as RestClient makes one for an absolute ping path
    /** The copy is created from the options that RestClient saved, which lack the token header's option
    */
    clientCopyTest() {
        ShopifyFixtureHandler::reset();
        TypeScriptAppRestConnection conn = connection({"token": "first-token"});
        hash<auto> kept;
        RestClient copy = cast<RestClient>(client(conn, \kept).copyWithUrl(rest_url));
        hash<auto> info;
        copy.get(conn.getConnectionOptions().ping_path, NOTHING, \info);
        assertEq(200, info."response-code");
        assertEq(("first-token",), ShopifyFixtureHandler::admin_tokens);
    }

    #! The ping as Qorus's connection monitor runs it: the connection's asynchronous client takes the token answer
    /** On a Qorus (build 7b7659f5) this ping refused Shopify's answer for its missing "token_type" once a minute
        from ten minutes before the first token ran out, and the connection was down from then on
        (qoretechnologies/qorus#1125)
    */
    monitorPingRefreshTest() {
        ShopifyFixtureHandler::reset();
        hash<auto> stored = expiringOptions();
        hash<auto> kept;
        drivePing(reportingConnection(stored, \kept));
        assertRefreshed(stored, kept);
    }

    pingRefreshTest() {
        ShopifyFixtureHandler::reset();
        hash<auto> stored = expiringOptions();
        hash<auto> kept;
        hash<auto> ping = reportingConnection(stored, \kept).ping();
        assertTrue(ping.ok, sprintf("%y", ping - "opts"));
        assertRefreshed(stored, kept);
    }

    #! A connection that was not pinged while its token ran out: Qorus was down, or the connection was disabled
    /** The token is refreshed before the ping's request, and that request must carry the new one: the local Shopify
        refuses the token that ran out, as Shopify does
    */
    expiredTokenPingTest() {
        ShopifyFixtureHandler::reset();
        hash<auto> stored = expiringOptions() + {
            "token": "a-token-that-ran-out",
            "oauth2_token_expiry": now_us() - 5m,
        };
        hash<auto> kept;
        drivePing(reportingConnection(stored, \kept));
        assertRefreshed(stored, kept);
    }

    #! A connection as an earlier version of the app left it: the token's header among the ping's headers
    /** That header would be sent in place of the client's own, with the token of the time it was stored
    */
    storedHeaderTest() {
        ShopifyFixtureHandler::reset();
        TypeScriptAppRestConnection conn = connection({
            "token": "first-token",
            "ping_headers": {"X-Shopify-Access-Token": "a-token-from-before", "X-Fixture": "kept"},
        });
        assertEq({"X-Fixture": "kept"}, conn.getRealOptions().ping_headers);
        hash<auto> ping = conn.ping();
        assertTrue(ping.ok, sprintf("%y", ping - "opts"));
        assertEq(("first-token",), ShopifyFixtureHandler::admin_tokens);
    }

    refusedPingTest() {
        ShopifyFixtureHandler::reset();
        hash<auto> ping = connection({"token": "a-token-never-issued"}).ping();
        assertFalse(ping.ok);
        assertEq(("a-token-never-issued",), ShopifyFixtureHandler::admin_tokens);
    }
}
