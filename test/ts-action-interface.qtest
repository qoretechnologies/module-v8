%modern
%prepend-module-path "${SCRIPT_DIR}/../qlib"

%requires QUnit
%requires GoogleDataProvider
%requires RestClient
%requires DiscordRestClient
%try-module json
%define MISSING_EXTERNAL_MODULE
%endtry
%try-module process
%define MISSING_EXTERNAL_MODULE
%endtry
%try-module uuid
%define MISSING_EXTERNAL_MODULE
%endtry
%ifndef MISSING_EXTERNAL_MODULE
%requires TypeScriptActionInterface
%endif
%requires v8

%exec-class TypeScriptActionInterfaceTest

%ifndef MISSING_EXTERNAL_MODULE

%include google-discovery-fixture.q

public class TypeScriptActionInterfaceTest inherits QUnit::Test {
    private {
        Logger logger;
        #! The last webhook callback captured during webhook registration
        static code last_webhook_callback;
    }

    #! Returns the last captured webhook callback
    static code get_last_webhook_callback() {
        return last_webhook_callback;
    }

    #! Sets the last captured webhook callback
    static set_last_webhook_callback(code callback) {
        last_webhook_callback = callback;
    }

    constructor() : Test("TypeScriptActionInterfaceTest", "1.0") {
        setupLogger();

        addTestCase("js event extension", \jsEventExtensionTest());
        addTestCase("js events", \jsEventTest());
        addTestCase("event checkpoints", \eventCheckpointTest());
        addTestCase("event checkpoint validation", \eventCheckpointValidationTest());
        addTestCase("webhook events", \webhookEventTest());
        addTestCase("webhook format_event_data transform", \webhookFormatEventDataTransformTest());
        addTestCase("webhook format_event_data filter", \webhookFormatEventDataFilterTest());
        addTestCase("webhook format_event_data exception", \webhookFormatEventDataExceptionTest());
        addTestCase("pool", \poolTest());
        addTestCase("sanity", \sanityTest());
        addTestCase("js", \jsTest());
        addTestCase("test API", \testApi());
        addTestCase("include_response_headers flag", \includeResponseHeadersTest());
        addTestCase("app base dir", \appBaseDirTest());
        addTestCase("structured field choices", \structuredFieldChoicesTest());
        addTestCase("producer schema boundary", \producerSchemaBoundaryTest());
        addTestCase("eager registration failure reporting", \eagerRegistrationFailureTest());
        addTestCase("optional resource initialization failures", \optionalResourceFailureTest());
        addTestCase("schema connections and retry", \schemaConnectionRetryTest());
        addTestCase("HubSpot schema connections and retry", sub () {
            schemaConnectionRetryTest("HUBSPOT-SCHEMAS-UNAVAILABLE");
        });
        addTestCase("failed app initialization retry", \failedAppRetryTest());
        addTestCase("failed existing app initialization retry", \existingAppRetryTest());
        addTestCase("failed deferred action retry", \deferredActionRetryTest());
        addTestCase("app metadata protocol validation", \appMetadataProtocolTest());
        addTestCase("schema option additions", \schemaOptionAdditionsTest());
        addTestCase("producer identity contract skew", \inventoryContractSkewTest());

        # Return for compatibility with test harnesses that check the script's return value
        set_return_value(main());
    }

    setupLogger() {
        LoggerLevel level;
        if (m_options.verbose > 3) {
            level = LoggerLevel::getLevelDebug();
        } else if (m_options.verbose > 2) {
            level = LoggerLevel::getLevelInfo();
        } else {
            level = LoggerLevel::getLevelFatal();
        }
        logger = new Logger("console", level);
        if (m_options.verbose > 2) {
            logger.addAppender(new StdoutAppender());
        } else {
            logger.addAppender(new LoggerAppenderNull());
        }
        DataProvider::setGlobalLogger(logger);
    }

    globalSetUp() {
        GoogleDiscoveryFixture::seed();
        chdir(get_script_dir());
        JavaScriptProgramPool pool("var exports = {};
// Returns a Promise that resolves immediately with the state of 'promise'
function promiseState(promise) {
  const pendingState = { status: 'pending' };
  return Promise.race([promise, pendingState]).then(
    (value) =>
      value === pendingState ? value : { status: 'fulfilled', value },
    (reason) => ({ status: 'rejected', reason }),
  );
}

async function runWithTimeout(promise, delay) {
  if (typeof promise === 'function') {
    promise = promise();
  }
  if (!(promise instanceof Promise)) {
    return promise;
  }

  // this inspects the state of the promise and returns immediately
  // without this call, there is an 8-second delay when 'promise' rejects
  await promiseState(promise);

  // timeout variable to cancel the timeout in case the async function is faster
  let timeout;
  // get a promise to a cancelable timeout
  let top = new Promise((_, reject) => (timeout = setTimeout(() => reject(new Error('Request timed out')), delay)));
  // run the promise and cancel the timeout
  return Promise.race([
    promise,
    top
  ]).finally(() => {
    if (timeout) {
      clearTimeout(timeout);
    }
  });
}\n" + File::readTextFile("example.js"), "example.js",
            sub (JavaScriptProgram pgm) {});
        JavaScriptObject obj = pool.getProgram().getGlobal().exports;

        obj.actionsCatalogue.registerAppActions(TypeScriptActionInterface::Api);
    }

    private jsEventExtensionTest() {
        hash<DataProviderAppInfo> appinfo = DataProviderActionCatalog::getAppEx("Discord");
        assertEq("Discord", appinfo.name);

        hash<DataProviderActionInfo> actioninfo = DataProviderActionCatalog::getAppActionEx("Discord", "js-event-1");
        assertEq("js-event-1", actioninfo.action);

        hash<auto> config = {
            "name": "test",
            "url": "discord://x",
            "opts": {
                "token": "x",
            },
        };
        DiscordRestConnection conn(config);
        assertEq("discord://x", conn.getUrl());

        DataProviderDataContextHelper dch({"name": "Fred"});
        AbstractDataProvider prov =
            TypeScriptActionInterface::getDataProvider("discord", conn).getChildProviderEx("js-event-1");
        AbstractDataProviderType t = prov.getEventTypes().event.type;
        assertEq(2, t.getFields().size());
        assertTrue(prov.supportsObservable());
        assertEq({
            "name": "a name",
            "code": 1234,
        }, prov.getExampleEventData("event"));

        MyObserver o();
        cast<Observable>(prov).registerObserver(o);
        cast<DelayedObservable>(prov).observersReady();
        on_exit cast<DelayedObservable>(prov).stopEvents();

        # wait for a single event
        hash<auto> event = o.waitForEvent();
        assertEq({
            "event_id": "event",
            "data": {
                "name": "name-1",
                "code": 1234,
            },
        }, event);
    }

    #! A TypeScript event function must be able to keep a durable position across a reload
    /** The whole point of a checkpoint is that the position survives the host restarting the provider. This
        drives the real Qore/JavaScript boundary in both directions: the state restored into the provider must
        reach \c checkpoint.get() in JavaScript, and the state passed to \c checkpoint.set() must reach the
        host's storage callback.
    */
    private eventCheckpointTest() {
        hash<auto> config = {
            "name": "test",
            "url": "tsrest-js-openapi-test://",
            "opts": {
                "subdomain": "test",
                "token": "x",
            },
        };
        TypeScriptAppRestConnection conn(config);

        list<hash<auto>> saved = ();
        AbstractDataProvider prov =
            TypeScriptActionInterface::getDataProvider("js-openapi-test", conn)
                .getChildProviderEx("js-event-checkpoint");

        # a fresh provider has nothing to restore, so the event function reports cursor 0
        MyObserver o();
        cast<Observable>(prov).registerObserver(o);
        cast<AbstractWatchDataProviderBase>(prov).setCheckpointPersistence(NOTHING,
            sub (hash<auto> checkpoint) {
                saved += checkpoint;
            });
        cast<DelayedObservable>(prov).observersReady();
        on_exit cast<DelayedObservable>(prov).stopEvents();

        hash<auto> event = o.waitForEvent();
        assertEq("checkpoint-event", event.data.name);
        assertEq(0, event.data.code, "nothing was restored on a first start");

        # the position stored by the event function reached the host callback, in a versioned envelope
        assertEq(1, saved.size(), "the event function's checkpoint reached the host");
        assertEq(1, saved[0].version, "the checkpoint is versioned");
        assertEq(1, saved[0].seq, "the first checkpoint carries sequence 1");
        assertEq({"cursor": 1}, saved[0].state, "the state the event function stored round-tripped intact");

        # a replacement provider given that checkpoint must resume from it rather than start over
        AbstractDataProvider prov2 =
            TypeScriptActionInterface::getDataProvider("js-openapi-test", conn)
                .getChildProviderEx("js-event-checkpoint");
        list<hash<auto>> saved2 = ();
        MyObserver o2();
        cast<Observable>(prov2).registerObserver(o2);
        cast<AbstractWatchDataProviderBase>(prov2).setCheckpointPersistence(saved[0],
            sub (hash<auto> checkpoint) {
                saved2 += checkpoint;
            });
        cast<DelayedObservable>(prov2).observersReady();
        on_exit cast<DelayedObservable>(prov2).stopEvents();

        hash<auto> event2 = o2.waitForEvent();
        assertEq(1, event2.data.code, "the stored position was restored into the event function");
        assertEq({"cursor": 2}, saved2[0].state, "the resumed run advanced from the restored position");
        assertEq(2, saved2[0].seq, "the sequence number advances with the restored checkpoint");
    }

    #! A checkpoint envelope in an unknown shape must be rejected rather than silently ignored
    private eventCheckpointValidationTest() {
        hash<auto> config = {
            "name": "test",
            "url": "tsrest-js-openapi-test://",
            "opts": {
                "subdomain": "test",
                "token": "x",
            },
        };
        TypeScriptAppRestConnection conn(config);
        AbstractDataProvider prov =
            TypeScriptActionInterface::getDataProvider("js-openapi-test", conn)
                .getChildProviderEx("js-event-checkpoint");

        assertThrows("WATCH-CHECKPOINT-ERROR", "version 1", sub () {
            cast<AbstractWatchDataProviderBase>(prov).setCheckpointPersistence({"version": 2, "seq": 1},
                sub (hash<auto> checkpoint) {});
        });
        assertThrows("WATCH-CHECKPOINT-ERROR", "non-negative seq", sub () {
            cast<AbstractWatchDataProviderBase>(prov).setCheckpointPersistence({"version": 1, "seq": -1},
                sub (hash<auto> checkpoint) {});
        });
    }

    private jsEventTest() {
        hash<DataProviderAppInfo> appinfo = DataProviderActionCatalog::getAppEx("js-openapi-test");
        assertEq("js-openapi-test", appinfo.name);

        hash<DataProviderActionInfo> actioninfo = DataProviderActionCatalog::getAppActionEx("js-openapi-test",
            "js-event-1");
        assertEq("js-event-1", actioninfo.action);

        hash<auto> config = {
            "name": "test",
            "url": "tsrest-js-openapi-test://",
            "opts": {
                "subdomain": "test",
                "token": "x",
            },
        };
        TypeScriptAppRestConnection conn(config);
        assertEq("tsrest-js-openapi-test://test.example.com/api", conn.getUrl());

        {
            DataProviderDataContextHelper dch({"name": "Fred"});
            AbstractDataProvider prov =
                TypeScriptActionInterface::getDataProvider("js-openapi-test", conn).getChildProviderEx("js-event-1");
            AbstractDataProviderType t = prov.getEventTypes().event.type;
            assertEq(2, t.getFields().size());
            assertTrue(prov.supportsObservable());
            assertEq({
                "name": "a name",
                "code": 1234,
            }, prov.getExampleEventData("event"));

            MyObserver o();
            cast<Observable>(prov).registerObserver(o);
            cast<DelayedObservable>(prov).observersReady();
            on_exit cast<DelayedObservable>(prov).stopEvents();

            # wait for a single event
            hash<auto> event = o.waitForEvent();
            assertEq({
                "event_id": "event",
                "data": {
                    "name": "name-1",
                    "code": 1234,
                },
            }, event);
        }

        {
            hash<auto> opts = {
                "name": "Fred",
                "extra": True,
            };
            DataProviderDataContextHelper dch(opts);
            AbstractDataProvider prov =
                TypeScriptActionInterface::getDataProvider("js-openapi-test", conn).getChildProviderEx("js-event-1");
            AbstractDataProviderType t = prov.getEventInfoWithOptions("event", opts).type;
            assertEq(3, t.getFields().size());
            assertTrue(prov.supportsObservable());
            assertEq({
                "name": "a name",
                "code": 1234,
                "extra": "hi",
            }, prov.getExampleEventData("event"));

            MyObserver o();
            cast<Observable>(prov).registerObserver(o);
            cast<DelayedObservable>(prov).observersReady();
            on_exit cast<DelayedObservable>(prov).stopEvents();

            # wait for a single event
            hash<auto> event = o.waitForEvent();
            assertEq({
                "event_id": "event",
                "data": {
                    "name": "name-1",
                    "code": 1234,
                    "extra": "hi",
                },
            }, event);
        }
    }

    private webhookEventTest() {
        code webhook_callback;
        code get_webhook = hash<auto> sub (hash<auto> h) {
            webhook_callback = h.callback;
            # Also store in class variable for use by subsequent tests
            TypeScriptActionInterfaceTest::set_last_webhook_callback(h.callback);
            return {
                "url": "https://localhost:8011/webhooks/abc",
            };
        };
        code delete_webhook = sub (hash<auto> info) {
        };

        TypeScriptActionInterface::registerWebhookCreateDestroyApis(get_webhook, delete_webhook);

        hash<DataProviderAppInfo> appinfo = DataProviderActionCatalog::getAppEx("js-openapi-test");
        assertEq("js-openapi-test", appinfo.name);

        hash<DataProviderActionInfo> actioninfo = DataProviderActionCatalog::getAppActionEx("js-openapi-test",
            "webhook-event-1");
        assertEq("webhook-event-1", actioninfo.action);

        hash<auto> config = {
            "name": "test",
            "url": "tsrest-js-openapi-test://",
            "opts": {
                "subdomain": "test",
                "token": "x",
            },
        };
        TypeScriptAppRestConnection conn(config);
        assertEq("tsrest-js-openapi-test://test.example.com/api", conn.getUrl());

        {
            AbstractDataProvider prov =
                TypeScriptActionInterface::getDataProvider("js-openapi-test", conn)
                    .getChildProviderEx("webhook-event-1");
            MyObserver o();
            cast<Observable>(prov).registerObserver(o);
            # temporarily disable data provider error logging, as the error from the negative test below will
            # otherwise be logged to the console
            logger.removeAllAppenders();
            on_exit logger.addAppender(new StdoutAppender());
            assertThrows("JAVASCRIPT-ASYNC-ERROR", \cast<DelayedObservable>(prov).observersReady());
        }

        DataProviderDataContextHelper dch({"name": "Fred"});
        AbstractDataProvider prov =
            TypeScriptActionInterface::getDataProvider("js-openapi-test", conn).getChildProviderEx("webhook-event-1");
        AbstractDataProviderType t = prov.getEventTypes().event.type;
        assertEq(2, t.getFields().size());
        assertTrue(prov.supportsObservable());
        assertEq({
            "name": "a name",
            "code": 1234,
        }, prov.getExampleEventData("event"));

        MyObserver o();
        cast<Observable>(prov).registerObserver(o);
        cast<DelayedObservable>(prov).observersReady();
        on_exit cast<DelayedObservable>(prov).stopEvents();

        assertTrue(exists webhook_callback);
        hash<auto> event = {
            "name": get_random_string(),
            "code": rand() % 10000,
        };
        webhook_callback(event);

        assertEq(1, o.l.size());
        assertEq({"event_id": "event", "data": event}, o.l[0]);
    }

    private webhookFormatEventDataTransformTest() {
        # Note: webhook APIs are already registered from webhookEventTest()
        # We capture the callback via the hash returned by createWebhook

        hash<DataProviderAppInfo> appinfo = DataProviderActionCatalog::getAppEx("js-openapi-test");
        assertEq("js-openapi-test", appinfo.name);

        hash<DataProviderActionInfo> actioninfo = DataProviderActionCatalog::getAppActionEx("js-openapi-test",
            "webhook-format-transform");
        assertEq("webhook-format-transform", actioninfo.action);

        hash<auto> config = {
            "name": "test",
            "url": "tsrest-js-openapi-test://",
            "opts": {
                "subdomain": "test",
                "token": "x",
            },
        };
        TypeScriptAppRestConnection conn(config);

        DataProviderDataContextHelper dch({"name": "TestName"});
        AbstractDataProvider prov =
            TypeScriptActionInterface::getDataProvider("js-openapi-test", conn)
                .getChildProviderEx("webhook-format-transform");
        assertTrue(prov.supportsObservable());

        MyObserver o();
        cast<Observable>(prov).registerObserver(o);
        cast<DelayedObservable>(prov).observersReady();
        on_exit cast<DelayedObservable>(prov).stopEvents();

        # Get the callback that was captured during observersReady()
        code webhook_callback = get_last_webhook_callback();
        assertTrue(exists webhook_callback);

        # Send raw event data - format_event_data should transform it
        hash<auto> raw_event = {
            "name": "original-name",
            "code": 5678,
        };
        webhook_callback(raw_event);

        # Verify the event was transformed by format_event_data
        assertEq(1, o.l.size());
        hash<auto> received = o.l[0];
        assertEq("event", received.event_id);
        assertEq("original-name", received.data.original_name);
        assertTrue(received.data.transformed);
        assertEq("added by format_event_data", received.data.extra_field);
    }

    private webhookFormatEventDataFilterTest() {
        # Note: webhook APIs are already registered from webhookEventTest()

        hash<DataProviderAppInfo> appinfo = DataProviderActionCatalog::getAppEx("js-openapi-test");
        assertEq("js-openapi-test", appinfo.name);

        hash<DataProviderActionInfo> actioninfo = DataProviderActionCatalog::getAppActionEx("js-openapi-test",
            "webhook-format-filter");
        assertEq("webhook-format-filter", actioninfo.action);

        hash<auto> config = {
            "name": "test",
            "url": "tsrest-js-openapi-test://",
            "opts": {
                "subdomain": "test",
                "token": "x",
            },
        };
        TypeScriptAppRestConnection conn(config);

        DataProviderDataContextHelper dch({"name": "TestName"});
        AbstractDataProvider prov =
            TypeScriptActionInterface::getDataProvider("js-openapi-test", conn)
                .getChildProviderEx("webhook-format-filter");
        assertTrue(prov.supportsObservable());

        MyObserver o();
        cast<Observable>(prov).registerObserver(o);
        cast<DelayedObservable>(prov).observersReady();
        on_exit cast<DelayedObservable>(prov).stopEvents();

        # Get the callback that was captured during observersReady()
        code webhook_callback = get_last_webhook_callback();
        assertTrue(exists webhook_callback);

        # Send event that should be skipped (skip=true)
        hash<auto> skip_event = {
            "name": "skipped",
            "code": 1111,
            "skip": True,
        };
        webhook_callback(skip_event);

        # Send event that should pass through
        hash<auto> pass_event = {
            "name": "passed",
            "code": 2222,
        };
        webhook_callback(pass_event);

        # Send another event that should be skipped
        hash<auto> skip_event2 = {
            "name": "skipped2",
            "code": 3333,
            "skip": True,
        };
        webhook_callback(skip_event2);

        # Only the pass_event should have been received
        assertEq(1, o.l.size());
        hash<auto> received = o.l[0];
        assertEq("event", received.event_id);
        assertEq("passed", received.data.name);
        assertEq(2222, received.data.code);
    }

    private webhookFormatEventDataExceptionTest() {
        # Note: webhook APIs are already registered from webhookEventTest()

        hash<DataProviderAppInfo> appinfo = DataProviderActionCatalog::getAppEx("js-openapi-test");
        assertEq("js-openapi-test", appinfo.name);

        hash<DataProviderActionInfo> actioninfo = DataProviderActionCatalog::getAppActionEx("js-openapi-test",
            "webhook-format-exception");
        assertEq("webhook-format-exception", actioninfo.action);

        hash<auto> config = {
            "name": "test",
            "url": "tsrest-js-openapi-test://",
            "opts": {
                "subdomain": "test",
                "token": "x",
            },
        };
        TypeScriptAppRestConnection conn(config);

        DataProviderDataContextHelper dch({"name": "TestName"});
        AbstractDataProvider prov =
            TypeScriptActionInterface::getDataProvider("js-openapi-test", conn)
                .getChildProviderEx("webhook-format-exception");
        assertTrue(prov.supportsObservable());

        MyObserver o();
        cast<Observable>(prov).registerObserver(o);
        # Temporarily disable logger to avoid console noise from expected error
        if (m_options.verbose <= 2) {
            *LoggerInterface saved_logger = DataProvider::getGlobalLogger();
            DataProvider::setGlobalLogger(NOTHING);
            on_exit DataProvider::setGlobalLogger(saved_logger);
        }
        cast<DelayedObservable>(prov).observersReady();
        on_exit cast<DelayedObservable>(prov).stopEvents();

        # Get the callback that was captured during observersReady()
        code webhook_callback = get_last_webhook_callback();
        assertTrue(exists webhook_callback);

        # Send event that should cause format_event_data to throw an exception
        # This should be logged as an error and skipped (not crash)
        hash<auto> error_event = {
            "name": "error-event",
            "code": 1111,
            "throw_error": True,
        };
        webhook_callback(error_event);

        # Send a normal event that should pass through
        hash<auto> normal_event = {
            "name": "normal-event",
            "code": 2222,
        };
        webhook_callback(normal_event);

        # Send another event that causes an exception
        hash<auto> error_event2 = {
            "name": "error-event-2",
            "code": 3333,
            "throw_error": True,
        };
        webhook_callback(error_event2);

        # Only the normal_event should have been received
        # The error events should have been logged and skipped
        assertEq(1, o.l.size());
        hash<auto> received = o.l[0];
        assertEq("event", received.event_id);
        assertEq("normal-event", received.data.name);
        assertEq(2222, received.data.code);
    }

    private testApi() {
        chdir(get_script_dir());
        JavaScriptProgramPool pool("var exports = {};
async function runWithTimeout(promise, delay) {
  if (typeof promise === 'function') {
    promise = promise();
  }
  if (!(promise instanceof Promise)) {
    return promise;
  }
  // timeout variable to cancel the timeout in case the async function is faster
  let timeout;
  // get a promise to a cancelable timeout
  let top = new Promise((_, reject) => (timeout = setTimeout(() => reject(new Error('Request timed out')), delay)));
  // run the promise and cancel the timeout
  return await Promise.race([
    promise,
    top
  ]).finally(() => {
    if (timeout) clearTimeout(timeout);
  });
}\n" + File::readTextFile("test.js"), "test.js",
            sub (JavaScriptProgram pgm) {});
        code<auto(hash<string, code>, *hash<auto>)> run = pool.getProgram().getGlobal().exports.qtester.toData().run;
        assertThrows("JAVASCRIPT-EXCEPTION", "authorization_code", run, TypeScriptActionInterface::TestApi);
        # Both the original body wrapper and flattened action options must reach the OAuth check
        # when the Pet body and the additional dynamic option satisfy the action's request type.
        hash<auto> pet = {"id": 123, "name": "Rex", "photoUrls": ()};
        hash<auto> dynamic_option = {"new0": {"new1": {"a": "Fixture"}}};
        assertThrows("JAVASCRIPT-EXCEPTION", "authorization_code", run,
            (TypeScriptActionInterface::TestApi, pet + dynamic_option));
        # Invalid requests must fail validation before an OAuth error can hide the problem.
        assertThrows("JAVASCRIPT-EXCEPTION", "required field \"new0\" is absent", run,
            (TypeScriptActionInterface::TestApi, {"body": pet}));
        assertThrows("JAVASCRIPT-EXCEPTION", "required field \"photoUrls\" is absent", run,
            (TypeScriptActionInterface::TestApi, {"body": pet - "photoUrls"} + dynamic_option));
        assertThrows("JAVASCRIPT-EXCEPTION", "required field \"name\" is absent", run,
            (TypeScriptActionInterface::TestApi, {"body": pet - "name"} + dynamic_option));
        # The dynamic object's child is optional; an empty object still reaches authentication.
        assertThrows("JAVASCRIPT-EXCEPTION", "authorization_code", run,
            (TypeScriptActionInterface::TestApi, {"body": pet, "new0": {"new1": {}}}));
    }

    private poolTest() {
        JavaScriptProgramPool pool("var exports = {};
async function runWithTimeout(promise, delay) {
  if (typeof promise === 'function') {
    promise = promise();
  }
  if (!(promise instanceof Promise)) {
    return promise;
  }
  // timeout variable to cancel the timeout in case the async function is faster
  let timeout;
  // get a promise to a cancelable timeout
  let top = new Promise((_, reject) => (timeout = setTimeout(() => reject(new Error('Request timed out')), delay)));
  // run the promise and cancel the timeout
  return await Promise.race([
    promise,
    top
  ]).finally(() => {
    if (timeout) clearTimeout(timeout);
  });
}

var obj = {
    'actionsCatalogue': {
        'registerAppActions': function (api) {
            api.registerApp({
                'name': 'TestApp',
                'display_name': 'TestApp',
                'short_desc': 'test',
                'desc': 'test',
                'groups': ['Other'],
                'logo': 'AA==',
                'logo_file_name': 'test.svg',
                'logo_mime_type': 'image/svg+xml',
            });

            api.registerAction({
                'app': 'TestApp',
                'action': 'test-api',
                'display_name': 'test-api',
                'short_desc': 'Test API',
                'desc': 'Test API',
                'action_code': 2,
                'api_function': function (a, b, c) {
                    return 1;
                },
            });
        }
    }
};", "test.js", sub (JavaScriptProgram pgm) {
            pgm.getGlobal().obj.actionsCatalogue.registerAppActions(TypeScriptActionInterface::Api);
        });

        JavaScriptObject obj = pool.getProgram().getGlobal().getProperty("obj");

        AbstractDataProvider prov = TypeScriptActionInterface::getAppDataProvider("TestApp").
            getChildProviderEx("test-api");
        assertEq(1, prov.doRequest());
    }

    private sanityTest() {
        string name = "TestApp-" + get_random_string();
        hash<auto> app = {
            "name": name,
            "presentation_source_locale": "cs-CZ",
            "display_name": "TestApp",
            "short_desc": "Test",
            "desc": "Test",
            "groups": ("Other",),
            "logo": make_base64_string(<00>),
            "logo_file_name": "test.svg",
            "logo_mime_type": MimeTypeSvg,
        };
        JavaScriptProgramPool pool("", "pgm.js", sub (JavaScriptProgram pgm) {});
        TypeScriptActionInterface::registerApp(app, pool);
        hash<DataProviderAppInfo> appinfo = DataProviderActionCatalog::getAppEx(name);
        assertEq(name, appinfo.name);
        assertEq("cs-CZ", appinfo.presentation_source_locale,
            "the TypeScript app registration path preserves locale provenance");

        hash<auto> action = {
            "app": name,
            "action": "eliminar-registro",
            "display_name": "Eliminar registro",
            "short_desc": "Test API",
            "desc": "Test API",
            "action_code": DPAT_API,
            "mutates_state": False,
            "api_function": sub () {},
        };
        TypeScriptActionInterface::registerAction(action, pool);
        hash<DataProviderActionInfo> actioninfo = DataProviderActionCatalog::getAppActionEx(name,
            "eliminar-registro");
        assertEq("eliminar-registro", actioninfo.action);
        assertFalse(actioninfo.mutates_state,
            "typed producer metadata is authoritative regardless of a cognate action identifier");
    }

    private jsTest() {
        hash<DataProviderAppInfo> appinfo = DataProviderActionCatalog::getAppEx("js-test");
        assertEq("js-test", appinfo.name);

        hash<DataProviderActionInfo> actioninfo = DataProviderActionCatalog::getAppActionEx("js-test", "test-api");
        assertEq("test-api", actioninfo.action);
        assertTrue(actioninfo.data_dependent_options);
        assertTrue(actioninfo.options.key.structural_determinate);

        appinfo = DataProviderActionCatalog::getAppEx("js-openapi-test");
        assertEq("js-openapi-test", appinfo.name);

        actioninfo = DataProviderActionCatalog::getAppActionEx("js-openapi-test", "create-pet");
        assertEq("create-pet", actioninfo.action);
        assertTrue(actioninfo.mutates_state, "the exact OpenAPI POST method is consequential");
        actioninfo = DataProviderActionCatalog::getAppActionEx("js-openapi-test", "get-pet");
        assertEq("get-pet", actioninfo.action);
        assertFalse(actioninfo.mutates_state, "the exact OpenAPI GET method is read-only");

        actioninfo = DataProviderActionCatalog::getAppActionEx("gmail-test", "send-email");
        assertTrue(actioninfo.mutates_state, "the Google Discovery POST method is consequential");
        actioninfo = DataProviderActionCatalog::getAppActionEx("gmail-test", "eliminar-correo");
        assertFalse(actioninfo.mutates_state,
            "the Google Discovery GET method is read-only despite a mutating-looking cognate identifier");

        hash<auto> config = {
            "name": "test",
            "url": "tsrest-js-openapi-test://",
            "opts": {
                "subdomain": "test",
                "token": "x",
            },
        };
        TypeScriptAppRestConnection conn(config);
        assertEq("tsrest-js-openapi-test://test.example.com/api", conn.getUrl());
        assertEq("https://{{subdomain}}.example.com/oauth2/auth", conn.getRealOptions().oauth2_auth_url);
        assertEq("https://test.example.com/oauth2/auth", conn.getAuthUrl());
        assertEq("https://test.example.com/oauth2/auth?scope=&redirect_uri=auto&client_id=x&response_type=code",
            conn.getAuthorizationCodeRequest());
        assertEq("https://test.example.com/oauth2/auth", conn.getOAuth2Options().oauth2_auth_url);
        assertEq("https://{{subdomain}}.example.com/oauth2/auth", conn.orig_opts.oauth2_auth_url);

        hash<ConnectionSchemeInfo> scheme = ConnectionSchemeCache::getSchemeEx("tsrest-js-openapi-test");
        conn = scheme.cls.newObject(config);
        assertEq("tsrest-js-openapi-test://test.example.com/api", conn.getUrl());
        assertEq("https://{{subdomain}}.example.com/oauth2/auth", conn.getRealOptions().oauth2_auth_url);
        assertEq("https://test.example.com/oauth2/auth", conn.getAuthUrl());
        assertEq("https://test.example.com/oauth2/auth?scope=&redirect_uri=auto&client_id=x&response_type=code",
            conn.getAuthorizationCodeRequest());
        assertEq("https://test.example.com/oauth2/auth", conn.getOAuth2Options().oauth2_auth_url);
        assertEq("https://{{subdomain}}.example.com/oauth2/auth", conn.orig_opts.oauth2_auth_url);

        *hash<string, bool> fh = conn.getFeatures();
        {
            on_error printf("fh: %y\n", fh);
            assertTrue(fh{RestConnection::RCF_OAUTH2_AUTH_CODE});
        }

        AbstractDataProvider prov =
            TypeScriptActionInterface::getDataProvider("js-openapi-test", conn).getChildProviderEx("create-pet");
        AbstractDataProviderType t = prov.getRequestType();
        *hash<string, AbstractDataField> fields = t.getFields();
        {
            on_error printf("%y\n", keys fields);
            assertEq(7, fields.size());
            fields = fields.new0.getType().getFields();
            assertEq(("a",), keys fields.new1.getType().getFields());
        }

        prov = TypeScriptActionInterface::getDataProvider("js-openapi-test", conn).getChildProviderEx("get-pet");
        t = prov.getRequestType();
        fields = t.getFields();
        {
            on_error printf("%y\n", keys fields);
            assertEq(1, fields.size());
            *AbstractDataField f = fields.id;
            assertTrue(exists f);
        }

        actioninfo = DataProviderActionCatalog::checkAppActionOptions("js-openapi-test", "get-pet");
        assertEq("get-pet", actioninfo.action);
        {
            on_error printf("options: %N\n", actioninfo.options);
            assertEq("id", actioninfo.options.id.ref_data);
        }
        assertEq((1, 2), (map $1.value, prov.getReferenceData("id")));

        string cname = TypeScriptActionInterface::createConnection("js-openapi-test", {} + {
            "opts": {
                "subdomain": "test",
                "username": "x",
                "password": "y",
                "oauth2_grant_type": NOTHING,
            },
        });
        assertRegex("^app-", cname);
        conn = TypeScriptActionInterface::getConnection(cname);
        assertNothing(conn.getRealOptions().oauth2_grant_type);

        config = {
            "name": "test",
            "url": "tsrest-js-test://",
            "opts": {
                "token": "x",
            },
        };
        conn = new TypeScriptAppRestConnection(config);
        AbstractDataProvider parent = TypeScriptActionInterface::getDataProvider("js-test", conn);
        assertEq("TypeScriptAppRestConnection", cast<object>(parent).getConnection().className());
        prov = parent.getChildProviderEx("test-api");
        t = prov.getRequestTypeWithOptions({"key": "A"});
        assertEq(("count", "other", "key", "dyn", "list", "ax0", "ax1", "a0", "a1"), keys t.getFields());
        assertEq("TypeScriptDataField", t.getFields()."list".getType().getElementType().getFields().b.className());
        assertEq(100, t.getFields()."list".getType().getElementType().getFields().b.getDefaultValue());
        t = prov.getRequestTypeWithOptions({"key": "B"});
        assertEq(("count", "other", "key", "dyn", "list", "ax0", "ax1", "b0", "b1"), keys t.getFields());
        {
            hash<auto> h = {
                "count": 1,
                "other": ("a",),
                "list": ({"a": "str", "b": 1},),
            };
            assertEq(h, t.acceptsValue(h));
        }

        scheme = ConnectionSchemeCache::getSchemeEx("tsrest-js-test");
        assertEq(Type::List, scheme.messages.type());

        TypeScriptAppRestClient rest = conn.get(False);
        hash<auto> h = TestRestClient::test0(rest, {});
        assertEq("abc123", h.account_id);
        assertEq("https://www.example.com/api/abc123", rest.getURL());

        prov = parent.getChildProviderPath("tables/test");
        assertTrue(prov.supportsRead());
        assertEq("TypeScriptAppRestConnection", cast<object>(prov).getConnection().className());

        assertFalse(prov.getSearchOptions().for_update.default_value);
        assertEq("search_options_isolation_level", prov.getSearchOptions().isolation_level.ref_data);
        assertEq("read-uncommitted", prov.getReferenceData("search_options_isolation_level")[0].value);
        assertEq("read-committed", prov.getReferenceDataValue("search_options_isolation_level"));

        AbstractDataProviderRecordIterator i = prov.searchRecords();
        assertTrue(i.next());
        assertEq({"id": 1, "name": "a"}, i.getValue());
        assertTrue(i.next());
        assertEq({"id": 2, "name": "b"}, i.getValue());
        assertFalse(i.next());

        hash<auto> row = {"id": 3, "name": "c"};
        hash<auto> row0 = prov.createRecord(row);
        row += {"new": "value"};
        assertEq(row, row0);
        assertEq(1, prov.updateRecords({"name": "aa"}, {"id": 1}));
        assertEq("verified", prov.upsertRecord({"id": 2, "name": "bb"}));
        assertEq(1, prov.deleteRecords({"id": 1}));

        hash<auto> row_data = {
            "id": (4, 5, 6),
            "name": ("d", "e", "f"),
        };
        auto x = prov.createRecordsBulk(row_data);
        row_data."new" = map "value", xrange(row_data.firstValue().size());
        assertEq(row_data, x);

        list<string> r = prov.upsertRecordsBulk(row_data);
        assertEq((map UpsertResultVerified, xrange(r.size())), r);

        int rows = prov.updateRecords({"name": "dd"}, {"id": 1});
        assertEq(1, rows);

        rows = prov.deleteRecords({"id": 4});
        assertEq(1, rows);

        # Test OpenAPI 3.0 schema support
        appinfo = DataProviderActionCatalog::getAppEx("js-openapi3-test");
        assertEq("js-openapi3-test", appinfo.name);

        actioninfo = DataProviderActionCatalog::getAppActionEx("js-openapi3-test", "create-pet");
        assertEq("create-pet", actioninfo.action);

        actioninfo = DataProviderActionCatalog::getAppActionEx("js-openapi3-test", "get-pet");
        assertEq("get-pet", actioninfo.action);

        config = {
            "name": "test",
            "url": "tsrest-js-openapi3-test://",
            "opts": {
                "subdomain": "test",
                "token": "x",
            },
        };
        conn = new TypeScriptAppRestConnection(config);
        assertEq("tsrest-js-openapi3-test://test.example.com/api", conn.getUrl());

        scheme = ConnectionSchemeCache::getSchemeEx("tsrest-js-openapi3-test");
        conn = scheme.cls.newObject(config);
        assertEq("tsrest-js-openapi3-test://test.example.com/api", conn.getUrl());

        # Test that we can get the data provider for OpenAPI 3.0 actions
        parent = TypeScriptActionInterface::getDataProvider("js-openapi3-test", conn);
        prov = parent.getChildProviderEx("create-pet");
        assertTrue(exists prov);
        t = prov.getRequestType();
        assertTrue(exists t);
        # OpenAPI 3.0 uses "requestBody" which gets flattened, should have pet properties
        {
            hash<string, AbstractDataField> oa3_fields = t.getFields();
            assertTrue(exists oa3_fields);
        }

        prov = parent.getChildProviderEx("get-pet");
        assertTrue(exists prov);
        t = prov.getRequestType();
        assertTrue(exists t);
        {
            hash<string, AbstractDataField> oa3_fields = t.getFields();
            # OpenAPI 3.0 path parameter
            assertTrue(exists oa3_fields.petId);
        }
    }

    # Test that swagger_options.include_response_headers = false works correctly
    # When set to false, response types should NOT include the {body, headers} wrapper
    # even when the OpenAPI schema defines response headers
    private includeResponseHeadersTest() {
        # Test the app with include_response_headers: false was registered
        hash<DataProviderAppInfo> appinfo = DataProviderActionCatalog::getAppEx("js-no-response-headers-test");
        assertEq("js-no-response-headers-test", appinfo.name);

        # Test the action was registered
        hash<DataProviderActionInfo> actioninfo = DataProviderActionCatalog::getAppActionEx(
            "js-no-response-headers-test", "user-login");
        assertEq("user-login", actioninfo.action);

        # Create a connection for the test
        hash<auto> config = {
            "name": "test",
            "url": "tsrest-js-no-response-headers-test://",
            "opts": {
                "subdomain": "test",
                "token": "x",
            },
        };
        TypeScriptAppRestConnection conn(config);

        # Get the data provider for the user-login action
        AbstractDataProvider prov = TypeScriptActionInterface::getDataProvider("js-no-response-headers-test", conn)
            .getChildProviderEx("user-login");

        # Get the response type - it should be a simple string type (the body), NOT a hash with body/headers
        AbstractDataProviderType responseType = prov.getResponseType();
        assertTrue(exists responseType);

        # The response type should NOT have "body" and "headers" fields
        # If include_response_headers was true (the default), the PetStore /user/login endpoint
        # would return a hash with body and headers fields because it defines X-Expires-After
        # and X-Rate-Limit headers in the OpenAPI schema
        *hash<string, AbstractDataField> fields = responseType.getFields();

        # With include_response_headers: false, we should get the body type directly (string)
        # not the wrapper hash with body/headers
        {
            on_error printf("Response type: %s, fields: %y\n", responseType.getName(), keys fields);
            # The response should NOT be a hash with body and headers
            # It should be either a string type (body directly) or have NO body/headers wrapper
            if (fields) {
                assertFalse(exists fields.body && exists fields.headers,
                    "Response should not have both body and headers when include_response_headers is false");
            }
        }
    }

    #! App definitions refer to their resources relative to the app catalogue, not to the process's cwd
    appBaseDirTest() {
        string old_dir = getcwd();
        on_exit {
            chdir(old_dir);
            TypeScriptActionInterface::setAppBaseDir();
        }

        # with no app base dir set, paths in app definitions are resolved against the current working directory
        TypeScriptActionInterface::setAppBaseDir();
        chdir(tmp_location());
        assertEq(getcwd(), TypeScriptActionInterface::getAppBaseDir());

        # apps registered from a catalogue resolve their paths against the catalogue directory, so that an app
        # that refers to a schema as (ex) "schemas/asana.swagger.json" loads no matter where the process that
        # registers the app was started from
        TypeScriptActionInterface::setAppBaseDir(old_dir);
        assertEq(old_dir, TypeScriptActionInterface::getAppBaseDir());
        chdir("/");
        assertEq(old_dir, TypeScriptActionInterface::getAppBaseDir());
    }

    #! TypeScript field schemas define choices as AllowedValueInfo records even when their values are hashes
    private structuredFieldChoicesTest() {
        hash<auto> payload = {
            "field": "modifiedTime",
            "direction": "desc",
            "value": "raw payload member",
        };
        TypeScriptDataField field = TypeScriptActionInterface::getField("repro", "order_by", {
            "type": {
                "type": "list",
                "element_type": {
                    "type": "hash",
                    "fields": {
                        "field": {"type": "string", "required": True},
                        "direction": {"type": "string", "required": True},
                        "value": {"type": "string", "required": True},
                    },
                },
            },
            "required": False,
            "element_allowed_values": (
                {"display_name": "opaque-label", "value": payload},
            ),
            "element_allowed_values_creatable": True,
        });

        foreach QoreDataField value in (field, Serializable::deserialize(field.serialize())) {
            list<hash<AllowedValueInfo>> choices = value.getElementAllowedValues();
            assertEq(1, choices.size());
            assertEq("opaque-label", choices[0].display_name);
            assertEq(payload, choices[0].value);
            assertEq((payload,), value.acceptsValue((payload,)));
            hash<auto> custom = {
                "field": "name",
                "direction": "asc",
                "value": "custom payload member",
            };
            assertEq((custom,), value.acceptsValue((custom,)),
                "creatable structured choices still accept custom values");
        }
    }

    #! Provider schemas distinguish absence, emptiness, null, and unsupported versions at one boundary
    private producerSchemaBoundaryTest() {
        string inventory_app = "TypeScriptInventory_"
            + get_random_string(8);
        int inventory_revision
            = DataProviderActionCatalog::getCatalogRevision();
        assertThrows("TYPESCRIPT-PROVIDER-INVENTORY-ERROR", sub () {
            TypeScriptActionInterface::registerDiscoveryInventory(({
                "app": inventory_app,
                "action": "missing-app-record",
            },));
        }, NOTHING,
            "a complete inventory batch requires its app identity");
        assertThrows("TYPESCRIPT-PROVIDER-INVENTORY-ERROR", sub () {
            TypeScriptActionInterface::registerDiscoveryInventory(({
                "app": inventory_app,
            }, {
                "app": inventory_app + "_other",
                "action": "cross-app",
            }));
        }, NOTHING,
            "one inventory batch cannot mix application identities");
        assertEq(inventory_revision,
            DataProviderActionCatalog::getCatalogRevision(),
            "rejected inventory batches do not mutate qualification state");
        TypeScriptActionInterface::registerDiscoveryInventory(({
            "app": inventory_app,
        }, {
            "app": inventory_app,
            "action": "declared-before-materialization",
        }));
        assertEq(++inventory_revision,
            DataProviderActionCatalog::getCatalogRevision(),
            "publishing a new exact inventory batch advances qualification atomically");
        list<hash<DataProviderDiscoveryExpectedIdentityInfo>> inventory
            = map $1, TypeScriptActionInterface::getDiscoveryInventory(),
                $1.app == inventory_app;
        assertEq(2, inventory.size(),
            "a producer batch publishes its app and actions before materialization");
        TypeScriptActionInterface::registerDiscoveryInventory(({
            "app": inventory_app,
        }, {
            "app": inventory_app,
            "action": "replacement-action",
        }));
        assertEq(++inventory_revision,
            DataProviderActionCatalog::getCatalogRevision(),
            "replacing an inventory batch advances qualification atomically");
        inventory = map $1,
            TypeScriptActionInterface::getDiscoveryInventory(),
            $1.app == inventory_app;
        assertEq((inventory_app, inventory_app), map $1.app, inventory,
            "a replacement batch retains the app and one action identity");
        assertEq(("replacement-action",),
            (map $1.action, inventory, exists $1.action),
            "a replacement batch removes stale action identities exactly");
        # an app with no actions publishes an app-only batch, whose action set is empty and not absent
        TypeScriptActionInterface::registerDiscoveryInventory(({
            "app": inventory_app,
        },));
        assertEq(++inventory_revision,
            DataProviderActionCatalog::getCatalogRevision(),
            "an app-only batch replaces the inventory atomically");
        inventory = map $1,
            TypeScriptActionInterface::getDiscoveryInventory(),
            $1.app == inventory_app;
        assertEq((inventory_app,), (map $1.app, inventory),
            "an app-only batch records the app with an empty action set");

        TypeScriptActionInterface::deregisterDynamicApp(inventory_app);
        assertEq(++inventory_revision,
            DataProviderActionCatalog::getCatalogRevision(),
            "inventory deregistration advances qualification atomically");

        string failed_source = "qualification-source-"
            + get_random_string(8) + ".js";
        try {
            throw "TYPESCRIPT-SOURCE-TEST-ERROR",
                "producer failed before publishing identities";
        } catch (hash<ExceptionInfo> ex) {
            TypeScriptActionInterface::reportDiscoverySourceFailure(
                failed_source, ex);
        }
        assertEq(++inventory_revision,
            DataProviderActionCatalog::getCatalogRevision(),
            "a pre-inventory source failure advances qualification state");
        assertThrows("TYPESCRIPT-PROVIDER-INVENTORY-SOURCE-ERROR",
            "failed before publishing a complete inventory", sub () {
                TypeScriptActionInterface::getDiscoveryInventory();
            }, NOTHING,
            "a source-level failure cannot disappear behind an empty inventory");
        TypeScriptActionInterface::clearDiscoverySourceFailure(failed_source);
        assertEq(++inventory_revision,
            DataProviderActionCatalog::getCatalogRevision(),
            "a successful exact-source retry advances qualification state");
        assertTrue(TypeScriptActionInterface::getDiscoveryInventory()
            instanceof list,
            "clearing the exact source failure restores inventory collection");

        TypeScriptDataField empty = TypeScriptActionInterface::getField(
            "boundary", "empty", {
                "type": "string",
                "required": False,
                "allowed_values": (),
                "element_allowed_values": (),
            });
        foreach QoreDataField value in (
                empty, Serializable::deserialize(empty.serialize())) {
            assertEq((), value.getAllowedValues());
            assertEq((), value.getElementAllowedValues());
        }

        TypeScriptDataField empty_schema
            = TypeScriptActionInterface::getField("boundary", "empty_schema", {
                "type": {
                    "type": "hash",
                    "fields": {},
                },
            });
        foreach QoreDataField value in (empty_schema,
                Serializable::deserialize(empty_schema.serialize())) {
            assertEq(0, value.getDeclaredType().getFields().size(),
                "an explicitly empty schema remains empty across serialization");
        }

        TypeScriptDataField flat_path
            = TypeScriptActionInterface::getField("collision", "a-b", {
                "type": {
                    "type": "hash",
                    "fields": {
                        "value": {"type": "string"},
                    },
                },
            });
        TypeScriptDataField nested_path
            = TypeScriptActionInterface::getField("collision", "a", {
                "type": {
                    "type": "hash",
                    "fields": {
                        "b": {
                            "type": {
                                "type": "hash",
                                "fields": {
                                    "value": {"type": "string"},
                                },
                            },
                        },
                    },
                },
            });
        string flat_identity = flat_path.getDeclaredType().getPath();
        string nested_identity = nested_path.getDeclaredType().getFields(){"b"}
            .getDeclaredType().getPath();
        assertNeq(flat_identity, nested_identity,
            "typed encoded path segments distinguish a flat a-b field from nested a/b fields");

        assertThrows("TYPESCRIPT-PROVIDER-SCHEMA-ERROR",
            "must be a list", sub () {
                TypeScriptActionInterface::getField("boundary", "null", {
                    "type": "string",
                    "required": False,
                    "allowed_values": NOTHING,
                });
            });
        assertThrows("TYPESCRIPT-PROVIDER-SCHEMA-ERROR",
            "exact value member", sub () {
                TypeScriptActionInterface::getField("boundary", "bare", {
                    "type": "string",
                    "required": False,
                    "allowed_values": ({"display_name": "missing"},),
                });
            });

        string app = "TypeScriptVersion_" + get_random_string(8);
        JavaScriptProgramPool pool("", "version-test.js",
            sub (JavaScriptProgram pgm) {});
        hash<auto> app_info = {
            "name": app,
            "provider_schema_version": 1,
            "display_name": app,
            "short_desc": "schema version test",
            "desc": "schema version test",
            "groups": ("Other",),
            "logo": make_base64_string(<00>),
            "logo_file_name": "test.svg",
            "logo_mime_type": MimeTypeSvg,
            "dynamic": True,
        };
        TypeScriptActionInterface::registerApp(app_info, pool);
        DataProviderActionCatalog::getAppEx(app);
        on_exit TypeScriptActionInterface::deregisterDynamicApp(app);

        hash<auto> action = {
            "app": app,
            "action": "versioned-action",
            "provider_schema_version": 1,
            "display_name": "Versioned action",
            "short_desc": "schema version test",
            "desc": "schema version test",
            "action_code": DPAT_API,
            "api_function": sub () {},
        };
        TypeScriptActionInterface::registerAction(action, pool);
        DataProviderActionCatalog::getAppActionEx(app, "versioned-action");

        app_info.name = app + "_unsupported";
        app_info.provider_schema_version = 2;
        assertThrows("TYPESCRIPT-PROVIDER-SCHEMA-VERSION-ERROR",
            "unsupported", sub () {
                TypeScriptActionInterface::registerApp(app_info, pool);
            });
        assertEq("TYPESCRIPT-PROVIDER-SCHEMA-VERSION-ERROR",
            DataProviderActionCatalog::getInitializationFailures(
                (app_info.name,))[0].error,
            "a rejected producer version remains machine-readable");
        app_info.provider_schema_version = 1;
        TypeScriptActionInterface::registerApp(app_info, pool);
        DataProviderActionCatalog::getAppEx(app_info.name);
        assertEq((), DataProviderActionCatalog::getInitializationFailures(
            (app_info.name,)), "a valid retry clears only its own failure");
        TypeScriptActionInterface::deregisterDynamicApp(app_info.name);

        string invalid_app = app + " invalid";
        app_info.name = invalid_app;
        app_info.provider_schema_version = 1;
        assertThrows("APP-ERROR", "contains one or more spaces", sub () {
            TypeScriptActionInterface::registerApp(app_info, pool);
        });
        assertEq("APP-ERROR",
            DataProviderActionCatalog::getInitializationFailures(
                (invalid_app,))[0].error,
            "validation before materialization remains machine-readable");
        assertEq(1, (map $1,
                TypeScriptActionInterface::getDiscoveryInventory(),
                $1.app == invalid_app && !exists $1.action).size(),
            "the invalid app remains in the lightweight discovery inventory");
        TypeScriptActionInterface::deregisterDynamicApp(invalid_app);
        assertEq((), DataProviderActionCatalog::getInitializationFailures(
            (invalid_app,)),
            "deregistering a pre-materialization failure clears retained state");
        assertEq(0, (map $1,
                TypeScriptActionInterface::getDiscoveryInventory(),
                $1.app == invalid_app).size(),
            "deregistering a pre-materialization failure clears producer inventory");

        app_info.name = app + "_null";
        app_info.provider_schema_version = NOTHING;
        assertThrows("TYPESCRIPT-PROVIDER-SCHEMA-VERSION-ERROR",
            "unsupported", sub () {
                TypeScriptActionInterface::registerApp(app_info, pool);
            });
        app_info.provider_schema_version = 1;
        TypeScriptActionInterface::registerApp(app_info, pool);
        DataProviderActionCatalog::getAppEx(app_info.name);
        TypeScriptActionInterface::deregisterDynamicApp(app_info.name);

        action.action = "unsupported-version-action";
        action.provider_schema_version = 2;
        assertThrows("TYPESCRIPT-PROVIDER-SCHEMA-VERSION-ERROR",
            "unsupported", sub () {
                TypeScriptActionInterface::registerAction(action, pool);
            });
        list<hash<DataProviderInitializationFailureInfo>> failures
            = DataProviderActionCatalog::getInitializationFailures((app,));
        assertEq("unsupported-version-action", failures[0].action);
        assertEq("TYPESCRIPT-PROVIDER-SCHEMA-VERSION-ERROR",
            failures[0].error);
        action.provider_schema_version = 1;
        TypeScriptActionInterface::registerAction(action, pool);
        assertEq((), DataProviderActionCatalog::getInitializationFailures(
            (app,)));
    }

    #! Eager TypeScript registration failures retain machine-readable action identity without relying on output
    #! Returns the JavaScript literal for a minimal dynamic app named \a app
    private string appSource(string app) {
        return sprintf("{
                'name': '%s',
                'display_name': '%s',
                'short_desc': 'producer contract test',
                'desc': 'producer contract test',
                'groups': ['Other'],
                'logo': 'AA==',
                'logo_file_name': 'test.svg',
                'logo_mime_type': 'image/svg+xml',
                'dynamic': true,
            }", app, app);
    }

    #! Returns a pool whose action script registers \a apps, optionally publishing identity batches
    private JavaScriptProgramPool contractPool(string path, bool publish_inventory, list<string> apps) {
        string body;
        foreach string app in (apps) {
            if (publish_inventory) {
                body += sprintf("            api.registerDiscoveryInventory([{'app': '%s'}]);\n", app);
            }
            body += sprintf("            api.registerApp(%s);\n", appSource(app));
        }
        return new JavaScriptProgramPool(sprintf("var exports = {};
var obj = {
    'actionsCatalogue': {
        'registerAppActions': function (api) {
%s        }
    }
};", body), path, sub (JavaScriptProgram pgm) {
            pgm.getGlobal().obj.actionsCatalogue.registerAppActions(TypeScriptActionInterface::Api);
        });
    }

    #! A module and an action script built from different revisions must not fail silently
    /** Both directions of the skew are covered: an action script older than the module never publishes
        identity batches, which is reported but must keep working; a script newer than the module asserts the
        registration API it needs, which is covered by the catalogue's own test suite.
    */
    private inventoryContractSkewTest() {
        # a current action script publishes each complete identity batch before registering its app
        string current_app = "TypeScriptCurrentBundle_" + get_random_string(8);
        string current_path = "current-bundle-" + get_random_string(8) + ".js";
        {
            JavaScriptProgramPool current_pool = contractPool(current_path, True, (current_app,));
            on_exit TypeScriptActionInterface::deregisterDynamicApp(current_app);
            assertEq(current_app,
                DataProviderActionCatalog::getAppEx(current_app).name,
                "an action script observing the producer contract registers its app");
            assertEq((current_app,),
                (map $1.app, TypeScriptActionInterface::getDiscoveryInventory(),
                    $1.app == current_app),
                "the published identity batch reaches the producer inventory");
            assertEq((),
                (map $1, TypeScriptActionInterface::getIncompleteInventorySources(),
                    $1 == current_path),
                "a script observing the producer contract is not reported as incomplete");
        }

        # an action script built before registerDiscoveryInventory() existed publishes no batch at all
        string legacy_app = "TypeScriptLegacyBundle_" + get_random_string(8);
        string legacy_other_app = "TypeScriptLegacyOther_" + get_random_string(8);
        string legacy_path = "legacy-bundle-" + get_random_string(8) + ".js";
        {
            JavaScriptProgramPool legacy_pool = contractPool(legacy_path, False,
                (legacy_app, legacy_other_app));
            on_exit {
                TypeScriptActionInterface::deregisterDynamicApp(legacy_app);
                TypeScriptActionInterface::deregisterDynamicApp(legacy_other_app);
            }
            assertEq(legacy_app, DataProviderActionCatalog::getAppEx(legacy_app).name,
                "an action script predating the inventory API still registers its apps");
            assertEq(legacy_other_app,
                DataProviderActionCatalog::getAppEx(legacy_other_app).name,
                "reporting the skew does not abort the rest of the catalogue");
            assertEq((legacy_path,),
                (map $1, TypeScriptActionInterface::getIncompleteInventorySources(),
                    $1 == legacy_path),
                "the skewed action script is reported exactly once, not once per app");
        }
    }

    #! Missing schemas preserve real connection/OAuth2 metadata and can recover in the same JS pool
    private schemaConnectionRetryTest(string error = "APP-SCHEMAS-UNAVAILABLE") {
        string app = "SchemaRetry_" + get_random_string(8);
        string source = sprintf("var exports = {}; var ready = false; var app = %s;
app.rest = {url: 'https://example.invalid', data: 'json', oauth2_auth_url: 'https://example.invalid/auth'};
app.swagger_options = {parse_flags: -128};
app.schema_metadata = () => ready ? {swagger: 'PetStore.swagger.yaml'} : {
  initialization_error: {err: %s, desc: 'Install the schema snapshot'}
};
var action = {app: app.name, action: 'get-pet', display_name: 'Get Pet',
  short_desc: 'Read a pet', desc: 'Read a pet by its identifier', action_code: 2,
  swagger_path: 'pet/{id}/GET'};", appSource(app), make_json(error));
        JavaScriptProgramPool pool(source, "schema-retry.js", sub (JavaScriptProgram pgm) {
            JavaScriptObject global = pgm.getGlobal();
            TypeScriptActionInterface::registerApp(global.app);
            TypeScriptActionInterface::registerAction(global.action);
        });
        on_exit TypeScriptActionInterface::deregisterDynamicApp(app);
        string scheme_name = "tsrest-" + app.lwr();
        hash<ConnectionSchemeInfo> scheme = ConnectionSchemeCache::getSchemeEx(scheme_name);
        assertEq(app, DataProviderActionCatalog::getAppEx(app).name);
        assertEq("https://example.invalid/auth", scheme.options.oauth2_auth_url.default_value);
        string connection = TypeScriptActionInterface::createConnection(app.lwr(), {} + {"opts": {"token": "test"}});
        assertEq(scheme_name + "://example.invalid", TypeScriptActionInterface::getConnection(connection).getUrl());
        assertEq(error, TypeScriptActionInterface::getAppSchemaError(app).err);
        assertThrows(error, "Install the schema snapshot", sub () {
            TypeScriptActionInterface::execAppActionIntern(app.lwr(), "get-pet", connection, NOTHING);
        });
        auto failures = DataProviderActionCatalog::getInitializationFailures((app,));
        assertEq(1, failures.size());
        assertEq("action", failures[0].kind);
        assertEq("get-pet", failures[0].action);
        assertEq(error, failures[0].error);
        assertFalse(TypeScriptActionInterface::initApp(app), "missing schemas remain retryable");
        pool.getProgram().getGlobal().setProperty("ready", True);
        assertTrue(TypeScriptActionInterface::initApp(app), "a configured snapshot completes the same app");
        assertNothing(TypeScriptActionInterface::getAppSchemaError(app));
        TypeScriptActionInterface::checkAppActions(app);
        assertEq("get-pet", DataProviderActionCatalog::getAppActionEx(app, "get-pet").action);
        assertEq((), DataProviderActionCatalog::getInitializationFailures((app,)));
        assertEq(scheme, ConnectionSchemeCache::getSchemeEx(scheme_name), "connection metadata is preserved");
        assertFalse(TypeScriptActionInterface::initApp(app), "completed initialization is idempotent");
    }

    #! An actual initialization exception retains the pending app and is retried without re-registration
    private failedAppRetryTest() {
        string app = "AppRetry_" + get_random_string(8);
        JavaScriptProgramPool pool(sprintf("var exports = {}; var ready = false; var app = %s;
app.schema_metadata = () => ready ? {} : {
  initialization_error: {err: 'RESOURCE-NOT-CONFIGURED', desc: 'Install the resource'}
};", appSource(app)), "app-retry.js", sub (JavaScriptProgram pgm) {
            TypeScriptActionInterface::registerApp(pgm.getGlobal().app);
        });
        on_exit TypeScriptActionInterface::deregisterDynamicApp(app);
        for (int i = 0; i < 2; ++i) {
            assertThrows("RESOURCE-NOT-CONFIGURED", "Install", sub () {
                TypeScriptActionInterface::initApp(app);
            });
        }
        assertEq("RESOURCE-NOT-CONFIGURED",
            DataProviderActionCatalog::getInitializationFailures((app,))[0].error);
        pool.getProgram().getGlobal().setProperty("ready", True);
        assertTrue(TypeScriptActionInterface::initApp(app));
        assertEq(app, DataProviderActionCatalog::getAppEx(app).name);
        assertEq((), DataProviderActionCatalog::getInitializationFailures((app,)));
    }

    private existingAppRetryTest() {
        string app = "ExistingRetry_" + get_random_string(8);
        JavaScriptProgramPool pool("", "existing-retry.js", sub (JavaScriptProgram pgm) {});
        TypeScriptActionInterface::root.registerChild(app.lwr(),
            TypeScriptActionInterface::getAppDataProvider("js-test"));
        on_exit TypeScriptActionInterface::deregisterDynamicApp(app);
        assertThrows("TYPESCRIPT-CHILD-ERROR", "already registered", sub () {
            TypeScriptActionInterface::registerExistingApp({"name": app, "module": "DiscordDataProvider"}, pool);
        });
        assertThrows("TYPESCRIPT-CHILD-ERROR", "already registered", sub () {
            TypeScriptActionInterface::initApp(app);
        });
        TypeScriptActionInterface::root.deregisterChild(app.lwr());
        assertTrue(TypeScriptActionInterface::initApp(app));
        assertEq(app.lwr(), TypeScriptActionInterface::getAppDataProvider(app).getName());
        assertFalse(TypeScriptActionInterface::initApp(app));
    }

    private deferredActionRetryTest() {
        string app = "DeferredRetry_" + get_random_string(8);
        JavaScriptProgramPool pool("var exports = {}; var app = " + appSource(app) + ";",
            "deferred-retry.js", sub (JavaScriptProgram pgm) {
                TypeScriptActionInterface::registerApp(pgm.getGlobal().app);
            });
        on_exit TypeScriptActionInterface::deregisterDynamicApp(app);
        hash<auto> action = {"app": app, "action": "deferred", "display_name": "Deferred Action",
            "short_desc": "Retry deferred action registration", "desc": "Retry deferred action registration",
            "action_code": 999};
        TypeScriptActionInterface::registerAction(action, pool);
        for (int i = 0; i < 2; ++i) {
            assertThrows("TYPESCRIPT-ACTION-ERROR", "unsupported", sub () {
                TypeScriptActionInterface::initAppAction(app, "deferred");
            });
        }
        action.action_code = DPAT_API;
        action.api_function = sub () {};
        TypeScriptActionInterface::registerAction(action, pool);
        TypeScriptActionInterface::checkAppActions(app);
        assertEq("deferred", DataProviderActionCatalog::getAppActionEx(app, "deferred").action);
        assertEq((), DataProviderActionCatalog::getInitializationFailures((app,)));
    }

    private appMetadataProtocolTest() {
        string app = "MetadataProtocol_" + get_random_string(8);
        JavaScriptProgramPool pool(sprintf("var exports = {}; var app = %s;
app.future_metadata = true;", appSource(app)), "metadata-protocol.js", sub (JavaScriptProgram pgm) {
            TypeScriptActionInterface::registerApp(pgm.getGlobal().app);
        });
        on_exit TypeScriptActionInterface::deregisterDynamicApp(app);
        assertEq(2, TypeScriptActionInterface::Api.getCatalogueProtocolVersion());
        assertThrows("TYPESCRIPT-CATALOGUE-PROTOCOL-ERROR", "future_metadata", sub () {
            TypeScriptActionInterface::initApp(app);
        });
        assertEq("TYPESCRIPT-CATALOGUE-PROTOCOL-ERROR",
            DataProviderActionCatalog::getInitializationFailures((app,))[0].error);
    }

    private optionalResourceFailureTest() {
        string app = "TypeScriptResource_" + get_random_string(8);
        JavaScriptProgramPool pool("", "resource-test.js", sub (JavaScriptProgram pgm) {});
        hash<auto> info = {
            "name": app, "display_name": app,
            "short_desc": "Optional resource test", "desc": "Optional resource test",
            "groups": ("Other",), "logo": make_base64_string(<00>),
            "logo_file_name": "test.svg", "logo_mime_type": MimeTypeSvg, "dynamic": True,
            "initialization_error": {"err": "RESOURCE-NOT-CONFIGURED", "desc": "Install the local resource"},
        };
        TypeScriptActionInterface::registerDiscoveryInventory(({"app": app}, {"app": app, "action": "stable"}));
        TypeScriptActionInterface::registerApp(info, pool);
        on_exit TypeScriptActionInterface::deregisterDynamicApp(app);
        assertThrows("APP-ERROR", "is not registered", sub () {
            DataProviderActionCatalog::getAppEx(app);
        });
        auto failures = DataProviderActionCatalog::getInitializationFailures((app,));
        assertEq(1, failures.size());
        assertEq("app", failures[0].kind);
        assertEq("RESOURCE-NOT-CONFIGURED", failures[0].error);
        assertEq(2, (map $1, TypeScriptActionInterface::getDiscoveryInventory(), $1.app == app).size(),
            "an unavailable resource preserves every declared identity");
        TypeScriptActionInterface::deregisterDynamicApp(app);
        info.initialization_error = {"err": "RESOURCE-NOT-CONFIGURED", "desc": NOTHING};
        TypeScriptActionInterface::registerApp(info, pool);
        assertThrows("APP-ERROR", "is not registered", sub () {
            DataProviderActionCatalog::getAppEx(app);
        });
        assertEq("APP-ERROR", DataProviderActionCatalog::getInitializationFailures((app,))[0].error);
        TypeScriptActionInterface::deregisterDynamicApp(app);
        remove info.initialization_error;
        TypeScriptActionInterface::registerApp(info, pool);
        assertEq(app, DataProviderActionCatalog::getAppEx(app).name);
        assertEq((), DataProviderActionCatalog::getInitializationFailures((app,)),
            "a new registration with a valid resource clears the failure");
    }

    private schemaOptionAdditionsTest() {
        string app = "SchemaOptions_" + get_random_string(8);
        JavaScriptProgramPool pool("", "schema-options.js", sub (JavaScriptProgram pgm) {});
        TypeScriptActionInterface::registerApp({
            "name": app,
            "display_name": "Schema option test",
            "short_desc": "Schema option test",
            "desc": "Schema option test",
            "groups": ("Other",),
            "logo": make_base64_string(<00>),
            "logo_file_name": "test.svg",
            "logo_mime_type": MimeTypeSvg,
            "dynamic": True,
            "rest": {"url": "https://example.invalid", "data": "json"},
            "openapi": getcwd() + "/PetStore.openapi3.yaml",
        }, pool);
        DataProviderActionCatalog::getAppEx(app);
        on_exit TypeScriptActionInterface::deregisterDynamicApp(app);
        # A header-only option hash must also accept the internally added app name.
        TypeScriptAppRestConnection conn({
            "name": "schema-option-connection",
            "url": "tsrest-" + app.lwr() + "://",
            "opts": {"headers": {"X-Test": "synthetic"}},
        });
        assertEq(app, conn.getAppName());
        assertEq("synthetic", conn.getRealOptions().headers{"X-Test"});
        TypeScriptActionInterface::registerAction({
            "app": app,
            "action": "get-pet",
            "display_name": "Get pet",
            "short_desc": "Read a test pet",
            "desc": "Read a test pet using an additional selection field.",
            "action_code": DPAT_API,
            "openapi_path": "/pet/{petId}/GET",
            "override_options": {
                "board": {"type": "string", "required": False},
                "list": {"type": "string", "required": False, "depends_on": ("board",)},
            },
        }, pool);
        auto action = DataProviderActionCatalog::checkAppActionOptions(app, "get-pet");
        assertTrue(exists action.options.board);
        assertTrue(exists action.options.list);
        assertTrue(exists action.options.petId);
        assertEq(("board",), action.options.list.depends_on);
        assertEq(keys action.options,
            keys DataProviderActionCatalog::checkAppActionOptions(app, "get-pet").options);
    }

    private eagerRegistrationFailureTest() {
        string app = "TypeScriptFailure_" + get_random_string(8);
        JavaScriptProgramPool pool("", "failure-test.js", sub (JavaScriptProgram pgm) {});
        TypeScriptActionInterface::registerApp({
            "name": app,
            "display_name": app,
            "short_desc": "eager registration failure test",
            "desc": "eager registration failure test",
            "groups": ("Other",),
            "logo": make_base64_string(<00>),
            "logo_file_name": "test.svg",
            "logo_mime_type": MimeTypeSvg,
            "dynamic": True,
        }, pool);
        DataProviderActionCatalog::getAppEx(app);
        on_exit TypeScriptActionInterface::deregisterDynamicApp(app);

        hash<auto> action = {
            "app": app,
            "action": "broken-action",
            "display_name": "Broken action",
            "short_desc": "broken action",
            "desc": "broken action",
            "action_code": 999,
        };
        assertThrows("TYPESCRIPT-ACTION-ERROR", "unsupported", sub () {
            TypeScriptActionInterface::registerAction(action, pool);
        });

        list<hash<DataProviderInitializationFailureInfo>> failures
            = DataProviderActionCatalog::getInitializationFailures((app,));
        assertEq(1, failures.size());
        assertEq("action", failures[0].kind);
        assertEq(app, failures[0].app);
        assertEq("broken-action", failures[0].action);
        assertEq("TYPESCRIPT-ACTION-ERROR", failures[0].error);
        bool found_expected_identity;
        foreach hash<DataProviderDiscoveryExpectedIdentityInfo> identity in (
                TypeScriptActionInterface::getDiscoveryInventory()) {
            if (identity.app == app
                    && identity.action == "broken-action") {
                found_expected_identity = True;
                break;
            }
        }
        assertTrue(found_expected_identity,
            "the lightweight producer inventory survives schema materialization failure");

        # A successful retry of the same exact identity clears the retained failure.
        action.action_code = DPAT_API;
        action.api_function = sub () {};
        TypeScriptActionInterface::registerAction(action, pool);
        assertEq((), DataProviderActionCatalog::getInitializationFailures((app,)));
    }
}

class TestRestClient inherits TypeScriptAppRestClient {
    static *hash<auto> test0(TypeScriptAppRestClient client, hash<auto> h) {
        return client.getUpdateOptionsAfterLogin(h);
    }
}

class MyObserver inherits Observer {
    public {
        list<hash<auto>> l;

        const PollInterval = 100ms;
    }

    update(string event_id, hash<auto> data_) {
        l += {
            "event_id": event_id,
            "data": data_,
        };
    }

    hash<auto> waitForEvent(timeout to = 5s) {
        date start = now_us();
        while (True) {
            if (l) {
                break;
            }
            usleep(PollInterval);
            date d = now_us() - start;
            if (d > to) {
                throw "TIMEOUT-ERROR", sprintf("Polling for an event took %y (limit: %y)", d, to);
            }
        }
        return l[0];
    }

}

