#!/usr/bin/env qore
# Copyright (C) 2026 Qore Technologies, s.r.o.
%modern
%no-child-restrictions
%prepend-module-path "${SCRIPT_DIR}/../build"
%prepend-module-path "${SCRIPT_DIR}/../qlib"
%requires v8
%requires QUnit

%exec-class ProvenanceTest

class ProvenanceTest inherits QUnit::Test {
    constructor() : QUnit::Test("v8 callback provenance", "1.0", \ARGV) {
        addTestCase("a returned foreign callback retains its creation policy", \testProvenance());
        set_return_value(main());
    }

    testProvenance() {
        string path = get_script_path();
        code reader = string sub () {
            try { ReadOnlyFile::readTextFile(path); return "allowed"; }
            catch (hash<ExceptionInfo> ex) { return ex.err; }
        };
        JavaScriptProgram runtime("function make(reader) { return () => reader(); }", "provenance.js");
        Program sandbox(PO_NEW_STYLE);
        sandbox.parse("code sub make(object runtime, code reader) { return runtime.getGlobal().make(reader).toData(); }", "foreign-callback-factory");
        SandboxManager sm();
        sm.setFilesystemDefaultPolicy(False);
        # the sandboxed code uses the JavaScript runtime itself, which a sandbox allows only explicitly
        # (qoretechnologies/qore#6845: the v8 module's APIs are uncontrolled APIs)
        sm.setUncontrolledApiPolicy(True);
        sandbox.setSandboxManager(sm);
        code trusted = runtime.getGlobal().make(reader).toData();
        assertEq("allowed", trusted());
        # the v8 runtime does not apply the sandbox's file-system policy, so a sandbox that restricts the file system
        # refuses the runtime to its code, also when it allows uncontrolled APIs: no callback can be created under that
        # policy (qore#7832 step 1)
        assertThrows("INVALID-FUNCTION-ACCESS", \sandbox.callFunction(), ("make", runtime, reader));
        Queue results();
        ThreadPool pool(1);
        on_exit pool.stopWait();
        pool.submit(sub () { results.push(trusted()); });
        assertEq("allowed", results.get(10s), "a worker runs the trusted callback");
    }
}
