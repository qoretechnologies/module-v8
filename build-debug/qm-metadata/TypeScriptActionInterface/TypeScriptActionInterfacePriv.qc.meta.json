              {
                "name": "loadAllAppsFromDir",
                "full_name": "TypeScriptActionInterfacePriv::TypeScriptActionInterfacePriv::loadAllAppsFromDir",
                "signature": "loadAllAppsFromDir(string apps_dir)",
                "return_type": null,
                "description": "Eagerly load and register every curated app under the given directory\n\nFallback used when the data index / app-dir map is not available (e.g. while `qctl update-index` builds the index): the apps cannot be registered pending, so load them all so they can be enumerated/indexed.  Each curated app (see the catalogue's `getNewAppDirs())` is loaded through the master catalogue (`require()` in the master program, not a separate pool) and registered with `registerApp();` any pending action initialization is completed later by initAllApps() when `DPO_DisableOnDemandInitialization` is set.  As a side effect the directory <-> app-name map is (re)written next to the app directory so that subsequent runtime starts can register apps pending from the index without loading them (the app directory name is not derivable from the app name).",
                "return_description": null,
                "params": [
